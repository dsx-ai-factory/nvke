[Unit]
Description=NVKE Node Agent Updater (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/nvke-agent-updater --request %i
TimeoutStartSec=30min
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# This unit deliberately has no PartOf=, Requires=, or shared cgroup with
# the node-agent service. Debian prerm stops it during replacement;
# the package transaction must continue in this independent unit.
