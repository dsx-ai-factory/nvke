# Consumer configuration for agent build, publish, and runtime defaults.
#
# Copy to config.env and edit for your environment:
#   cp config.env.example config.env
#
# config.env is gitignored. ./build/agent.sh and make targets source it when
# present. The running agent prefers CLI flags; these env vars are also read as
# flag defaults (and can populate /etc/default/nke-agent AGENT_ARGS).

###############################################################################
# Bundle / artifact sources (agent runtime)
###############################################################################

# Optional. Needed only for InstallBundle / InstallCollection(.json).
# Prefer apt repos (ConfigureAptRepo / InstallPackages) when unset.
# Schemes: https://, http://, file://, oci://
# Examples:
#   NKE_BUNDLE_SERVER_URL=https://artifacts.example.com/
#   NKE_BUNDLE_SERVER_URL=oci://registry.example.com/nke/bundles
NKE_BUNDLE_SERVER_URL=

# Optional absolute override for the bundle index JSON.
# When empty, the agent derives:
#   ${NKE_BUNDLE_SERVER_URL}nke_bundles/ubuntu_22_index.json  (or ubuntu_24)
# Expected layout under an HTTP/S3 bundle server:
#   nke_bundles/ubuntu_22_index.json
#   nke_bundles/ubuntu_24_index.json
#   nke_bundles/Ubuntu_22.04/...
#   nke_bundles/Ubuntu_24.04/...
NKE_BUNDLE_INDEX_URL=

# Optional OCI registry prefix passed to CNI helm charts as global.registry
# Example: NKE_CNI_IMAGE_REGISTRY=registry.example.com/nke
NKE_CNI_IMAGE_REGISTRY=

###############################################################################
# Apt / package publish (build & release scripts)
###############################################################################

# S3 (or S3-compatible) intake prefix for uploading built .debs
# Example: APT_INTAKE_S3_URI=s3://my-bucket/nke-packages
APT_INTAKE_S3_URI=

# Project name under the intake prefix (directory + index merge key)
APT_INTAKE_PROJECT=nke-agent

# Public HTTPS root of the published apt repository (ConfigureAptRepo / docs)
# Example: NKE_APT_REPO_URL=https://artifacts.example.com/nke-apt
NKE_APT_REPO_URL=

###############################################################################
# Container / builder publish
###############################################################################

# Registry prefix for builder/agent image publishes
# Example: NKE_CONTAINER_REGISTRY=ghcr.io/my-org/nke
NKE_CONTAINER_REGISTRY=

NKE_BUILDER_IMAGE_NAME=nke-builder
NKE_BUILDER_IMAGE_TAG=latest
