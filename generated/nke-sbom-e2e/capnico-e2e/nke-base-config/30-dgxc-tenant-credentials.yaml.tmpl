# The OS account CWE renders into a tenant node's cloud-init.
#
# CWE refuses to render user-data without DGXC_TENANT_USER and
# DGXC_TENANT_PASSWORD, and the chart injects them only when
# secrets.dgxcTenantCredSecretName names a Secret carrying keys `user` and
# `password`. Missing, the failure appears as a rendering refusal during tenant
# provisioning rather than as anything naming this Secret.
apiVersion: v1
kind: Secret
metadata:
  name: dgxc-tenant-credentials
  namespace: {{ .ControllerNamespace }}
type: Opaque
stringData:
  user: "{{ .DGXCTenant.User }}"
  password: "{{ .DGXCTenant.Password }}"
