# Pull secret for the registries this site fetches images from.
#
# The NAME is fixed rather than caller-supplied, and deliberately: the capnico
# item's manifest carries `imagePullSecrets: [{name: ghcr-imagepull}]`, baked in
# at generate time from manifests/capnico.pin.yaml. A caller free to name this
# Secret could name it something that manifest does not reference, and the
# symptom would be ImagePullBackOff on the provider rather than anything naming
# the mismatch. One name, spelled once, in both places.
#
# Needed only where images are PULLED. The e2e lanes and the bootstrap cluster
# load images into containerd instead -- the bootstrap has no pull secret at all
# by design -- so those targets do not select this file.
#
# Rendered into every namespace that pulls: CAPNICo's controller lives in
# capnico-system, and the chart's own components in theirs.
{{- range .PullSecretNamespaces }}
---
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-imagepull
  namespace: {{ . }}
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: |
    {"auths":{"{{ $.Registry.Server }}":{"username":"{{ $.Registry.Username }}","password":"{{ $.Registry.Password }}"}}}
{{- end }}
