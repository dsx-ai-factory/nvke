# The tenant node login CWE renders into every tenant's cloud-init.
#
# Without it a real run hits "User-data rendering refused": CWE requires
# DGXC_TENANT_USER and DGXC_TENANT_PASSWORD, and the chart injects them only
# when secrets.dgxcTenantCredSecretName names a Secret carrying keys `user` and
# `password`. The name here must match that value in ../controller/overlay.yaml.
#
# A real password, so this is a template item. The e2e lanes pass
# example-password through --set and are welcome to; a site is not.
apiVersion: v1
kind: Secret
metadata:
  name: dgxc-tenant-credentials
  namespace: nke-controller
type: Opaque
stringData:
  user: "{{ .Tenant.User }}"
  password: "{{ .Tenant.Password }}"
