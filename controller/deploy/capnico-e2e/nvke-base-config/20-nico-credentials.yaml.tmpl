# What CAPNICo authenticates to the NICo API with.
#
# The name and namespace are not configurable: CAPNICo's own defaults read
# `nico-credentials` in `capnico-system`, and the four keys below are what its
# config expects. Applied BEFORE the controller, which reads them at startup.
#
# This Secret is the ONLY difference between a nico-sim lane and a NICo site.
# Same provider, same CRDs, same controller -- a different endpoint. That is what
# makes a green sim run evidence about the NICo path rather than a separate
# claim.
apiVersion: v1
kind: Secret
metadata:
  name: nico-credentials
  namespace: capnico-system
type: Opaque
stringData:
  endpoint: "{{ .Nico.Endpoint }}"
  orgID: "{{ .Nico.OrgID }}"
  token: "{{ .Nico.Token }}"
  apiName: "{{ .Nico.APIName }}"
