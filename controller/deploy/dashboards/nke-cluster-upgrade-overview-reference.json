        {
          "refId": "A",
          "expr": "(count((group by (k8s_cluster_name) ((kube_pod_container_info{k8s_cluster_name=~\"$cluster\",image=~\".*/calico/node:.*\"} or kube_pod_container_info{k8s_cluster_name=~\"$cluster\",image_spec=~\".*/calico/node:.*\",image!~\".*/calico/node:.*\"})) unless on (k8s_cluster_name) group by (k8s_cluster_name) (((kube_pod_container_info{k8s_cluster_name=~\"$cluster\",image=~\".*/calico/node:.*\"} or kube_pod_container_info{k8s_cluster_name=~\"$cluster\",image_spec=~\".*/calico/node:.*\",image!~\".*/calico/node:.*\"}) unless on (k8s_cluster_name,namespace,pod,container) (kube_pod_container_info{k8s_cluster_name=~\"$cluster\",image=~\".*/calico/node:v?${target_calico_version}([+._-].*)?(@.*)?$\"} or kube_pod_container_info{k8s_cluster_name=~\"$cluster\",image_spec=~\".*/calico/node:v?${target_calico_version}([+._-].*)?(@.*)?$\",image!~\".*/calico/node:.*\"}))))) or (0 * count(group by (k8s_cluster_name) ((kube_pod_container_info{k8s_cluster_name=~\"$cluster\",image=~\".*/calico/node:.*\"} or kube_pod_container_info{k8s_cluster_name=~\"$cluster\",image_spec=~\".*/calico/node:.*\",image!~\".*/calico/node:.*\"})))))",
          "legendFormat": "Count",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "100 * (count((group by (k8s_cluster_name) ((kube_pod_container_info{k8s_cluster_name=~\"$cluster\",image=~\".*/calico/node:.*\"} or kube_pod_container_info{k8s_cluster_name=~\"$cluster\",image_spec=~\".*/calico/node:.*\",image!~\".*/calico/node:.*\"})) unless on (k8s_cluster_name) group by (k8s_cluster_name) (((kube_pod_container_info{k8s_cluster_name=~\"$cluster\",image=~\".*/calico/node:.*\"} or kube_pod_container_info{k8s_cluster_name=~\"$cluster\",image_spec=~\".*/calico/node:.*\",image!~\".*/calico/node:.*\"}) unless on (k8s_cluster_name,namespace,pod,container) (kube_pod_container_info{k8s_cluster_name=~\"$cluster\",image=~\".*/calico/node:v?${target_calico_version}([+._-].*)?(@.*)?$\"} or kube_pod_container_info{k8s_cluster_name=~\"$cluster\",image_spec=~\".*/calico/node:v?${target_calico_version}([+._-].*)?(@.*)?$\",image!~\".*/calico/node:.*\"}))))) or (0 * count(group by (k8s_cluster_name) ((kube_pod_container_info{k8s_cluster_name=~\"$cluster\",image=~\".*/calico/node:.*\"} or kube_pod_container_info{k8s_cluster_name=~\"$cluster\",image_spec=~\".*/calico/node:.*\",image!~\".*/calico/node:.*\"}))))) / count(group by (k8s_cluster_name) ((kube_pod_container_info{k8s_cluster_name=~\"$cluster\",image=~\".*/calico/node:.*\"} or kube_pod_container_info{k8s_cluster_name=~\"$cluster\",image_spec=~\".*/calico/node:.*\",image!~\".*/calico/node:.*\"})))",
          "legendFormat": "Percent",
