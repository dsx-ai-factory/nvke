    {
      "id": 13,
      "type": "table",
      "title": "Control-plane upgrades in progress",
      "description": "Requires cwe_cluster_info or nke_controller_cluster_info.",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (name,status) ({__name__=~\"(cwe|nke_controller)_cluster_info\",name=~\"$cluster\",status=~\"control_plane_upgrading|cp_nodes_recycling\"})",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
