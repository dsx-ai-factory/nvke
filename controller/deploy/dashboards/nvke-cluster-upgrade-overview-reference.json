  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(kube_node_info, k8s_cluster_name)",
        "query": "label_values(kube_node_info, k8s_cluster_name)",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "description": "Prometheus label k8s_cluster_name (OTel resource k8s.cluster.name)."
      },
      {
        "name": "target_k8s_version",
        "label": "Target Kubernetes",
        "type": "query",
        "datasource": {
          "type": "prometheus",
