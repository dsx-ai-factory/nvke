    {
      "id": 5,
      "type": "stat",
      "title": "At target kubelet (${target_k8s_version})",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (k8s_cluster_name,node) (kube_node_info{k8s_cluster_name=~\"$cluster\",kubelet_version=~\"(^v?${target_k8s_version}([+._-].*)?$)|(^v?${target_k8s_version}[.][0-9]+([+._-].*)?$)\"})) or vector(0)",
          "legendFormat": "Count",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "(100 * (count(max by (k8s_cluster_name,node) (kube_node_info{k8s_cluster_name=~\"$cluster\",kubelet_version=~\"(^v?${target_k8s_version}([+._-].*)?$)|(^v?${target_k8s_version}[.][0-9]+([+._-].*)?$)\"}))) / clamp_min(count(max by (k8s_cluster_name,node) (kube_node_info{k8s_cluster_name=~\"$cluster\"})), 1)) or vector(0)",
          "legendFormat": "Percent",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mode": "thresholds",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Percent"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Count"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
