      "title": "In-progress control-plane upgrades",
      "description": "Requires nvke_controller_cluster_info status labels.",
      "gridPos": {
        "x": 6,
        "y": 14,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (name) ({__name__=~\"nke_controller_cluster_info|nvke_controller_cluster_info\", name=~\"$cluster\",status=~\"control_plane_upgrading|cp_nodes_recycling\"})) or (0 * count({__name__=~\"nke_controller_cluster_info|nvke_controller_cluster_info\", name=~\"$cluster\"}))",
          "legendFormat": "Count",
          "instant": true,
          "range": false
