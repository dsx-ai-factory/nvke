          "expr": "(kube_statefulset_status_replicas_ready{k8s_cluster_name=~\"$cluster\",namespace=\"spire-server\",statefulset=\"spire-server\"} / clamp_min(kube_statefulset_replicas{k8s_cluster_name=~\"$cluster\",namespace=\"spire-server\",statefulset=\"spire-server\"}, 1)) or vector(0)",
          "instant": true,
