        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(kube_node_status_condition{k8s_cluster_name=~\"$cluster\",condition=\"Ready\",status=\"true\"} == 1)",
          "legendFormat": "Ready nodes",
          "refId": "A"
        }
      ],
      "title": "Ready Node Count",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Current kubelet version and Ready state for each node.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 11,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "group by (node, kubelet_version) (kube_node_info{k8s_cluster_name=~\"$cluster\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kube_node_status_condition{k8s_cluster_name=~\"$cluster\",condition=\"Ready\",status=\"true\"}",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "title": "Node Ready and Kubelet Version",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "node",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Value #A": true
            },
            "renameByName": {
              "Value #B": "Ready",
              "kubelet_version": "Kubelet Version",
              "node": "Node"
            }
          }
        }
      ],
      "type": "table"
    },
