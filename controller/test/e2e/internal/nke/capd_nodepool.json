{
  "name": "PLACEHOLDER",
  "nodeNamePrefix": "PLACEHOLDER",
  "systemReservedMemory": "1Gi",
  "desiredNodeCount": 0,
  "controlPlane": false,
  "autoProvisionDisabled": false,
  "autoModeDisabled": false,
  "recycleBudget": 0,
  "infra": {
    "spireAttestationMethod": "joinToken",
    "machineTemplate": {
      "apiVersion": "infrastructure.cluster.x-k8s.io/v1beta2",
      "kind": "DockerMachineTemplate",
      "spec": { "template": { "spec": {
        "customImage": "PLACEHOLDER",
        "extraMounts": [ { "containerPath": "/var/run/docker.sock", "hostPath": "/var/run/docker.sock" } ]
      } } }
    },
    "preKubeadmCommands": [
      "mkdir -p /run/cluster-api",
      "echo success > /run/cluster-api/bootstrap-success.complete"
    ]
  }
}
