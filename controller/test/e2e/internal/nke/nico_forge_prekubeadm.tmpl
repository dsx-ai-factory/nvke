The commands that turn a booted machine into an NKE node, run before kubeadm.
Rendered by BuildForgeNodePayloads, one command per non-blank line, and sent as
NodePoolCreateConfig.infra.preKubeadmCommands.

The package versions are inputs for the same reason the OS image is: a
qualification run exists to pin them. Kept in step with
controller/hack/create-forge-nico-cluster.sh.
*/ -}}
install -d -m 0755 /etc/apt/keyrings
curl -fsSL -o /etc/apt/keyrings/nke.asc https://nke-prod-assets.s3.us-west-2.amazonaws.com/nke-apt-public.key
echo 'deb [signed-by=/etc/apt/keyrings/nke.asc] https://nke-prod-assets.s3.us-west-2.amazonaws.com/nke-apt-noble nke-noble main' > /etc/apt/sources.list.d/nke-apt.list
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y nke-agent nke-kubeadm-distro-{{ .KubernetesVersion }}
DEBIAN_FRONTEND=noninteractive apt-get install -y nke-cni-ovn-images-{{ .CNIVersion }}
DEBIAN_FRONTEND=noninteractive apt-get install -y spire-agent={{ .SpireVersion }}
printf 'AGENT_ARGS="--secure-server-port 15005"\n' > /etc/default/nke-agent
sysctl --system
systemctl daemon-reload
systemctl restart nke-agent.service
systemctl restart procps
touch /run/cloud-init.done
