# An allowlist: the e2e module, the files it embeds, and the controller/api
# module it replaces. This directory also holds local run state
# (e2e-config.yaml, tmp/, var/) that can carry hosts and credentials, and none
# of it may reach a layer or the build cache.
**
!LICENSE
!NOTICE
!controller/api/*.go
!controller/api/go.mod
!controller/api/go.sum
!controller/api/openapi.yaml
!controller/test/e2e/go.mod
!controller/test/e2e/go.sum
!controller/test/e2e/*.go
!controller/test/e2e/internal/**/*.go
!controller/test/e2e/internal/**/*.json
!controller/test/e2e/internal/**/*.tmpl
!controller/test/e2e/internal/**/*.sh
!controller/test/e2e/testdata/**
