#cloud-config
hostname: {{ .Hostname }}
preserve_hostname: false
package_update: true
package_upgrade: false

{{ if .Files }}
write_files:
{{ range .Files }}
  - path: {{ quote .Path }}
    owner: {{ quote .Owner }}
    permissions: {{ quote .Permissions }}
{{ if .Encoding }}
    encoding: {{ quote .Encoding }}
{{ end }}
    content: {{ quote .Content }}
{{ end }}
{{ else }}
write_files: []
{{ end }}
runcmd:
  - DEBIAN_FRONTEND=noninteractive apt-get install -y nke-agent=0.1.26 nke-kubeadm-distro-{{ trimPrefix .KubernetesVersion "v" }} spire-agent
  - DEBIAN_FRONTEND=noninteractive apt-get install -y {{ .CNIImagePackage }} {{ .CNIChartsPackage }}
  - touch /run/cloud-init.done
