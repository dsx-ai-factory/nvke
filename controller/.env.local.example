# Temporal, profiles and every other nke-controller-config setting come from
# hack/local-controller-config.yaml; point CONTROLLER_CONFIG_PATH at a copy to
# change them.
export DB_CONNECTION_STRING=postgres://postgres:postgres@localhost:5432/nke-controller?sslmode=disable
export DB_MAX_OPEN_CONNECTIONS=12
export SERVER_LISTEN_ADDRESS="127.0.0.1:8080"

export LOG_LEVEL="info"