# Temporal, profiles and every other nvke-controller-config setting come from
# hack/local-controller-config.yaml; point CONTROLLER_CONFIG_PATH at a copy to
# change them.
export DB_CONNECTION_STRING=postgres://postgres:postgres@localhost:5432/nvke-controller?sslmode=disable
export DB_MAX_OPEN_CONNECTIONS=12
export SERVER_LISTEN_ADDRESS="127.0.0.1:8080"

export LOG_LEVEL="info"

# Log each database query with its values instead of a "?" for each, and
# PostgreSQL error messages. The values can include content you supplied, such as
# cloud-init files, so leave this off unless you are debugging a query.
export DB_QUERY_LOG_VALUES="false"