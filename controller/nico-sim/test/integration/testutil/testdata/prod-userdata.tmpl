hostname: {{ .Hostname }}
preserve_hostname: false
manage_etc_hosts: true
ssh_pwauth: true
package_update: true
package_upgrade: false

write_files:
{{- if .TeleportEnabled }}
  - path: /etc/teleport.yaml
    owner: root:root
    permissions: '0600'
    content: |
      # Managed by NVKE Cloud Workflow Engine — do not edit manually.
      version: v3
      teleport:
        nodename: {{ .Hostname }}
        data_dir: /var/lib/teleport
        join_params:
          token_name: {{ .TeleportTokenName }}
          method: {{ .TeleportJoinMethod }}
        proxy_server: {{ .TeleportProxyAddress }}
        log:
          output: stderr
          severity: INFO
          format:
            output: json
        diag_addr: 127.0.0.1:3000
      ssh_service:
        enabled: "yes"
        labels:
{{ indent 10 .TeleportLabels }}
      auth_service:
        enabled: "no"
      proxy_service:
        enabled: "no"
{{- end }}
{{- if .SpiffeEnabled }}
  - path: /etc/spire-agent/agent.conf
    owner: root:root
    permissions: '0644'
    content: |
      agent {
          data_dir = "/var/lib/spire-agent"
          log_level = "DEBUG"

          server_address = "{{ .SpireServerAddress }}"
          server_port = "{{ .SpireServerPort }}"

          trust_domain = "{{ .TrustDomain }}"
          trust_bundle_path = "/etc/spire-agent/initial-trust-bundle.pem"
      }

      plugins {
          KeyManager "disk" {
              plugin_data {
                  directory = "/var/lib/spire-agent"
              }
          }

          NodeAttestor "tpm" {
              plugin_cmd = "/usr/local/lib/spire-agent/tpm_attestor_agent"
              plugin_checksum = "${TPM_PLUGIN_CHECKSUM}"
              plugin_data {}
          }

          WorkloadAttestor "unix" {
              plugin_data {}
          }
      }
  - path: /etc/spire-agent/initial-trust-bundle.pem
    owner: root:root
    permissions: '0644'
    content: |
{{ indent 6 .TrustBundle }}
{{- end }}
{{- range .Files }}
  - path: {{ quote .Path }}
    owner: {{ quote .Owner }}
    permissions: {{ quote .Permissions }}
{{- if .Encoding }}
    encoding: {{ quote .Encoding }}
{{- end }}
    content: {{ quote .Content }}
{{- end }}

runcmd:
{{- if .TeleportEnabled }}
  - [sh, -c, "echo 'Starting Teleport installation at '$(date) >> /var/log/cloud-init-teleport.log"]
  - /usr/local/bin/fetch-and-install-bundle.sh https://d3mq564cn7sth7.cloudfront.net/nke_bundles/Ubuntu_24.04/x86_64/teleport_ent_v18.6.4-2_x86_64.tgz ./install.sh
  - [sh, -c, "command -v teleport || { echo 'Teleport binary not found' >> /var/log/cloud-init-teleport.log; exit 1; }"]
  - [sh, -c, "systemctl enable --now teleport >> /var/log/cloud-init-teleport.log 2>&1"]
  - [sh, -c, "systemctl is-active --quiet teleport && echo 'Teleport service started successfully' >> /var/log/cloud-init-teleport.log || { echo 'Teleport service failed to start' >> /var/log/cloud-init-teleport.log; systemctl status teleport --no-pager >> /var/log/cloud-init-teleport.log; exit 1; }"]
  - [sh, -c, "echo 'Teleport installation completed at '$(date) >> /var/log/cloud-init-teleport.log"]
{{- end }}
  - /usr/local/bin/fetch-and-install-bundle.sh https://d3mq564cn7sth7.cloudfront.net/nke_bundles/Ubuntu_24.04/x86_64/kubeadm_v{{ .KubernetesVersion }}-5_x86_64.tgz ./kubeadm-install.py
  - DEBIAN_FRONTEND=noninteractive apt --fix-broken install -y
{{- if .CalicoEnabled }}
  - /usr/local/bin/fetch-and-install-bundle.sh https://d3mq564cn7sth7.cloudfront.net/nke_bundles/Ubuntu_24.04/x86_64/calico_v3.30.1-1_x86_64.tgz ./calico-image-import.py
{{- end }}
{{- if .OvnEnabled }}
  - /usr/local/bin/fetch-and-install-bundle.sh https://d3mq564cn7sth7.cloudfront.net/nke_bundles/Ubuntu_24.04/x86_64/ovn_1.4.0-2_x86_64.tgz ./install.sh -i
{{- end }}
{{- if .SpiffeEnabled }}
  - systemctl disable --now nke-attestation
  - /usr/local/bin/fetch-and-install-bundle.sh https://d3mq564cn7sth7.cloudfront.net/nke_bundles/Ubuntu_24.04/x86_64/spire_agent_v1.14.1_tpm_attestor_v1.9.0_x86_64.tgz ./install.sh
{{- else }}
  - echo SERVER=REPLACED-BY-SWE >> /etc/dgx/attestation/vars
  - echo "SAN_IP=$(hostname -I | cut -d' ' -f1)" >> /etc/dgx/attestation/vars
{{- end }}
  - sysctl --system
  - systemctl daemon-reload
  - systemctl restart nvke-agent.service
  - systemctl restart procps

phone_home:
    post: all
    tries: 10
    url: http://169.254.169.254:7777/latest/meta-data/phone_home
