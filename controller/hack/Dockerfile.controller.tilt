# Base image registry. Defaults to Docker Hub so the image builds for anyone
# with no NVIDIA network access. Internal builds override it, e.g.
#   docker build --build-arg BASE_REGISTRY=dockerhub.nvidia.com .
ARG BASE_REGISTRY=docker.io

FROM ghcr.io/spiffe/k8s-spiffe-workload-jwt-exec-auth:1.0.1@sha256:ac41337c043e986596dcabc961d569daf9f16a261fe307e665e0562238c30fb3 AS spiffe-jwt-exec-auth

FROM ${BASE_REGISTRY}/alpine:3.24.1

RUN apk add --update --no-cache \
    ca-certificates \
    bash \
    bash-completion \
    curl \
    gcompat \
    sed \
    attr \
    dialog \
    grep \
    util-linux \
    findutils \
    readline

WORKDIR /
COPY ./bin/controller /usr/local/bin/controller
COPY --from=spiffe-jwt-exec-auth /ko-app/cmd /opt/spiffe/bin/k8s-spiffe-workload-jwt-exec-auth
# OS/config profiles are supplied at runtime via profilesDir (chart mount /
# nke-site-deploy ConfigMap unpack). Keep the mount point; do not bake content.
# Non-archive Tilt builds append a COPY of ./profiles after this line.
RUN mkdir -p /profiles

EXPOSE 8080

CMD ["controller"]
