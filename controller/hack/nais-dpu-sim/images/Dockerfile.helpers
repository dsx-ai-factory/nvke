FROM scratch AS device-plugin
COPY dpu-sim-dp /dpu-sim-dp
ENTRYPOINT ["/dpu-sim-dp"]

FROM docker:29.1.3-cli AS frr
RUN apk add --no-cache iproute2
COPY frr-k8s frr-metrics frr-status statuscleaner frr-reloader.sh LICENSE /
