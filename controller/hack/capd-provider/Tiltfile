# capd provider: declares that the cluster has Cluster API Provider Docker
# (CAPD) installed for local development. Owns a preflight check fragment
# asserting that capd-controller-manager is deployed.
#
# ENABLE_CAPI gates the CAPI controller-runtime manager and the CAPI core
# controllers (e.g. machine-spire-entry) in CWE. Listing the capd provider
# implies it should be enabled. ENABLE_CAPI is set redundantly with the
# capi_core provider for self-containment; the main Tiltfile already enforces
# that capi_core is also listed.

CAPD_CWE_RBAC_RESOURCE = "capd-cwe-rbac"

def register(ctx):
    _cwe_resource_deps = []
    _capd_cwe_rbac_manifest = os.path.join(ctx.provider_dir, "cwe-rbac.yaml")

    k8s_yaml(_capd_cwe_rbac_manifest)
    k8s_resource(
        new_name=CAPD_CWE_RBAC_RESOURCE,
        labels=["5-capd"],
        objects=[
            "cloud-workflow-engine-capd:clusterrole",
            "cloud-workflow-engine-capd:clusterrolebinding",
        ],
        resource_deps=["check-management-cluster"],
        pod_readiness="ignore",
    )
    _cwe_resource_deps.append(CAPD_CWE_RBAC_RESOURCE)

    return struct(
        cwe_resource_deps = _cwe_resource_deps,
        cwe_env_overrides = {
            "ENABLE_CAPI": "true",
        },
        preflight_script = """
      kubectl get deployment -n capd-system capd-controller-manager >/dev/null 2>&1 || {
        echo "CAPD controllers are not installed in the current cluster. Run 'make capd-up' first." >&2
        exit 1
      }
""",
    )
