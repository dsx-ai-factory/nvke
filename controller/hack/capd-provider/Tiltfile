# capd provider: declares that the cluster has Cluster API Provider Docker
# (CAPD) installed for local development. Owns a preflight check fragment
# asserting that capd-controller-manager is deployed.
#
# ENABLE_CAPI gates the CAPI controller-runtime manager and the CAPI core
# controllers (e.g. machine-spire-entry) in CWE. Listing the capd provider
# implies it should be enabled. ENABLE_CAPI is set redundantly with the
# capi_core provider for self-containment; the main Tiltfile already enforces
# that capi_core is also listed.

DEFAULT_SITE_ID = "00000000-0000-0000-0000-000000000000"
# Distinct from forge-vms FORGE_VMS_VIP_CIDR (172.31.0.0/24); see NKX-13387.
DEFAULT_VIP_RANGE = "172.31.1.0/24"
CAPD_CWE_RBAC_RESOURCE = "capd-cwe-rbac"

def register(ctx):
    _cwe_port = os.getenv("CWE_HTTP_PORT", "8080")
    _vip_range = ctx.cfg.get("capd_vip_range", DEFAULT_VIP_RANGE)
    _cwe_resource_deps = []
    _capd_cwe_rbac_manifest = os.path.join(ctx.provider_dir, "cwe-rbac.yaml")

    k8s_yaml(_capd_cwe_rbac_manifest)
    k8s_resource(
        new_name=CAPD_CWE_RBAC_RESOURCE,
        labels=["5-capd"],
        objects=[
            "cloud-workflow-engine-capd:clusterrole",
            "cloud-workflow-engine-capd:clusterrolebinding",
        ],
        resource_deps=["check-management-cluster"],
        pod_readiness="ignore",
    )
    _cwe_resource_deps.append(CAPD_CWE_RBAC_RESOURCE)

    # Run an FRR BGP peer in the Docker daemon's host network namespace. This
    # gives tenant kube-vip pods a production-shaped router and works for both
    # local Colima and the CI DinD daemon.
    if ctx.cfg.get("capd_bgp_enabled", True):
        local_resource(
            "capd-bgp",
            cmd=["bash", os.path.join(ctx.main_dir, "hack/capd-bgp/up.sh")],
            deps=[
                os.path.join(ctx.main_dir, "hack/capd-bgp/up.sh"),
                os.path.join(ctx.main_dir, "hack/capd-bgp/down.sh"),
                os.path.join(ctx.main_dir, "hack/capd-bgp/frr.conf.tmpl"),
                os.path.join(ctx.main_dir, "hack/capd-bgp/vtysh.conf"),
                os.path.join(ctx.main_dir, "hack/capd-bgp/daemons"),
            ],
            labels=["1-infra"],
        )
        _cwe_resource_deps.append("capd-bgp")

    # ------------------------------------------------------------------
    # Default-site registration. nke-apply manifests for CAPD clusters
    # use the nil-UUID default site; without this the apply fails.
    # Idempotent: the helper script checks before creating.
    # ------------------------------------------------------------------
    local_resource(
        "capd-register-site",
        cmd=["bash", "-c", """
          set -euo pipefail
          API_URL="http://localhost:%s/api" DEFAULT_SITE_ID="%s" DEFAULT_VIP_RANGE="%s" \
            "%s/hack/register-default-site.sh"
        """ % (_cwe_port, DEFAULT_SITE_ID, _vip_range, ctx.main_dir)],
        resource_deps=["cwe"],
        labels=["5-capd"],
    )

    return struct(
        cwe_resource_deps = _cwe_resource_deps,
        cwe_env_overrides = {
            "ENABLE_CAPI": "true",
        },
        preflight_script = """
      kubectl get deployment -n capd-system capd-controller-manager >/dev/null 2>&1 || {
        echo "CAPD controllers are not installed in the current cluster. Run 'make capd-up' first." >&2
        exit 1
      }
""",
    )
