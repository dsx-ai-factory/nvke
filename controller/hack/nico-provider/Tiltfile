load("ext://uibutton", "cmd_button", "text_input")

CAPNICO_PROVIDER_RESOURCE = "capnico-provider"
CAPNICO_CREDENTIALS_RESOURCE = "capnico-credentials"
CAPNICO_NAMESPACE = "capnico-system"
CAPNICO_RELEASE = "capi-provider-nico"
CAPNICO_IMAGE = "cluster-api-provider-nico:local"

NICO_KIND_NODE_IMAGE_RESOURCE = "nico-kind-node-image"
DEFAULT_NICO_ORG_ID = "novxwn552ssc"
DEFAULT_NICO_TOKEN = "nico-simctl-token"

def _get_kind_cluster_name():
    name = os.getenv("KIND_CLUSTER_NAME", "")
    if name:
        return name
    context = k8s_context()
    if context.startswith("kind-"):
        return context[5:]
    return "kind-cluster-name-not-set"

def _capnico_source_dir(ctx):
    source_dir = os.getenv("CAPNICO_SOURCE_DIR", ctx.cfg.get("capnico_source_dir", ""))
    if source_dir and not source_dir.startswith("/"):
        source_dir = os.path.abspath(os.path.join(ctx.main_dir, source_dir))
    return source_dir

def _nico_config(ctx):
    cfg = ctx.cfg.get("nico", {})
    if type(cfg) != "dict":
        fail("tilt_config.json field 'nico' must be an object")

    endpoint = os.getenv("NICO_ENDPOINT", cfg.get("endpoint", "")).rstrip("/")
    if endpoint and not (endpoint.startswith("http://") or endpoint.startswith("https://")):
        fail("nico.endpoint must start with http:// or https://")

    return struct(
        endpoint=endpoint,
        org_id=os.getenv("NICO_ORG_ID", cfg.get("org_id", DEFAULT_NICO_ORG_ID)),
        token=os.getenv("NICO_TOKEN", DEFAULT_NICO_TOKEN),
        api_name=os.getenv("NICO_API_NAME", cfg.get("api_name", "forge")),
        environment=cfg.get("environment", "test"),
    )

def _register_node_image(ctx, labels):
    agent_dir = os.path.join(ctx.main_dir, "..", "agent")
    script = """
          set -euo pipefail
          if [ "${CAPD_KINDEST_NODE_IMAGE_PREBUILT:-false}" = "true" ]; then
            echo "reusing prebuilt ${CAPD_KINDEST_NODE_IMAGE:-cwe-capd-kindest-node:local}"
          else
            make -C "%s" capd-image
          fi
    """ % ctx.main_dir

    local_resource(
        NICO_KIND_NODE_IMAGE_RESOURCE,
        labels=labels,
        cmd=["bash", "-c", script],
        resource_deps=["check-management-cluster"],
        deps=[
            os.path.join(ctx.main_dir, "Makefile"),
            os.path.join(ctx.main_dir, "Makefile.dev"),
            os.path.join(ctx.main_dir, "hack", "capd-kindest-node"),
            os.path.join(agent_dir, "Makefile"),
            os.path.join(agent_dir, "go.mod"),
            os.path.join(agent_dir, "go.sum"),
            os.path.join(agent_dir, "cmd"),
            os.path.join(agent_dir, "internal"),
            os.path.join(agent_dir, "pkg"),
            os.path.join(agent_dir, "scripts"),
        ],
        allow_parallel=True,
    )

def _register_nico_sim(ctx, labels, nico, endpoint_host):
    _register_node_image(ctx, labels)
    sim_dir = os.path.join(ctx.main_dir, "nico-sim")
    return load_dynamic(os.path.join(sim_dir, "Tiltfile"))["register"](struct(
        main_dir=ctx.main_dir,
        cfg=ctx.cfg,
        tilt_env=ctx.tilt_env,
        kind_host_ip=endpoint_host,
        provider_dir=sim_dir,
        nico_org_id=nico.org_id,
        nico_token=nico.token,
    ))

def register(ctx):
    labels = ["2-nico"]
    nico = _nico_config(ctx)
    source_dir = _capnico_source_dir(ctx)
    use_nico_sim = not nico.endpoint
    nico_sim_endpoint_host = os.getenv("NICO_SIM_ENDPOINT_HOST", ctx.kind_host_ip)

    sim_result = struct(cwe_resource_deps=[], cwe_env_overrides={})
    endpoint = nico.endpoint
    if use_nico_sim:
        sim_result = _register_nico_sim(ctx, labels, nico, nico_sim_endpoint_host)
        endpoint = "http://%s:18080" % nico_sim_endpoint_host

    install_script = os.path.join(ctx.provider_dir, "install-capnico.sh")
    install_cmd = [
        "env",
        "CAPNICO_NAMESPACE=" + CAPNICO_NAMESPACE,
        "CAPNICO_RELEASE=" + CAPNICO_RELEASE,
        "CAPNICO_IMAGE=" + CAPNICO_IMAGE,
        "CAPNICO_STAGED_CHART_DIR=" + os.path.join(ctx.main_dir, ".local", "capnico-chart"),
        "KIND_CLUSTER_NAME=" + _get_kind_cluster_name(),
    ]
    if source_dir:
        install_cmd.append("CAPNICO_SOURCE_DIR=" + source_dir)
    install_cmd += ["bash", install_script]

    provider_deps = [install_script]
    if source_dir:
        provider_deps.append(source_dir)

    local_resource(
        CAPNICO_PROVIDER_RESOURCE,
        labels=labels,
        cmd=install_cmd,
        resource_deps=["check-management-cluster"],
        deps=provider_deps,
        allow_parallel=True,
    )

    credential_deps = [CAPNICO_PROVIDER_RESOURCE]
    if use_nico_sim:
        credential_deps.append("nico-sim")

    credentials_script = """
          set -euo pipefail
          endpoint="%s"

          echo "Probing ${endpoint}/healthz from inside the cluster..."
          kubectl -n %s delete pod capnico-endpoint-probe --ignore-not-found >/dev/null
          kubectl -n %s run capnico-endpoint-probe \
            --rm --attach --restart=Never --quiet \
            --image=curlimages/curl:8.11.1 \
            --command -- curl -fsS --max-time 10 "${endpoint}/healthz"

          kubectl -n %s create secret generic nico-credentials \
            --from-literal=endpoint="${endpoint}" \
            --from-literal=orgID="%s" \
            --from-literal=token="%s" \
            --from-literal=apiName="%s" \
            --dry-run=client -o yaml | kubectl apply -f -
    """ % (
        endpoint,
        CAPNICO_NAMESPACE,
        CAPNICO_NAMESPACE,
        CAPNICO_NAMESPACE,
        nico.org_id,
        nico.token,
        nico.api_name,
    )
    local_resource(
        CAPNICO_CREDENTIALS_RESOURCE,
        labels=labels,
        cmd=["bash", "-c", credentials_script],
        resource_deps=credential_deps,
        allow_parallel=True,
    )

    cwe_resource_deps = sim_result.cwe_resource_deps + [CAPNICO_CREDENTIALS_RESOURCE]
    cwe_env_overrides = {}
    cwe_env_overrides.update(sim_result.cwe_env_overrides)
    if not use_nico_sim:
        cwe_env_overrides.update({
            "SPIFFE_ENABLED": "true",
        })

    cwe_http_port = os.getenv("CWE_HTTP_PORT", "8080")
    cmd_button(
        "5-create-sample-local-nico-cluster",
        argv=["bash", "-c", """
          set -euo pipefail
          CWE_HTTP_PORT="%s" \
          CLUSTER_NAME="${CLUSTER_NAME:-nico-local}" \
          KUBERNETES_VERSION="${KUBERNETES_VERSION:-1.34.2}" \
          CONTROL_PLANE_DESIRED_COUNT="${CONTROL_PLANE_DESIRED_COUNT:-1}" \
          WORKER_DESIRED_COUNT="${WORKER_DESIRED_COUNT:-0}" \
          ./hack/create-local-nico-cluster.sh
        """ % cwe_http_port],
        resource="cwe",
        icon_name="add_box",
        text="Create sample local NICo cluster",
        inputs=[
            text_input("CLUSTER_NAME", default="nico-local"),
            text_input("KUBERNETES_VERSION", default="1.34.2"),
            text_input("CONTROL_PLANE_DESIRED_COUNT", default="1"),
            text_input("WORKER_DESIRED_COUNT", default="0"),
        ],
    )

    preflight_script = """
      command -v helm >/dev/null || { echo "helm is required for the nico provider" >&2; exit 1; }
      command -v docker >/dev/null || { echo "docker is required for the nico provider" >&2; exit 1; }
    """
    if source_dir:
        preflight_script += """      if [ ! -f "%s/chart/Chart.yaml" ]; then
        echo "CAPNICo source directory '%s' is incomplete." >&2
        exit 1
      fi
    """ % (source_dir, source_dir)
    else:
        preflight_script += """      if [ -z "${NGC_API_KEY:-}" ]; then
        echo "NGC_API_KEY is required to install the released CAPNICo chart." >&2
        exit 1
      fi
    """

    return struct(
        cwe_resource_deps=cwe_resource_deps,
        cwe_env_overrides=cwe_env_overrides,
        preflight_script=preflight_script,
    )
