# Mutagen project template for a remote Linux Tilt harness (e.g. Colossus).
#
# Docs: docs/remote-colossus-tilt.md
#
# Placeholders (substituted from env vars during setup):
#   __LOCAL_NKE_ROOT__   Mac absolute path to the parent of the nke/ monorepo
#                        (also parent of cluster-api-provider-nico/, forge-console/,
#                        nke-site-deploy/)
#   __REMOTE_SSH_ALIAS__ SSH Host alias for the target
#   __REMOTE_NKE_ROOT__  Path relative to the remote user's home (same parent)
#
# Expected layout (Mac and remote — flat siblings, mirrored 1:1):
#   $ROOT/nke/                         # NVIDIA/nke monorepo (controller/ + agent/)
#   $ROOT/cluster-api-provider-nico/
#   $ROOT/forge-console/               # optional; enable via tilt_config.json
#   $ROOT/nke-site-deploy/
#
# Profiles resolve via ../../nke-site-deploy from controller/. CAPNICo defaults
# to ../../cluster-api-provider-nico. forge-console is not a built-in provider —
# opt in with an external dict entry in tilt_config.json (see remote-colossus-tilt.md).
#
# On the target, run Tilt from the controller module:
#   cd ~/<REMOTE_NKE_ROOT>/nke/controller && TILT_LINK_PORT_OFFSET=1000 tilt up
#
# Model: Mac is source of truth (edit + git here). Target runs Tilt.
# Do NOT run git on the target -- one-way-replica overwrites it to match the Mac.
#
# Port offset: first remote target = +1000 (see docs). Only local "source"
# ports are offset; destination ports stay at the stack defaults.

sync:
  defaults:
    mode: "one-way-replica"
    # Mutagen's portable default is 0600/0700 (owner-only). CWE containers
    # run as non-root and read synced files (e.g. profiles/), so they must be
    # world-readable. Executable bit is still tracked separately.
    permissions:
      defaultFileMode: 0644
      defaultDirectoryMode: 0755
    ignore:
      paths:
        # Prefer root-anchored ignores. Unanchored "logs/" also matches
        # vendor/k8s.io/component-base/logs/ and breaks `go build -mod=vendor`.
        - "/bin/"
        - "/var/"
        - "/.dev/"
        - "/logs/"
        - "release/"
        - "images/"
        - ".gocache/"
        - ".gomodcache/"
        - ".cache/"
        - ".local/"
        - ".flox/run/"
        - "coverage.txt"
        - "*.qcow2"
        - "*.log"
        - "__debug_bin*"
  nke:
    alpha: "__LOCAL_NKE_ROOT__/nke"
    beta: "__REMOTE_SSH_ALIAS__:__REMOTE_NKE_ROOT__/nke"
  cluster-api-provider-nico:
    alpha: "__LOCAL_NKE_ROOT__/cluster-api-provider-nico"
    beta: "__REMOTE_SSH_ALIAS__:__REMOTE_NKE_ROOT__/cluster-api-provider-nico"
  forge-console:
    alpha: "__LOCAL_NKE_ROOT__/forge-console"
    beta: "__REMOTE_SSH_ALIAS__:__REMOTE_NKE_ROOT__/forge-console"
  nke-site-deploy:
    alpha: "__LOCAL_NKE_ROOT__/nke-site-deploy"
    beta: "__REMOTE_SSH_ALIAS__:__REMOTE_NKE_ROOT__/nke-site-deploy"

forward:
  tilt:
    source: "tcp:localhost:11350"
    destination: "__REMOTE_SSH_ALIAS__:tcp:localhost:10350"
  cwe:
    source: "tcp:localhost:9080"
    destination: "__REMOTE_SSH_ALIAS__:tcp:localhost:8080"
  temporal-ui:
    source: "tcp:localhost:9081"
    destination: "__REMOTE_SSH_ALIAS__:tcp:localhost:8081"
  temporal-frontend:
    source: "tcp:localhost:8233"
    destination: "__REMOTE_SSH_ALIAS__:tcp:localhost:7233"
  postgres:
    source: "tcp:localhost:6432"
    destination: "__REMOTE_SSH_ALIAS__:tcp:localhost:5432"
  forge-vms:
    source: "tcp:localhost:19080"
    destination: "__REMOTE_SSH_ALIAS__:tcp:localhost:18080"
  grafana:
    source: "tcp:localhost:4000"
    destination: "__REMOTE_SSH_ALIAS__:tcp:localhost:3000"
  forge-console:
    source: "tcp:localhost:9090"
    destination: "__REMOTE_SSH_ALIAS__:tcp:localhost:8090"
  # kube-api is managed by ../fetch-kubeconfig.sh --update-mutagen <alias>
  # (remote kind API port is dynamic). Example after first run:
  # kube-api:
  #   source: "tcp:localhost:16443"
  #   destination: "__REMOTE_SSH_ALIAS__:tcp:localhost:REMOTE_KIND_PORT"
  # Optional extras:
  # loki:
  #   source: "tcp:localhost:4100"
  #   destination: "__REMOTE_SSH_ALIAS__:tcp:localhost:3100"
  # spire-server:
  #   source: "tcp:localhost:31440"
  #   destination: "__REMOTE_SSH_ALIAS__:tcp:localhost:30440"
