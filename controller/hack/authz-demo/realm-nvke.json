    {
      "id": "00000000-0000-4000-8000-0000000002ed",
      "username": "zed",
      "enabled": true,
      "email": "zed@nvke-demo.local",
      "emailVerified": true,
      "firstName": "Zed",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "zed-demo",
