+	"github.com/vishvananda/netlink"
+	"testing"
+)
+
+func TestNkeSimulatedRenamedManagementVF(t *testing.T) {
+	previous := config.OvnKubeNode
+	defer func() { config.OvnKubeNode = previous; ResetNetLinkOpMockInst() }()
+	config.OvnKubeNode.Mode = types.NodeModeDPUHost
+	config.OvnKubeNode.SimulateDPU = true
+	ops := mocks.NewNetLinkOps(t)
+	ops.On("LinkList").Return([]netlink.Link{&netlink.Dummy{LinkAttrs: netlink.LinkAttrs{Name: "ovn-k8s-mp0", Alias: "eth0-2"}}}, nil)
+	SetNetLinkOpMockInst(ops)
+	got, err := GetNetdevNameFromDeviceId("eth0-2", nadapi.DeviceInfo{})
+	if err != nil || got != "ovn-k8s-mp0" {
+		t.Fatalf("got=%q err=%v", got, err)
+	}
+}
