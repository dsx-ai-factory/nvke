+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//go:build linux
+
+package node
+
+import (
+	"github.com/ovn-kubernetes/ovn-kubernetes/go-controller/pkg/config"
+	types "github.com/ovn-kubernetes/ovn-kubernetes/go-controller/pkg/types"
+	"github.com/ovn-kubernetes/ovn-kubernetes/go-controller/pkg/util"
+	corev1 "k8s.io/api/core/v1"
+	"testing"
+)
+
+func TestNkeSimulatedDPUPodOwnership(t *testing.T) {
+	previous := config.OvnKubeNode
+	defer func() { config.OvnKubeNode = previous }()
+	for _, tc := range []struct {
+		name       string
+		simulation bool
+		node       string
+		annotation bool
+		want       bool
+	}{
+		{"simulated local pod without PF MAC", true, "host", true, true},
+		{"simulated foreign host", true, "other", true, false},
+		{"missing connection details", true, "host", false, false},
+		{"physical DPU still requires PF MAC", false, "host", true, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			config.OvnKubeNode.Mode = types.NodeModeDPU
+			config.OvnKubeNode.SimulateDPU = tc.simulation
+			pod := &corev1.Pod{Spec: corev1.PodSpec{NodeName: tc.node}}
+			if tc.annotation {
+				var err error
+				pod.Annotations, err = util.MarshalPodDPUConnDetails(nil, &util.DPUConnectionDetails{PfId: "0", VfId: "4", SandboxId: "sandbox"}, types.DefaultNetworkName)
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			controller := &BaseNodeNetworkController{CommonNodeNetworkControllerInfo: CommonNodeNetworkControllerInfo{name: "host", pfMACs: []string{"52:54:00:00:00:00"}}}
+			got := controller.podReadyToAddDPU(pod, types.DefaultNetworkName)
+			if (got != nil) != tc.want {
+				t.Fatalf("claimed=%v want=%v", got != nil, tc.want)
+			}
+		})
+	}
+}
