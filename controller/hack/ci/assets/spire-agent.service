[Unit]
Description=SPIRE Agent
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/spire-agent/spire-agent.env
ExecStart=/usr/local/bin/spire-agent run -config /etc/spire-agent/agent.conf -expandEnv
Restart=on-failure
RestartSec=5
User=spire
Group=spire

[Install]
WantedBy=multi-user.target
