[Unit]
Description=Import packaged OVN images into the KIND node runtime
ConditionPathExists=/usr/lib/nvke/e2e/cni-images.deb
Requires=containerd.service
After=containerd.service
Before=nvke-agent.service spire-agent.service

[Service]
Type=oneshot
# KIND ships containerd as a binary, without either Debian dependency provider.
# Keep the canonical postinst; containerd.service above supplies the runtime.
ExecStart=/usr/bin/dpkg --ignore-depends=containerd,nvke-kubeadm-distro -i /usr/lib/nvke/e2e/cni-images.deb
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
