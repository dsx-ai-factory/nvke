# Required credentials — no defaults. Copy this file to .env.tilt and fill in a
# value for each (or export them in your shell); `tilt up` fails fast if any is
# empty. CNPG_SUPERUSER_PASSWORD is what the local postgres chart is installed
# with, so pick it before the first `tilt up` — changing it later needs the
# postgres PVC deleted.
DGXC_TENANT_USER=
DGXC_TENANT_PASSWORD=
CNPG_SUPERUSER_PASSWORD=
CNPG_CLOUD_PASSWORD=
CNPG_TEMPORAL_PASSWORD=

# The password component is replaced at startup by CNPG_SUPERUSER_PASSWORD
# (config.EffectiveDBConnectionString), so none is carried here.
DB_CONNECTION_STRING=postgres://postgres@postgres-postgresql.postgres.svc.cluster.local:5432/nvke-controller?sslmode=disable
SPIRE_SERVER_API_ADDRESS=spire-server.spire-server.svc.cluster.local:443
SPIRE_SERVER_ADDRESS=host.docker.internal

# Optional overrides (but nicer for local development). The controller's other
# settings come from the chart values, rendered into nvke-controller-config;
# the Tiltfile forwards only the environment variables the controller reads.
NODE_REBOOT_POLLING_INTERVAL=2s
LOG_LEVEL=info

# Optional NVKR release staging. Tilt uses NVKR_BIN or an nvkr binary on PATH.
# The release reference must be immutable: registry/repository@sha256:<digest>.
# Leave NVKR_RELEASE_OUTPUT empty to select the host architecture's output.
NVKR_BIN=
NVKR_RELEASE_REFERENCE=
NVKR_RELEASE_OUTPUT=

# Publish each cluster's kubeconfig to nke-system/<cluster>-kubeconfig. The e2e
# suite builds its tenant clients from that Secret, so leave this on to run any
# spec that talks to a tenant cluster.
TENANT_ACCESS_ENABLED=true

# Configure new tenant kube-apiservers to trust SPIRE JWT-SVIDs and make the
# published tenant kubeconfig use SPIRE exec auth.
NKE_OIDC_AUTH_ENABLED=true

# NVKE API authentication. The config schema is documented in README.md; the
# configuration this cluster uses is hack/tilt-controller-api-auth-values.yaml,
# and deploy/k8s/nvke-auth-dev.yaml creates the identities it admits.
# NKE_AUTH_ENABLED=false sets apiAuth.enabled to false, which disables
# authentication entirely.
NKE_AUTH_ENABLED=true

# Permissive mode evaluates and counts decisions without enforcing them. It
# needs a redeploy, not a runtime toggle:
#
#   NKE_PERMISSIVE_MODE=true tilt up
#
# or flip the line below and re-trigger the cwe resource.
NKE_PERMISSIVE_MODE=false
