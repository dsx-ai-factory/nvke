TEMPORAL_UI_URL=http://localhost:8081
DB_CONNECTION_STRING=postgres://postgres:postgres@postgres-postgresql.postgres.svc.cluster.local:5432/cloud-workflow?sslmode=disable
CNPG_SUPERUSER_PASSWORD=postgres
TEMPORAL_HOST_PORT=temporal-frontend.temporal.svc.cluster.local:7233
SPIFFE_ENABLED=true
SPIFFE_ENDPOINT_SOCKET=unix:///spiffe-workload-api/spire-agent.sock
SPIRE_SERVER_API_ADDRESS=spire-server.spire-server.svc.cluster.local:443
SPIRE_SERVER_ADDRESS=host.docker.internal
SPIRE_SERVER_PORT=30440
PROFILES_DIR=/profiles
UI_DIR=/ui

# Optional overrides (but nicer for local development):
CONTROLLER_MANAGER_POLLING_INTERVAL=2s
CONTROLLER_MANAGER_INTERVAL=2s
NODE_HEALTH_CHECK_POLLING_INTERVAL=2s
NODE_HEALTH_CHECK_INTERVAL=10s
NODE_REBOOT_POLLING_INTERVAL=2s
LOG_LEVEL=info

# Publish each cluster's kubeconfig to nke-system/<cluster>-kubeconfig. The e2e
# suite builds its tenant clients from that Secret, so leave this on to run any
# spec that talks to a tenant cluster.
TENANT_ACCESS_ENABLED=true

# Configure new tenant kube-apiservers to trust SPIRE JWT-SVIDs and make the
# published tenant kubeconfig use SPIRE exec auth.
NKE_OIDC_AUTH_ENABLED=true

# Optional scheduled maintenance flags.
# CSR_APPROVAL_INTERVAL=30s
# CERT_RENEWAL_INTERVAL=1m
# CERT_RENEWAL_THRESHOLD_DAYS=30
