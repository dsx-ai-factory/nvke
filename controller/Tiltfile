# Gate that flips to ready once cert-manager has issued the leaf serving
# cert for the OIDC discovery provider. Anything that consumes the OIDC
# cert (including the ConfigMap renderer below) depends on this
# resource so it never runs while the Secret is missing.
local_resource(
    "oidc-upstream-ca-ready",
    labels=["1-infra"],
    cmd=["bash", "-c",
         "kubectl -n " + SPIRE_NAMESPACE + " wait --for=condition=Ready " +
         "certificate/oidc-provider-upstream-ca --timeout=180s"],
    resource_deps=["oidc-ca-bootstrap"],
)


