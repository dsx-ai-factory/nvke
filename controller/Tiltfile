# ---------------------------------------------------------------------------
# Provider configuration
# ---------------------------------------------------------------------------
# Providers list supports strings and dicts:
#   "capi_core"               -- built-in CAPI core support
#   "capd"                    -- built-in CAPD support
#   "nico"                    -- NCX Infra Controller support
#   "capd-reboot-controller"  -- CAPD reboot dev controller provider
#   "capi-syscmp"             -- CAPI system component addon provider
#   "forge-vms"               -- Forge-compatible local VM provider
#   "nico-vm"                 -- CAPNICo provider installed from the NGC Helm chart
#   {"my-provider": "/path/to/folder"} -- external, Tiltfile at <folder>/Tiltfile
# Default: ["capi_core", "capd", "capd-reboot-controller"]
#
# Provider interface
# ------------------
# Each provider must expose a `register` function in <provider_dir>/Tiltfile:
#
#   def register(ctx):
#       ...
#       return struct(cwe_resource_deps, cwe_env_overrides,
#                     preflight_script=...)  # optional
#
# Input — ctx is a struct with:
#   ctx.main_dir      (string)  Root directory of the main Tiltfile (config.main_dir).
#   ctx.cfg           (dict)    Parsed tilt_config.json contents.
#   ctx.kind_host_ip  (string)  IP reachable from inside Kind pods (e.g. Kind gateway).
#   ctx.provider_dir  (string)  Absolute path to the provider's root directory.
#
# Output — returned struct with:
#   cwe_resource_deps  (list[string])  Tilt resource names CWE should depend on.
#                                      Appended to the CWE k8s_resource resource_deps.
#   cwe_env_overrides  (dict[string, string])  Env vars injected into CWE's chart
#                                              values (e.g. FORGE_URL, FWE_API_KEY).
#   preflight_script   (string, optional)      Bash fragment appended to the
#                                              check-management-cluster preflight script.
#                                              Use to assert provider-required tooling or
#                                              CRDs are present in the cluster.
#
# Inside register(), the provider creates its own Tilt resources (local_resource,
# helm_resource, etc.) and returns the struct to wire itself into CWE.

# Built-in provider name -> directory (relative to config.main_dir).
_builtin_provider_dirs = {
    "capi_core": os.path.join(config.main_dir, "hack/capi-core-provider"),
    "capd": os.path.join(config.main_dir, "hack/capd-provider"),
    "nico": os.path.join(config.main_dir, "hack/nico-provider"),
    "capd-reboot-controller": os.path.join(config.main_dir, "hack/capd-reboot-controller"),
    "capi-syscmp": os.path.join(config.main_dir, "hack/capi-syscmp-provider"),
    "forge-vms": os.path.join(config.main_dir, "forge-vms"),
    "nico-vm": os.path.join(config.main_dir, "hack/nico-vm-provider"),
}

_tilt_config = read_json("tilt_config.json", default={})
cfg = _tilt_config
# CI can preload immutable images into Kind and bypass the local Docker builds.
# Local development keeps the existing build behavior when these are unset.
CWE_IMAGE = cfg.get("cwe_image", "")
SITE_CONTROLLER_VIP_OVERRIDE = cfg.get("site_controller_vip", "")

_provider_entries = cfg.get("providers", [
    "capi_core",
    "capd",
    "capd-reboot-controller",
])

if "nico" in _provider_entries and "capi_core" not in _provider_entries:
    fail("Provider 'nico' requires 'capi_core' in the provider list.")

if "capd" in _provider_entries and "capi_core" not in _provider_entries:
    fail("Provider 'capd' requires 'capi_core' in the provider list.")

if "capi-syscmp" in _provider_entries and "capi_core" not in _provider_entries:
    fail("Provider 'capi-syscmp' requires 'capi_core' in the provider list.")

if "nico-vm" in _provider_entries and "capi_core" not in _provider_entries:
    fail("Provider 'nico-vm' requires 'capi_core' in the provider list.")

# nico-vm points nico-credentials at the local forge-vms backend and its
# credentials resource depends on the 'forge-vms' Tilt resource by name.
if "nico-vm" in _provider_entries and "forge-vms" not in _provider_entries:
    fail("Provider 'nico-vm' requires 'forge-vms' in the provider list: it points " +
         "nico-credentials at the local forge-vms backend and depends on its Tilt resource.")

# 'nico' and 'forge-vms' are mutually exclusive Forge backends for CWE: both set
# FORGE_URL and both bind host port 18080 (nico-mock's port-forward vs forge-vms's
# listener). Enable at most one. (capd is orthogonal and may accompany either.)
if "nico" in _provider_entries and "forge-vms" in _provider_entries:
    fail("Providers 'nico' and 'forge-vms' are mutually exclusive: both set CWE's FORGE_URL " +
         "and bind host port 18080. Enable only one (capd may accompany either).")

# 'nico' and 'nico-vm' are mutually exclusive ways to get a CAPNICo
# controller: both install one into the capnico-system namespace and own the
# 'nico-credentials' secret it reads. Enable at most one.
if "nico" in _provider_entries and "nico-vm" in _provider_entries:
    fail("Providers 'nico' and 'nico-vm' are mutually exclusive: both install a CAPNICo " +
         "controller into capnico-system and own the 'nico-credentials' secret. Enable only one.")

CWE_NAMESPACE = "cloud-workflow-engine"
