# Pull the postgres chart directly from the Bitnami OCI registry instead of
# adding the classic HTTP repo. `helm repo add bitnami` downloads the full
# index.yaml (tens of MB), which times out on slow networks; OCI fetches only
# this one chart version.
helm_resource(
    "postgres",
    "oci://registry-1.docker.io/bitnamicharts/postgresql",
    labels=["1-infra"],
    release_name="postgres",
    namespace=POSTGRES_NAMESPACE,
    deps=["deploy/helm-values/postgres.yaml"],
    flags=[
      "--create-namespace",
      "--values", "deploy/helm-values/postgres.yaml",
      "--version", CHART_VERSION_POSTGRESQL,
      "--wait",
      "--timeout", "10m",
    ],
    resource_deps=["check-management-cluster"],
    port_forwards=[5432],
)

