helm_repo(
    "spiffe-hardened",
    "https://spiffe.github.io/helm-charts-hardened/",
    labels=["1-infra"],
    resource_name="spiffe-hardened-repo",
)

# Local clone of the upstream spiffe-hardened/spire chart, pinned to a commit.
# It exposes `global.spire.jwtIssuer` to the OIDC discovery provider — without
# it the provider derives `iss` from the request's Host header and we end up
# advertising `https://<ip>:30443` instead of the logical site-controller URL.
#
# The jwtIssuer support landed upstream in
# https://github.com/spiffe/helm-charts-hardened/pull/829, but no release has
# been cut yet. Rather than track the moving `main` branch (which could break
# us on any upstream push), we pin an exact commit on main. Bump
# SPIRE_CHART_REPO_COMMIT deliberately after re-testing; switch back to the
# published Helm repo (`chart="spiffe-hardened/spire"`, pinned version) once a
# release with the fix ships.
#
# Why a local clone and not a git URL via the helm-git plugin: the chart has
# sibling `file://../spire-lib` dependencies that require the whole
# helm-charts-hardened repo on disk during `helm dep build`. helm-git's
# sparse checkout strips that.
SPIRE_CHART_REPO_URL = "https://github.com/spiffe/helm-charts-hardened.git"
# Pinned commit on main (spire chart 0.29.0). Bump only after re-testing.
SPIRE_CHART_REPO_COMMIT = "585203462b6bc7aa06d67b3a153bfff7ff287173"
_spire_chart_dir = os.path.join(config.main_dir, ".local/helm-charts/spire-hardened-upstream")

local_resource(
    "spire-chart-upstream",
    labels=["1-infra"],
    cmd=["bash", "-c", """
      set -euo pipefail
      target=%s
      url=%s
      commit=%s
      # Fetch the pinned commit by SHA at depth 1 (GitHub allows want-by-SHA),
      # then detach onto it. Works for both a fresh dir and an existing clone,
      # and never depends on a branch tip that can move under us.
      if [ ! -d "${target}/.git" ]; then
        rm -rf "${target}"
        mkdir -p "${target}"
        git -C "${target}" init -q
        git -C "${target}" remote add origin "${url}"
      else
        git -C "${target}" remote set-url origin "${url}"
      fi
      git -C "${target}" fetch --depth=1 origin "${commit}"
      git -C "${target}" checkout -q --detach "${commit}"
      # Materialise the chart's file://../spire-lib sibling and other deps
      # into charts/spire/charts/ — required for `helm install` to find them.
      helm dependency build "${target}/charts/spire" >/dev/null
    """ % (_spire_chart_dir, SPIRE_CHART_REPO_URL, SPIRE_CHART_REPO_COMMIT)],
    resource_deps=["check-management-cluster"],
)

helm_resource(
    "spire-crds",
    labels=["1-infra"],
    chart="spiffe-hardened/spire-crds",
    release_name="spire-crds",
    namespace=SPIRE_NAMESPACE,
    flags=[
