# ---------------------------------------------------------------------------
# Controller
# ---------------------------------------------------------------------------

_controller_tenant_access_enabled = os.getenv(
    "TENANT_ACCESS_ENABLED", _tilt_env.get("TENANT_ACCESS_ENABLED", "true")) == "true"
_controller_oidc_enabled = os.getenv(
    "NKE_OIDC_AUTH_ENABLED", _tilt_env.get("NKE_OIDC_AUTH_ENABLED", "true")) == "true"

# NVKE API authentication. Enforcing by default now that the suite mints its own
# token: internal/authtoken discovers the audience from apiAuth in
# nvke-controller-config and nvke.NewClient presents it on every call, so the
# ordinary specs exercise the shipping authentication path rather than
# bypassing it.
#
# The configuration is hack/tilt-controller-api-auth-values.yaml, which the
# chart renders into apiAuth in nvke-controller-config. To drive it by hand, use
# hack/nvke-token.sh for the bearer token.
#
#   NKE_AUTH_ENABLED=false tilt up     -> apiAuth.enabled false, authn off
#   NKE_PERMISSIVE_MODE=true tilt up   -> evaluate and count, never reject
#
_controller_auth_enabled = os.getenv(
    "NKE_AUTH_ENABLED", _tilt_env.get("NKE_AUTH_ENABLED", "true")) == "true"
_controller_permissive_mode = os.getenv(
    "NKE_PERMISSIVE_MODE", _tilt_env.get("NKE_PERMISSIVE_MODE", "false")) == "true"

_controller_chart_extra_env_names = [
    "NODE_PROVISIONING_TIMEOUT",
    "NODE_REBOOT_POLLING_INTERVAL",
    "LOG_LEVEL",
    "LOCAL_DEV_FORCE_DOCKER_MACHINE_BOOTSTRAP",
    "SPIRE_SERVER_API_ADDRESS",
    "SSL_CERT_FILE",
]
_controller_chart_extra_env = []
for _name in _controller_chart_extra_env_names:
    if _name in _tilt_env:
        _controller_chart_extra_env.append({"name": _name, "value": _tilt_env[_name]})
# NODE_REBOOT_SOFT_REBOOT_ENABLED is honored from the process environment first (with the
# .env.tilt value as a fallback) so CI can disable soft reboot without touching the
# production default.
_controller_node_reboot_soft_reboot_enabled = os.getenv(
    "NODE_REBOOT_SOFT_REBOOT_ENABLED",
    _tilt_env.get("NODE_REBOOT_SOFT_REBOOT_ENABLED", ""))
if _controller_node_reboot_soft_reboot_enabled != "":
    _controller_chart_extra_env.append({
        "name": "NODE_REBOOT_SOFT_REBOOT_ENABLED",
        "value": _controller_node_reboot_soft_reboot_enabled,
    })
for _name in _required_cred_names:
    _controller_chart_extra_env.append({"name": _name, "value": _required_creds[_name]})
# API authentication comes from the apiAuth values below, not from this env list.

# Local node images include the CNI manifests package, so install CNI after
# kubeadm init without a bundle server. E2E lanes can still select the legacy
# in-init path explicitly through the process environment or .env.tilt.
_controller_install_cni_after_init = os.getenv(
    "INSTALL_CNI_AFTER_INIT",
    _tilt_env.get("INSTALL_CNI_AFTER_INIT", "true"))

# Keep the chart default when this is unset. E2E sets it explicitly so the
# deployment-wide method matches the attestor baked into its CAPD node image.
_controller_spire_attestation_method = os.getenv(
    "NODE_AGENT_SPIRE_ATTESTATION_METHOD",
    _tilt_env.get("NODE_AGENT_SPIRE_ATTESTATION_METHOD", ""))

# The chart defaults controllers.nico.enabled to true. Only the nico and
# nico-vm providers install the NicoMachine CRD, and the controller exits
# when the flag is true without that CRD.
_nico_controllers_enabled = "nico" in _provider_names or "nico-vm" in _provider_names

_controller_chart_flags = [
    "--create-namespace",
    "--set", "cni.installAfterInit=%s" % ("true" if _controller_install_cni_after_init == "true" else "false"),
    "--values", "hack/tilt-controller-chart-values.yaml",
    "--set-string", "appDb.postgresPassword=%s" % _postgres_superuser_password,
    "--set", "apiAuth.enabled=%s" % ("true" if _controller_auth_enabled else "false"),
    "--set", "apiAuth.permissive=%s" % ("true" if _controller_permissive_mode else "false"),
] + (["--values", "hack/tilt-controller-api-auth-values.yaml"] if _controller_auth_enabled else []) + [
    "--set", "capi.rbac.create=true",
    # machine-engine-crds installs them, so Helm must not try to own them.
    "--set", "releaseCRDs.install=false",
    "--set", "tenantAccess.enabled=%s" % ("true" if _controller_tenant_access_enabled else "false"),
    "--set", "controllers.nico.enabled=%s" % ("true" if _nico_controllers_enabled else "false"),
    "--set", "nvkeOIDCAuth.enabled=%s" % ("true" if _controller_oidc_enabled else "false"),
    "--set-string", "nvkeOIDCAuth.issuerURL=%s" % NKE_OIDC_ISSUER_URL,
    "--set-string", "nvkeOIDCAuth.discoveryURL=https://%s:30443/.well-known/openid-configuration" % _kind_site_controller_vip,
    "--set-string", "nvkeOIDCAuth.caBundleSecret.namespace=%s" % SPIRE_NAMESPACE,
    "--set-string", "nvkeOIDCAuth.caBundleSecret.name=oidc-provider-upstream-ca",
    "--set-string", "nvkeOIDCAuth.caBundleSecret.key=ca.crt",
    "--set-string", "spiffe.trustDomain=%s" % SPIRE_TRUST_DOMAIN,
    "--set-string", "spiffe.spire.serverAddress=%s" % _tilt_env.get("SPIRE_SERVER_ADDRESS", _kind_site_controller_vip),
    # helm splits --set-string on commas; escape the one inside the value.
    "--set-string", "supportedInfraProviders=%s" % "\\,".join(_supported_infra_providers),
    "--set-json", "env=%s" % encode_json(_controller_chart_extra_env),
    "--wait",
    "--timeout", "10m",
] + _all_controller_chart_flags

if _controller_spire_attestation_method != "":
    _controller_chart_flags += [
        "--set-string", "nodeAgent.spireAttestationMethod=%s" % _controller_spire_attestation_method,
    ]

if CONTROLLER_IMAGE:
    _image_parts = CONTROLLER_IMAGE.split(":")
    if len(_image_parts) > 1:
        _controller_chart_flags += [
            "--set-string", "image.repository=%s" % ":".join(_image_parts[:-1]),
            "--set-string", "image.tag=%s" % _image_parts[-1],
        ]
    else:
        _controller_chart_flags += [
            "--set-string", "image.repository=%s" % CONTROLLER_IMAGE,
            "--set-string", "image.tag=latest",
        ]

_controller_local_debug_active = os.path.exists(CONTROLLER_LOCAL_DEBUG_MARKER)
_controller_tilt_goarch = local_arch()
_controller_resource_deps = ["postgres", "temporal", "spire-nvke-services-spiffe-id", "spire-tpm-pubhashes", "nvke-system-namespace", "nvke-auth-dev", "machine-engine-releases"] + _all_controller_resource_deps
if _controller_oidc_enabled:
    _controller_resource_deps += ["spire-oidc-provider-nodeport", "oidc-upstream-ca-ready"]

_controller_image_deps = []
_controller_image_keys = []
if not CONTROLLER_IMAGE and not _controller_local_debug_active:
    _controller_image_deps = ["docker.local/cwe:tilt"]
    _controller_image_keys = [("image.repository", "image.tag")]
    _controller_resource_deps = ["nvke-controller-compile"] + _controller_resource_deps
elif _controller_local_debug_active:
    print("Skipping in-cluster controller image build while local controller debug mode is active")

_controller_compile_script = """
      set -euo pipefail
      mkdir -p bin
      CGO_ENABLED=0 GOOS=linux GOARCH="%s" make build
""" % _controller_tilt_goarch

# Default to the sanitized fixture that ships in this repository. It is
# Apache-2.0, builds from a Docker Hub base, and is what CI already uses
# (hack/ci/backend-e2e.sh). Defaulting to the nke-site-deploy sibling instead meant
# a plain `tilt up` failed for anyone without that checkout, even though a
# working profiles tree was one directory away.
#
# Point NVKE_CONTROLLER_PROFILES_DIR at nke-site-deploy/cwe-profiles/profiles to exercise
# the fleet profiles.
# NKE_CONTROLLER_PROFILES_DIR, NKE_CONTROLLER_PROFILES_PRELOADED, CWE_PROFILES_DIR and CWE_PROFILES_PRELOADED are deprecated aliases for the NVKE_CONTROLLER_ names; #1399 removes them.
_controller_profiles_dir = (os.getenv("NVKE_CONTROLLER_PROFILES_DIR", "") or os.getenv("NKE_CONTROLLER_PROFILES_DIR", "") or os.getenv("CWE_PROFILES_DIR", "") or _tilt_env.get("NVKE_CONTROLLER_PROFILES_DIR", "") or _tilt_env.get("NKE_CONTROLLER_PROFILES_DIR", "") or _tilt_env.get("CWE_PROFILES_DIR", "")).strip()
if _controller_profiles_dir == "":
    _controller_profiles_dir = os.path.abspath(os.path.join(config.main_dir, "test", "fixtures", "profiles"))
elif not _controller_profiles_dir.startswith("/"):
    _controller_profiles_dir = os.path.abspath(os.path.join(config.main_dir, _controller_profiles_dir))
_controller_profiles_preloaded = (os.getenv("NVKE_CONTROLLER_PROFILES_PRELOADED", "") or os.getenv("NKE_CONTROLLER_PROFILES_PRELOADED", "") or os.getenv("CWE_PROFILES_PRELOADED", "")) == "true"
# Starlark's os.path has exists/join but not isdir.
if not _controller_profiles_preloaded and not _controller_profiles_dir:
    fail("NVKE_CONTROLLER_PROFILES_DIR must point to an external profiles directory")
if not _controller_profiles_preloaded and not os.path.exists(_controller_profiles_dir):
    fail("Controller profiles not found at %s. Set NVKE_CONTROLLER_PROFILES_DIR to a profiles tree; the in-repo fixture is controller/test/fixtures/profiles and the fleet profiles live in nke-site-deploy." % _controller_profiles_dir)

_controller_profiles_context = os.path.dirname(_controller_profiles_dir)
_controller_profiles_dockerfile = os.path.join(_controller_profiles_context, "Dockerfile")
_controller_profiles_runbooks_dir = os.path.join(_controller_profiles_context, "runbooks")

# Match hack/tilt-controller-chart-values.yaml: when profiles.image is on, skip baking
# profiles into the Tilt controller image and skip live_update sync into the read-only mount.
_controller_profiles_image_enabled = True

if _controller_profiles_image_enabled:
    if _controller_profiles_preloaded:
        print("Using preloaded docker.local/cwe-profiles:tilt image")
    else:
        _controller_image_deps = _controller_image_deps + ["docker.local/cwe-profiles:tilt"]
        _controller_image_keys = _controller_image_keys + [("profiles.image.repository", "profiles.image.tag")]
        if not os.path.exists(_controller_profiles_dockerfile):
            fail("Controller profiles Dockerfile not found at %s" % _controller_profiles_dockerfile)
        if not os.path.exists(_controller_profiles_runbooks_dir):
            fail("Controller profile runbooks not found at %s" % _controller_profiles_runbooks_dir)
        custom_build(
            ref="docker.local/cwe-profiles:tilt",
            command=[
                "bash", "-c",
                """
                set -euo pipefail
                if [ "$(uname -s)" = "Darwin" ] && [ -z "${DOCKER_HOST:-}" ]; then
                  export DOCKER_HOST="${COLIMA_DOCKER_HOST:-unix://${HOME}/.colima/default/docker.sock}"
                fi
                retry() { "$@" || { echo "docker build failed, retrying once in 15s" >&2; sleep 15; "$@"; }; }; retry docker build --platform linux/%s --tag "$EXPECTED_REF" -f "%s" "%s"
                """ % (_controller_tilt_goarch, _controller_profiles_dockerfile, _controller_profiles_context),
            ],
            deps=[_controller_profiles_dir, _controller_profiles_runbooks_dir, _controller_profiles_dockerfile],
        )

# docker build runs through a one-shot retry: the mirror can 404 a layer it just resolved.
_controller_build_script = """
      set -euo pipefail

      if [ "$(uname -s)" = "Darwin" ] && [ -z "${DOCKER_HOST:-}" ]; then
        export DOCKER_HOST="${COLIMA_DOCKER_HOST:-unix://${HOME}/.colima/default/docker.sock}"
      fi

      mkdir -p bin
      # nvke-controller-compile owns bin/controller. Compiling here too rewrote a file this
      # build watches, so every build queued the next one.
      [ -x bin/controller ] || CGO_ENABLED=0 GOOS=linux GOARCH="%s" make build
      tmp_dir="$(mktemp -d)"
      trap 'rm -rf "${tmp_dir}"' EXIT
      cp hack/Dockerfile.controller.tilt "${tmp_dir}/Dockerfile"
      mkdir -p "${tmp_dir}/bin"
      cp bin/controller "${tmp_dir}/bin/controller"
      retry() { "$@" || { echo "docker build failed, retrying once in 15s" >&2; sleep 15; "$@"; }; }; retry docker build --platform linux/%s --tag "$EXPECTED_REF" "${tmp_dir}"
""" % (_controller_tilt_goarch, _controller_tilt_goarch)

if not _controller_profiles_image_enabled:
    _controller_build_script = """
      set -euo pipefail

      if [ "$(uname -s)" = "Darwin" ] && [ -z "${DOCKER_HOST:-}" ]; then
        export DOCKER_HOST="${COLIMA_DOCKER_HOST:-unix://${HOME}/.colima/default/docker.sock}"
      fi

      mkdir -p bin
      # nvke-controller-compile owns bin/controller. Compiling here too rewrote a file this
      # build watches, so every build queued the next one.
      [ -x bin/controller ] || CGO_ENABLED=0 GOOS=linux GOARCH="%s" make build
      tmp_dir="$(mktemp -d)"
      trap 'rm -rf "${tmp_dir}"' EXIT
      cp hack/Dockerfile.controller.tilt "${tmp_dir}/Dockerfile"
      # Bake profiles into the image when profiles.image materialize is off.
      awk '1; /^RUN mkdir -p [/]profiles$/ {print "COPY ./profiles /profiles"}' \
        "${tmp_dir}/Dockerfile" > "${tmp_dir}/Dockerfile.new"
      mv "${tmp_dir}/Dockerfile.new" "${tmp_dir}/Dockerfile"
      mkdir -p "${tmp_dir}/bin"
      cp bin/controller "${tmp_dir}/bin/controller"
      mkdir -p "${tmp_dir}/profiles"
      cp -a "%s/." "${tmp_dir}/profiles/"
      retry() { "$@" || { echo "docker build failed, retrying once in 15s" >&2; sleep 15; "$@"; }; }; retry docker build --platform linux/%s --tag "$EXPECTED_REF" "${tmp_dir}"
""" % (_controller_tilt_goarch, _controller_profiles_dir, _controller_tilt_goarch)

if not CONTROLLER_IMAGE and not _controller_local_debug_active:
    local_resource(
        "nvke-controller-compile",
        cmd=["bash", "-c", _controller_compile_script],
        labels=["3-nvke-controller"],
        deps=[
          "cmd",
          "internal",
          "api",
          "Makefile",
          "Makefile.dev",
          "go.mod",
          "go.sum",
        ],
        ignore=[
          "**/__debug_bin*",
        ],
    )

# The chart's own CRD bundle, applied before the chart, which has its copy turned
# off with releaseCRDs.install=false: a local resource that waits for the chart to
# install them holds every unparallelizable build behind it, including the chart's.
local_resource(
    "machine-engine-crds",
    cmd=["bash", "-c", """
      set -euo pipefail
      kubectl apply --server-side --field-manager=tilt-release-crds \
        -f deploy/charts/controller/files/crds.yaml
      for crd in machineimages clusterreleases nodepoolreleases; do
        kubectl wait --for=condition=Established --timeout=120s "crd/${crd}.internal.nvke.nvidia.com"
      done
    """],
    labels=["3-nvke-controller"],
    deps=["deploy/charts/controller/files/crds.yaml"],
    resource_deps=["check-management-cluster"],
)

# Applies the releases the controller resolves every OS image from.
# NKE_CONTROLLER_RELEASES_DIR is a deprecated alias for NVKE_CONTROLLER_RELEASES_DIR; #1399 removes it.
_nke_release_dir = (os.getenv("NVKE_CONTROLLER_RELEASES_DIR", "") or os.getenv("NKE_CONTROLLER_RELEASES_DIR", "") or _tilt_env.get("NVKE_CONTROLLER_RELEASES_DIR", "") or _tilt_env.get("NKE_CONTROLLER_RELEASES_DIR", "")).strip()
if _nke_release_dir == "":
    _nke_release_dir = os.path.join(_controller_profiles_context, "releases")
elif not _nke_release_dir.startswith("/"):
    _nke_release_dir = os.path.abspath(os.path.join(config.main_dir, _nke_release_dir))

local_resource(
    "machine-engine-releases",
    cmd=["bash", "-c", """
      set -euo pipefail
      dir="%s"
      [ -d "${dir}" ] || { echo "releases not found at ${dir}; set NVKE_CONTROLLER_RELEASES_DIR to a directory of generated MachineImage, ClusterRelease and NodePoolRelease manifests" >&2; exit 1; }
      # MachineImage specs are immutable. After editing a profile, delete the
      # stale image (kubectl delete machineimage <name>) and apply again.
      kubectl apply --server-side --field-manager=tilt-releases -f "${dir}"
    """ % _nke_release_dir],
    labels=["3-nvke-controller"],
    deps=[_nke_release_dir],
    resource_deps=["machine-engine-crds"],
    allow_parallel=True,
)

helm_resource(
    "nvke-controller",
    chart="deploy/charts/controller",
    labels=["3-nvke-controller"],
    release_name="nvke-controller",
    namespace=CONTROLLER_NAMESPACE,
    image_deps=_controller_image_deps,
    image_keys=_controller_image_keys,
    deps=[
      ".env.tilt",
      ".env.tilt.example",
      "hack/tilt-controller-chart-values.yaml",
      "hack/tilt-controller-api-auth-values.yaml",
      "deploy/charts/controller",
    ],
    flags=_controller_chart_flags,
    resource_deps=_controller_resource_deps,
    port_forwards=[CONTROLLER_HTTP_PORT + ":8080"],
    links=[
      ui_link(CONTROLLER_HTTP_PORT, "/api/docs", "Swagger Docs"),
      ui_link(CONTROLLER_HTTP_PORT, "/metrics", "Metrics"),
      ui_link(CONTROLLER_TEMPORAL_UI_PORT, "/namespaces/nvke-controller/workflows", "Temporal UI"),
    ],
)

if not CONTROLLER_IMAGE and not _controller_local_debug_active:
    # When profiles.image is enabled, /profiles is an emptyDir filled by the
    # materialize initContainer (read-only on the app container). Do not
    # live_update sync into that mount.
    _controller_live_update = [
      fall_back_on(["hack/Dockerfile.controller.tilt", "go.mod", "go.sum", "Makefile", "Makefile.dev"]),
      sync("bin/controller", "/usr/local/bin/controller"),
    ]
    _controller_build_deps = [
      "bin",
      "hack/Dockerfile.controller.tilt",
      "Makefile",
      "Makefile.dev",
      "go.mod",
      "go.sum",
    ]
    if not _controller_profiles_image_enabled:
        _controller_live_update.insert(-1, sync(_controller_profiles_dir, "/profiles"))
        _controller_build_deps.append(_controller_profiles_dir)

    custom_build_with_restart(
        ref="docker.local/cwe:tilt",
        command=["bash", "-c", _controller_build_script],
        deps=_controller_build_deps,
        entrypoint="/usr/local/bin/controller",
        live_update=_controller_live_update,
        trigger=["bin/controller"],
        ignore=[
          "**/__debug_bin*",
        ],
    )

cmd_button(
