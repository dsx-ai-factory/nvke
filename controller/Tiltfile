local_resource(
    "port-forward-spire-server",
    labels=["1-infra"],
    serve_cmd="while true; do kubectl -n " + SPIRE_NAMESPACE + " port-forward svc/spire-server-np 30440:443 || true; sleep 2; done",
    resource_deps=["spire-server"],
    readiness_probe=probe(exec=exec_action(["nc", "-z", "localhost", "30440"]), period_secs=5, failure_threshold=2),
    allow_parallel=True,
)

# Bind the SPIRE server and OIDC discovery NodePorts on the kind bridge
# gateway IP. NodePort services bind on each kind node's container IP, not on
# the gateway, so tenants dialing the gateway IP would otherwise hit nothing.
# Linux only: on macOS the kind gateway IP doesn't exist on the host (it
# lives inside the Docker VM) and `kubectl port-forward --address` would
# fail to bind there anyway. It's also unnecessary on macOS: tenants dial
# the management node's own container IP directly (see
# _kind_site_controller_vip above), which already carries the NodePort. A
# configured site_controller_vip (CI) points tenants directly at a Kind node
# too, so the gateway forwards are unnecessary in that mode as well.
if not _on_mac and not SITE_CONTROLLER_VIP_OVERRIDE:
    local_resource(
        "port-forward-spire-server-kind-gw",
        labels=["1-infra"],
        serve_cmd="while true; do kubectl -n %s port-forward --address %s svc/spire-server-np 30440:443 || true; sleep 2; done" % (SPIRE_NAMESPACE, _kind_host_ip),
        resource_deps=["spire-server"],
        readiness_probe=probe(exec=exec_action(["nc", "-z", _kind_host_ip, "30440"]), period_secs=5, failure_threshold=2),
        allow_parallel=True,
    )

    local_resource(
        "port-forward-spire-oidc-kind-gw",
        labels=["1-infra"],
        serve_cmd="while true; do kubectl -n %s port-forward --address %s svc/spire-oidc-provider-np 30443:443 || true; sleep 2; done" % (SPIRE_NAMESPACE, _kind_host_ip),
        resource_deps=["spire-server"],
        readiness_probe=probe(exec=exec_action(["nc", "-z", _kind_host_ip, "30443"]), period_secs=5, failure_threshold=2),
        allow_parallel=True,
    )

k8s_resource(
