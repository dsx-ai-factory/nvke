# ---------------------------------------------------------------------------
# Provider configuration
# ---------------------------------------------------------------------------
# Providers list supports strings and dicts:
#   "capi_core"               -- built-in CAPI core support
#   "bgp-containers"          -- shared BGP router and default-site VIP pool for container nodes
#   "capd"                    -- built-in CAPD support
#   "nico"                    -- CAPNICo plus NICo endpoint (nico-sim by default)
#   "launchlayer"             -- CAPLL plus its fake LaunchLayer API, from capll_source_dir
#   "capd-reboot-controller"  -- CAPD reboot dev controller provider
#   "capi-syscmp"             -- CAPI system component addon provider
#   "dsx-identity-exchange"   -- DSX-compatible JWT exchange test double
#   "dsx-imds-attestation"    -- local DSX IMDS node-attestation fixture
#   {"my-provider": "/path/to/folder"} -- external, Tiltfile at <folder>/Tiltfile
# Default: ["capi_core", "bgp-containers", "capd", "capd-reboot-controller"]

# Provider interface
# ------------------
# Each provider must expose a `register` function in <provider_dir>/Tiltfile:
#
#   def register(ctx):
#       ...
#       return struct(controller_resource_deps, controller_env_overrides,
#                     preflight_script=...)  # optional
#
# Input — ctx is a struct with:
#   ctx.main_dir      (string)  Root directory of the main Tiltfile (config.main_dir).
#   ctx.cfg           (dict)    Parsed tilt_config.json contents.
#   ctx.tilt_env      (dict)    Parsed .env.tilt contents, falling back to .env.tilt.example.
#   ctx.provider_names (list[string]) Enabled provider names, normalized from strings and dicts.
#   ctx.kind_host_ip  (string)  IP reachable from inside Kind pods (e.g. Kind gateway).
#   ctx.kind_cluster_name (string) Name of the active Kind management cluster.
#   ctx.spire_trust_domain (string) Trust domain configured for the local SPIRE server.
#   ctx.site_controller_vip (string) Address reachable from local tenant nodes.
#   ctx.provider_dir  (string)  Absolute path to the provider's root directory.
#
# Output — returned struct with:
#   controller_resource_deps (list[string])     Tilt resource names the controller should depend on.
#                                               Appended to the nvke-controller resource's resource_deps.
#   controller_env_overrides (dict[string, string]) Overrides for .env.tilt. Only the names this file passes to
#                                               the controller's env list reach it; settings in
#                                               nvke-controller-config go through controller_chart_flags.
#   controller_chart_flags (list[string], optional) Additional Helm flags for the controller.
#   spire_chart_flags  (list[string], optional) Additional Helm flags for SPIRE.
#   spire_resource_deps (list[string], optional) Tilt resources SPIRE should depend on.
#   preflight_script   (string, optional)       Bash fragment appended to the
#                                               check-management-cluster preflight script.
#                                               Use to assert provider-required tooling or
#                                               CRDs are present in the cluster.
#
# cwe_resource_deps, cwe_env_overrides and cwe_chart_flags are the deprecated
# names of the three controller_ fields. They are still read for one release.
#
# Inside register(), the provider creates its own Tilt resources (local_resource,
# helm_resource, etc.) and returns the struct to wire itself into the controller.

# Built-in provider name -> directory (relative to config.main_dir, or absolute).
_builtin_provider_dirs = {
    "capi_core": os.path.join(config.main_dir, "hack/capi-core-provider"),
    "bgp-containers": os.path.join(config.main_dir, "hack/bgp-containers"),
    "capd": os.path.join(config.main_dir, "hack/capd-provider"),
    "nico": os.path.join(config.main_dir, "hack/nico-provider"),
    "launchlayer": os.path.join(config.main_dir, "hack/launchlayer-provider"),
    "capd-reboot-controller": os.path.join(config.main_dir, "hack/capd-reboot-controller"),
    "capi-syscmp": os.path.join(config.main_dir, "hack/capi-syscmp-provider"),
    "dsx-identity-exchange": os.path.join(config.main_dir, "hack/dsx-identity-exchange-mock"),
    "dsx-imds-attestation": os.path.join(config.main_dir, "hack/dsx-imds-attestation"),
    "management-engine": os.path.join(config.main_dir, "../management-engine"),
}

_tilt_config = read_json("tilt_config.json", default={})
cfg = _tilt_config
# CI can preload immutable images into Kind and bypass the local Docker builds.
# Local development keeps the existing build behavior when these are unset.
CONTROLLER_IMAGE = cfg.get("nvke_controller_image", "")
# cwe_image is the deprecated name of nvke_controller_image, read for one release.
if not CONTROLLER_IMAGE and cfg.get("cwe_image", ""):
    warn("tilt_config.json: cwe_image is deprecated; rename it to nvke_controller_image.")
    CONTROLLER_IMAGE = cfg["cwe_image"]
SITE_CONTROLLER_VIP_OVERRIDE = cfg.get("site_controller_vip", "")

_provider_entries = cfg.get("providers", [
    "capi_core",
    "bgp-containers",
    "capd",
    "capd-reboot-controller",
])
def _provider_entry_name(entry):
    if type(entry) == "string":
        return entry
    return entry.keys()[0]

_provider_names = [_provider_entry_name(_entry) for _entry in _provider_entries]
DSX_IDENTITY_EXCHANGE_ENABLED = "dsx-identity-exchange" in _provider_names

if "nico" in _provider_names and "capi_core" not in _provider_names:
    fail("Provider 'nico' requires 'capi_core' in the provider list.")

if "capd" in _provider_names and "capi_core" not in _provider_names:
    fail("Provider 'capd' requires 'capi_core' in the provider list.")

if "capi-syscmp" in _provider_names and "capi_core" not in _provider_names:
    fail("Provider 'capi-syscmp' requires 'capi_core' in the provider list.")

if "nico-vm" in _provider_names and "capi_core" not in _provider_names:
    fail("Provider 'nico-vm' requires 'capi_core' in the provider list.")

if "launchlayer" in _provider_names and "capi_core" not in _provider_names:
    fail("Provider 'launchlayer' requires 'capi_core' in the provider list.")

# nico-vm points nico-credentials at the local nico-vms backend and its
# credentials resource depends on the 'nico-vms' Tilt resource by name.
#
# 'nico-vm' and 'nico-vms' are one character apart, so both fail() messages
# below name what each provider IS rather than relying on the key alone.
if "nico-vm" in _provider_names and "nico-vms" not in _provider_names:
    fail("Provider 'nico-vm' (the CAPNICo controller, installed from the NGC Helm chart) " +
         "requires 'nico-vms' (the local VM backend that serves the Forge API on port 18080) " +
         "in the provider list: it points nico-credentials at that backend and depends on " +
         "its Tilt resource by name.")

# 'nico' and 'nico-vms' are mutually exclusive Forge backends for the controller: both
# bind host port 18080 (nico-mock's port-forward vs nico-vms's listener). Enable at
# most one. (capd is orthogonal and may accompany either.)
if "nico" in _provider_names and "nico-vms" in _provider_names:
    fail("Providers 'nico' (nico-mock, container-backed nodes) and 'nico-vms' (real " +
         "KVM/libvirt VMs) are mutually exclusive controller backends: both bind host port 18080. " +
         "Enable only one (capd may accompany either).")

# 'nico' and 'nico-vm' are mutually exclusive ways to get a CAPNICo
# controller: both install one into the capnico-system namespace and own the
# 'nico-credentials' secret it reads. Enable at most one.
if "nico" in _provider_names and "nico-vm" in _provider_names:
    fail("Providers 'nico' (nico-mock, container-backed) and 'nico-vm' (the CAPNICo chart " +
         "from NGC) are mutually exclusive: both install a CAPNICo controller into " +
         "capnico-system and own the 'nico-credentials' secret. Enable only one.")

# The controller accepts only the API provider blocks in supportedInfraProviders. The
# 'nico' provider (nico-sim) serves the container and the nico-vms backends;
# the e2e suite submits Infra blocks to the first and Nico blocks to the second.
_supported_infra_providers = []
if "nico" in _provider_names or "nico-vms" in _provider_names:
    _supported_infra_providers.append("nico")
if "capd" in _provider_names or "nico" in _provider_names or "nico-vm" in _provider_names:
    _supported_infra_providers.append("infra")
if "launchlayer" in _provider_names:
    _supported_infra_providers.append("launchLayer")
if not _supported_infra_providers:
    _supported_infra_providers.append("nico")

