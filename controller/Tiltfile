CWE_TEMPORAL_UI_PORT = os.getenv("CWE_TEMPORAL_UI_PORT", "8081")

# Tilt UI links open in the browser of whoever views the Tilt UI. When Tilt runs
# on a remote host accessed via forwarded ports (e.g. Mutagen forwards a target
# at +1000), set TILT_LINK_PORT_OFFSET so links point at the correct forwarded
# port. Default 0 = local (links match the host's bind ports). This offsets only
# the displayed link URLs, not the actual service bind / port-forward ports.
LINK_PORT_OFFSET = int(os.getenv("TILT_LINK_PORT_OFFSET", "0"))

def ui_link(port, path, name):
    return link("http://localhost:%d%s" % (int(port) + LINK_PORT_OFFSET, path), name)

# Pin chart versions to avoid surprise breakage from upstream releases.
CHART_VERSION_POSTGRESQL = "18.5.15"
CHART_VERSION_TEMPORAL = "0.74.0"
CHART_VERSION_SPIRE_CRDS = "0.5.0"
CHART_VERSION_CERT_MANAGER = "v1.20.2"

def get_kind_cluster_name():
    kind_cluster_name = os.getenv("KIND_CLUSTER_NAME", "")
    if kind_cluster_name != "":
        return kind_cluster_name

    current_context = k8s_context()
    if current_context.startswith("kind-"):
        return current_context[5:]

    return "kind-cluster-name-not-set"

KIND_CLUSTER_NAME_VALUE = get_kind_cluster_name()
EXPECTED_K8S_CONTEXT = "kind-%s" % KIND_CLUSTER_NAME_VALUE
SPIRE_TRUST_DOMAIN = "%s.nke.local" % KIND_CLUSTER_NAME_VALUE
NKE_OIDC_ISSUER_URL = "https://nke.site-controller.internal"

# sha256 of /app/tpm_attestor_server inside ghcr.io/spiffe/spire-tpm-plugin-tpm-attestor-server:v1.9.0,
# selected by host arch (kind pulls the Linux variant matching the host CPU). Override via env var
# when bumping the image; recompute with:
#   docker run --rm --entrypoint sha256sum ghcr.io/spiffe/spire-tpm-plugin-tpm-attestor-server:v1.9.0 /app/tpm_attestor_server
def normalize_arch(arch):
    if arch == "x86_64":
        return "amd64"
    if arch == "aarch64":
        return "arm64"
    return arch

def local_arch():
    docker_arch = str(local("docker version --format '{{.Server.Arch}}' 2>/dev/null || true", quiet=True, echo_off=True)).strip()
    if docker_arch != "":
        return normalize_arch(docker_arch)

    return normalize_arch(str(local("uname -m", quiet=True, echo_off=True)).strip())

def _spire_tpm_attestor_server_checksum():
    override = os.getenv("SPIRE_TPM_ATTESTOR_SERVER_CHECKSUM")
    if override:
        return override

    arch = local_arch()
    checksums = {
        "amd64": "46d0caad8c25a027dd11c93e18b58a8bc6fbd9f1fe2e36fa2a0dd440986de4dc",
        "arm64": "b69d0153c8241383f24da138bc85429a620d9f962a2f10abb314aa0e39046d16",
    }
    if arch not in checksums:
        fail("unsupported host arch %r for SPIRE TPM attestor server; set SPIRE_TPM_ATTESTOR_SERVER_CHECKSUM explicitly" % arch)
    return checksums[arch]

SPIRE_TPM_ATTESTOR_SERVER_CHECKSUM = _spire_tpm_attestor_server_checksum()

if k8s_context() != EXPECTED_K8S_CONTEXT:
    fail("Tilt must run against kube context '%s', but the current context is '%s'" % (EXPECTED_K8S_CONTEXT, k8s_context()))

allow_k8s_contexts(EXPECTED_K8S_CONTEXT)

# Increase the timeout for k8s upsert operations to 15 minutes for large helm charts.
update_settings(k8s_upsert_timeout_secs=900)

def include_user_tilt_files():
    if not os.path.exists("tilt.d"):
        return

    for f in listdir("tilt.d"):
        if not (f.endswith(".tilt") or f.endswith(".star")):
            continue
        include(f)

# ---------------------------------------------------------------------------
# cert-manager — needed by the OIDC discovery provider to issue its TLS cert
# from the long-lived NKE OIDC upstream CA (see deploy/k8s/oidc-upstream-ca.yaml).
#
# cert-manager is frequently already present out-of-band — most commonly
# clusterctl installs its own copy when it initialises CAPI. We probe the
# cluster at parse time and
# branch:
#   * absent                       -> install via helm (fresh)
#   * present, helm-managed         -> keep the helm_resource so Tilt owns
#                                      upgrades / value changes
#   * present, not helm-managed     -> skip helm entirely; stand up a readiness
#     (e.g. clusterctl)                gate under the same resource name so
#                                      downstream deps stay wired
#
# Either way the resource is named "cert-manager" so dependents (spire-server,
# oidc-ca-bootstrap) need no special-casing. If the cluster is unreachable at
# parse time the probe reports "absent" and we fall back to the helm path —
# the helm_resource depends on check-management-cluster, so nothing actually
# runs until the cluster is up.
# ---------------------------------------------------------------------------
CERT_MANAGER_NAMESPACE = "cert-manager"

def detect_cert_manager():
    # Presence is checked via the CRD (namespace- and installer-agnostic).
    # Ownership is checked via `helm status`, which is authoritative for
    # "Tilt's helm can manage this release".
    state = str(local(
        """
        if ! kubectl get crd certificates.cert-manager.io >/dev/null 2>&1; then
          echo absent
        elif helm status cert-manager -n %s >/dev/null 2>&1; then
          echo helm
        else
          echo external
        fi
        """ % CERT_MANAGER_NAMESPACE,
        quiet=True,
        echo_off=True,
    )).strip()
    # Guard against unexpected output (e.g. unreachable cluster noise): default
    # to the fresh-install path, matching prior behaviour.
    if state not in ("absent", "helm", "external"):
        return "absent"
    return state

# ---------------------------------------------------------------------------
# Provider loading
# ---------------------------------------------------------------------------

# Host IP reachable from inside Kind pods. On macOS, host.docker.internal works.
# On Linux with native Docker, use the Kind network gateway IP.
_kind_host_ip = str(local(
    "docker network inspect kind -f '{{range .IPAM.Config}}{{if .Gateway}}{{println .Gateway}}{{end}}{{end}}' 2>/dev/null | grep -v : | head -1 || echo host.docker.internal",
    quiet=True,
)).strip() or "host.docker.internal"

# Tenants reach the management cluster's SPIRE + OIDC endpoints at this address
# (the "fake site-controller VIP" in tilt). Linux and macOS need different
# answers because Docker on macOS runs in a VM:
#   * Linux native Docker: bind NodePorts on the kind bridge gateway via
#     kubectl port-forward; tenants dial that IP.
#   * macOS (Docker Desktop or Colima): CAPD tenant nodes are sibling
#     containers on the same `kind` Docker network as the management node
#     (named "<cluster>-control-plane" by Kind), so they can reach it
#     directly by its own container IP — no VM-side proxying or host-side
#     port-forward required. This sidesteps host.docker.internal entirely:
#     under Docker Desktop it works but is unnecessary, and under Colima it
#     resolves to a fixed VM-side gateway address whose port forwarder does
#     not reliably forward the SPIRE OIDC NodePort back through it.
#     host.docker.internal is kept only as a fallback for setups where the
#     management node isn't a "<cluster>-control-plane" container on the
#     `kind` network (e.g. non-CAPD backends).
#   * CI: site_controller_vip may point directly at the Kind control-plane IP;
#     CAPD machines share that Docker network and can use its NodePorts.
_on_mac = str(local("uname -s", quiet=True, echo_off=True)).strip() == "Darwin"
if SITE_CONTROLLER_VIP_OVERRIDE:
    _kind_site_controller_vip = SITE_CONTROLLER_VIP_OVERRIDE
elif _on_mac:
    _management_node_ip = str(local(
        "docker inspect --format '{{(index .NetworkSettings.Networks \"kind\").IPAddress}}' %s-control-plane 2>/dev/null || true" % KIND_CLUSTER_NAME_VALUE,
        quiet=True,
        echo_off=True,
    )).strip()
    _kind_site_controller_vip = _management_node_ip or "host.docker.internal"
else:
    _kind_site_controller_vip = _kind_host_ip

# Collect integration points from all providers.
_all_cwe_resource_deps = []
# Default CWE env overrides applied before any provider overrides. Providers
# can still .update() these if they need a different value.
#
# SPIRE_SERVER_ADDRESS: tenants reach the SPIRE server through the platform-
# correct site-controller VIP, which CWE bakes into the spire-agent config it
# generates for each tenant. The default in .env.tilt.example is
# host.docker.internal, which only resolves on Docker Desktop; this override
# makes the Linux native Docker path work too.
_all_cwe_env_overrides = {
    "SPIRE_SERVER_ADDRESS": _kind_site_controller_vip,
}
_all_preflight_fragments = []

for _entry in _provider_entries:
    if type(_entry) == "string":
        _provider_name = _entry
        _provider_dir = _builtin_provider_dirs.get(_provider_name, "")
        if not _provider_dir:
            fail("Unknown built-in provider '%s'. Use a dict entry for external providers." % _provider_name)
    elif type(_entry) == "dict":
        _provider_name = _entry.keys()[0]
        _provider_dir = _entry[_provider_name]
    else:
        fail("Invalid provider entry: %s" % _entry)

    _tiltfile_path = os.path.join(_provider_dir, "Tiltfile")
    _symbols = load_dynamic(_tiltfile_path)
    _result = _symbols["register"](struct(
        main_dir     = config.main_dir,
        cfg          = cfg,
        kind_host_ip = _kind_host_ip,
        provider_dir = _provider_dir,
    ))
    _all_cwe_resource_deps += _result.cwe_resource_deps
    _all_cwe_env_overrides.update(_result.cwe_env_overrides)
    if getattr(_result, "preflight_script", ""):
        _all_preflight_fragments.append(_result.preflight_script)

# ---------------------------------------------------------------------------
# Preflight checks
# ---------------------------------------------------------------------------
#
# Note: The label and button number prefix e.g. "1-my-button" are hacks to control the order of the resources and buttons in the Tilt UI.
#

_preflight_script = """
      set -euo pipefail
      kubectl cluster-info >/dev/null 2>&1 || {
        echo "No reachable management cluster. Run 'make colima-up' and 'make capd-up' (or 'make capi-core-up') first." >&2
        exit 1
      }
"""
for _fragment in _all_preflight_fragments:
    _preflight_script += _fragment
_preflight_script += """
      current_context="$(kubectl config current-context)"
      kind_cluster_name="${KIND_CLUSTER_NAME:-}"
      if [ -z "${kind_cluster_name}" ]; then
        case "${current_context}" in
          kind-*)
            ;;
          *)
            echo "KIND_CLUSTER_NAME is not set and current context '${current_context}' is not a kind context." >&2
            exit 1
            ;;
        esac
      fi
      command -v helm >/dev/null || {
        echo "helm is required in PATH" >&2
        exit 1
      }
"""
if not CWE_IMAGE:
    _preflight_script += """
      command -v docker >/dev/null || {
        echo "docker is required in PATH" >&2
        exit 1
      }
      command -v go >/dev/null || {
        echo "go is required in PATH (used for GOARCH detection)" >&2
        exit 1
      }
"""
_preflight_script += """
      command -v kind >/dev/null || {
        echo "kind is required in PATH" >&2
        exit 1
      }
      echo "Management cluster and local tooling are ready"
"""

local_resource(
    "check-management-cluster",
    labels=["0-preflight"],
    cmd=["bash", "-c", _preflight_script],
    deps=[],
)

