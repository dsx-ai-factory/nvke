    "temporal-chart",
    cmd=["bash", "-c", """
      set -euo pipefail
      mkdir -p "%s"
      for attempt in 1 2 3 4 5; do
        if helm pull temporal --repo https://go.temporal.io/helm-charts --version "%s" --destination "%s"; then
          exit 0
        fi
        echo "helm pull temporal %s failed (attempt ${attempt}/5), retrying in $((attempt * 10))s" >&2
        sleep $((attempt * 10))
      done
      exit 1
    """ % (TEMPORAL_CHART_DIR, CHART_VERSION_TEMPORAL, TEMPORAL_CHART_DIR, CHART_VERSION_TEMPORAL)],
    labels=["1-infra"],
    allow_parallel=True,
)

