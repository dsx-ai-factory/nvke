def parse_env_file(path):
    values = {}
    if not os.path.exists(path):
        return values
    for line in str(read_file(path)).split("\n"):
        line = line.strip()
        if line == "" or line.startswith("#"):
            continue
        parts = line.split("=", 1)
        if len(parts) != 2:
            continue
        values[parts[0].strip()] = parts[1].strip()
    return values

_tilt_env = parse_env_file(".env.tilt")
if not _tilt_env:
    _tilt_env = parse_env_file(".env.tilt.example")
_tilt_env.update(_all_cwe_env_overrides)

_cwe_capi_enabled = _tilt_env.get("ENABLE_CAPI", "") == "true"
_cwe_forge_capi_enabled = _tilt_env.get("ENABLE_FORGE_CAPI", "") == "true"
_cwe_tenant_access_enabled = os.getenv(
    "TENANT_ACCESS_ENABLED", _tilt_env.get("TENANT_ACCESS_ENABLED", "true")) == "true"
_cwe_oidc_enabled = os.getenv(
    "NKE_OIDC_AUTH_ENABLED", _tilt_env.get("NKE_OIDC_AUTH_ENABLED", "true")) == "true"

_cwe_chart_extra_env_names = [
    "TEMPORAL_UI_URL",
    "CNPG_SUPERUSER_PASSWORD",
    "CNPG_CLOUD_PASSWORD",
    "CNPG_TEMPORAL_PASSWORD",
    "CONTROLLER_MANAGER_POLLING_INTERVAL",
    "CONTROLLER_MANAGER_INTERVAL",
    "NODE_HEALTH_CHECK_POLLING_INTERVAL",
    "NODE_HEALTH_CHECK_INTERVAL",
    "NODE_REBOOT_POLLING_INTERVAL",
    "LOG_LEVEL",
    "FORGE_URL",
    "FORGE_ENVIRONMENT",
    "SPIRE_SERVER_API_ADDRESS",
]
_cwe_chart_extra_env = []
for _name in _cwe_chart_extra_env_names:
    if _name in _tilt_env:
        _cwe_chart_extra_env.append({"name": _name, "value": _tilt_env[_name]})
if _tilt_env.get("FWE_API_KEY", "") != "":
    _cwe_chart_extra_env.append({
        "name": "FWE_API_KEY",
        "value": _tilt_env["FWE_API_KEY"],
    })
_cwe_chart_extra_env += [
    {
        "name": "UI_DIR",
        "value": "/ui",
    },
    {
        "name": "DGXC_TENANT_USER",
        "value": _tilt_env.get("DGXC_TENANT_USER", "local-dev"),
    },
    {
        "name": "DGXC_TENANT_PASSWORD",
        "value": _tilt_env.get("DGXC_TENANT_PASSWORD", "local-dev"),
    },
]

_cwe_chart_flags = [
    "--create-namespace",
    "--values", "hack/tilt-cwe-chart-values.yaml",
    "--set", "capi.enabled=%s" % ("true" if _cwe_capi_enabled else "false"),
    "--set", "capi.forgeCapiEnabled=%s" % ("true" if _cwe_forge_capi_enabled else "false"),
    "--set", "capi.rbac.create=%s" % ("true" if _cwe_capi_enabled else "false"),
    "--set", "tenantAccess.enabled=%s" % ("true" if _cwe_tenant_access_enabled else "false"),
    "--set", "nkeOIDCAuth.enabled=%s" % ("true" if _cwe_oidc_enabled else "false"),
    "--set-string", "nkeOIDCAuth.issuerURL=%s" % NKE_OIDC_ISSUER_URL,
    "--set-string", "nkeOIDCAuth.discoveryURL=https://%s:30443/.well-known/openid-configuration" % _kind_site_controller_vip,
    "--set-string", "nkeOIDCAuth.caBundleSecret.namespace=%s" % SPIRE_NAMESPACE,
    "--set-string", "nkeOIDCAuth.caBundleSecret.name=oidc-provider-upstream-ca",
    "--set-string", "nkeOIDCAuth.caBundleSecret.key=ca.crt",
    "--set-string", "spiffe.trustDomain=%s" % SPIRE_TRUST_DOMAIN,
    "--set-string", "spiffe.spire.serverAddress=%s" % _tilt_env.get("SPIRE_SERVER_ADDRESS", _kind_site_controller_vip),
    "--set-json", "env=%s" % encode_json(_cwe_chart_extra_env),
    "--force",
    "--wait",
    "--timeout", "10m",
]

if CWE_IMAGE:
    _image_parts = CWE_IMAGE.split(":")
    if len(_image_parts) > 1:
        _cwe_chart_flags += [
            "--set-string", "image.repository=%s" % ":".join(_image_parts[:-1]),
            "--set-string", "image.tag=%s" % _image_parts[-1],
        ]
    else:
        _cwe_chart_flags += [
            "--set-string", "image.repository=%s" % CWE_IMAGE,
            "--set-string", "image.tag=latest",
        ]

_cwe_local_debug_active = os.path.exists(CWE_LOCAL_DEBUG_MARKER)
_cwe_tilt_goarch = local_arch()
_cwe_resource_deps = ["postgres", "temporal", "spire-nke-services-spiffe-id", "spire-tpm-pubhashes", "nke-system-namespace"] + _all_cwe_resource_deps
if _cwe_oidc_enabled:
    _cwe_resource_deps += ["spire-oidc-provider-nodeport", "oidc-upstream-ca-ready"]

_cwe_image_deps = []
_cwe_image_keys = []
if not CWE_IMAGE and not _cwe_local_debug_active:
    _cwe_image_deps = ["docker.local/cwe:tilt"]
    _cwe_image_keys = [("image.repository", "image.tag")]
    _cwe_resource_deps = ["cwe-compile"] + _cwe_resource_deps
elif _cwe_local_debug_active:
    print("Skipping in-cluster CWE image build while local CWE debug mode is active")

_cwe_compile_script = """
      set -euo pipefail
      mkdir -p bin
      CGO_ENABLED=0 GOOS=linux GOARCH="%s" make build
""" % _cwe_tilt_goarch

_cwe_build_script = """
      set -euo pipefail

      if [ "$(uname -s)" = "Darwin" ] && [ -z "${DOCKER_HOST:-}" ]; then
        export DOCKER_HOST="${COLIMA_DOCKER_HOST:-unix://${HOME}/.colima/default/docker.sock}"
      fi

      mkdir -p bin
      CGO_ENABLED=0 GOOS=linux GOARCH="%s" make build
      tmp_dir="$(mktemp -d)"
      trap 'rm -rf "${tmp_dir}"' EXIT
      cp hack/Dockerfile.cwe.tilt "${tmp_dir}/Dockerfile"
      mkdir -p "${tmp_dir}/bin"
      cp bin/cloud-workflow-engine "${tmp_dir}/bin/cloud-workflow-engine"
      cp -R profiles "${tmp_dir}/profiles"
      cp -R ui "${tmp_dir}/ui"
      docker build --platform linux/%s --tag "$EXPECTED_REF" "${tmp_dir}"
""" % (_cwe_tilt_goarch, _cwe_tilt_goarch)

if not CWE_IMAGE and not _cwe_local_debug_active:
    local_resource(
        "cwe-compile",
        cmd=["bash", "-c", _cwe_compile_script],
        labels=["3-cwe"],
        deps=[
          "cmd",
          "internal",
          "api",
          "Makefile",
          "Makefile.dev",
          "go.mod",
          "go.sum",
        ],
        ignore=[
          "**/__debug_bin*",
        ],
    )

helm_resource(
    "cwe",
    chart="deploy/charts/cloud-workflow-engine",
    labels=["3-cwe"],
    release_name="cwe",
    namespace=CWE_NAMESPACE,
    image_deps=_cwe_image_deps,
    image_keys=_cwe_image_keys,
    deps=[
      ".env.tilt",
      ".env.tilt.example",
      "hack/tilt-cwe-chart-values.yaml",
      "deploy/charts/cloud-workflow-engine",
    ],
    flags=_cwe_chart_flags,
    resource_deps=_cwe_resource_deps,
    port_forwards=[CWE_HTTP_PORT + ":8080"],
    links=[
      ui_link(CWE_HTTP_PORT, "", "CWE UI"),
      ui_link(CWE_HTTP_PORT, "/api/docs", "Swagger Docs"),
      ui_link(CWE_HTTP_PORT, "/metrics", "Metrics"),
      ui_link(CWE_TEMPORAL_UI_PORT, "/namespaces/cloud-workflow-engine/workflows", "Temporal UI"),
    ],
)

if not CWE_IMAGE and not _cwe_local_debug_active:
    custom_build_with_restart(
        ref="docker.local/cwe:tilt",
        command=["bash", "-c", _cwe_build_script],
        deps=[
          "bin",
          "profiles",
          "ui",
          "hack/Dockerfile.cwe.tilt",
          "Makefile",
          "Makefile.dev",
          "go.mod",
          "go.sum",
        ],
        entrypoint="/usr/local/bin/cloud-workflow-engine",
        live_update=[
          fall_back_on(["hack/Dockerfile.cwe.tilt", "go.mod", "go.sum", "Makefile", "Makefile.dev"]),
          sync("bin/cloud-workflow-engine", "/usr/local/bin/cloud-workflow-engine"),
          sync("profiles", "/profiles"),
          sync("ui", "/ui"),
        ],
        trigger=["bin/cloud-workflow-engine"],
        ignore=[
          "**/__debug_bin*",
        ],
    )

