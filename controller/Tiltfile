# SANs for the OIDC leaf serving cert. _kind_site_controller_vip is usually a
# container IP (Linux's kind bridge gateway, or macOS's auto-detected
# management node IP), which goes into ipAddresses; the host.docker.internal
# fallback is a hostname and must be a dnsName instead. The provider matches
# against the Host header / SNI, so every reachable identity must be present.
def _looks_like_ipv4(value):
    _parts = value.split(".")
    if len(_parts) != 4:
        return False
    for _part in _parts:
        if not _part.isdigit() or int(_part) > 255:
            return False
    return True

_oidc_ip_sans = ["127.0.0.1", _kind_host_ip]
_oidc_dns_sans = []
# _kind_site_controller_vip may be an override, an auto-detected container
# IP, or the host.docker.internal hostname fallback; classify generically by
# shape rather than re-deriving which source it came from.
if _looks_like_ipv4(_kind_site_controller_vip):
    if _kind_site_controller_vip not in _oidc_ip_sans:
        _oidc_ip_sans.append(_kind_site_controller_vip)
else:
    _oidc_dns_sans.append(_kind_site_controller_vip)

_spire_set_string_flags = []
for _i, _ip in enumerate(_oidc_ip_sans):
    _spire_set_string_flags += [
        "--set-string",
        "spiffe-oidc-discovery-provider.tls.certManager.certificate.ipAddresses[%d]=%s" % (_i, _ip),
    ]
# Append the dynamic DNS SANs after the static dnsNames in spire.yaml
# (indices 0..1: nke.site-controller.internal, localhost).
_STATIC_DNS_NAME_COUNT = 2
for _i, _name in enumerate(_oidc_dns_sans):
    _spire_set_string_flags += [
        "--set-string",
        "spiffe-oidc-discovery-provider.tls.certManager.certificate.dnsNames[%d]=%s" % (_STATIC_DNS_NAME_COUNT + _i, _name),
    ]

# Dynamic entries for the provider's accepted-domains list. kube-apiserver
# fetches the discovery URL by IP or hostname, and the provider rejects any
# request whose Host header isn't on this list. Static entries
# (nke.site-controller.internal, localhost, 127.0.0.1) live in spire.yaml.
_oidc_dynamic_domains = [_kind_host_ip, _kind_site_controller_vip]

# Append dynamic domains to the static list defined in spire.yaml. The static
# list has indices 0..2; start the override list at index 3.
_STATIC_ADDITIONAL_DOMAIN_COUNT = 3
for _i, _domain in enumerate(_oidc_dynamic_domains):
    _spire_set_string_flags += [
        "--set-string",
        "spiffe-oidc-discovery-provider.config.additionalDomains[%d]=%s" % (
            _STATIC_ADDITIONAL_DOMAIN_COUNT + _i, _domain),
    ]

