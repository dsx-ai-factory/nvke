#!ipxe
# For ARM, we're image_urlsing the qcow-imager.efi provided by BMC, not building a custom efi
set boot-loader ${base-url}/internal/aarch64/qcow-imager.efi
set image-url https://d3mq564cn7sth7.cloudfront.net/nke-isos/qcow/images/24.04/aarch64/lvm/2026-02-25/1772049022/nke-24.04-aarch64-lvm-2026-02-25-1772049022.qcow2
set target-disk /dev/nvme0n1

# You probably don't need to change these
set console-config console=ttyAMA0,115200
set kernel-params pci=realloc=off reboot=pci loglevel=1 iommu=off
set luks-key luks.key=changeit
set cloud-init-ds ds=nocloud-net;s=${cloudinit-url}

chain ${boot-loader} ${console-config} ${kernel-params} ${luks-key} image_url=${image-url} image_disk=${target-disk} ${cloud-init-ds} update_grub_template=yes update_grub_cfg=yes
boot
