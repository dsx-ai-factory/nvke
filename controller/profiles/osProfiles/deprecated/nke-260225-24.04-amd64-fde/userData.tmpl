#cloud-config
hostname: {{ .Hostname }}
preserve_hostname: false
manage_etc_hosts: true
ssh_pwauth: true
package_update: true
package_upgrade: false

write_files:
  - path: /etc/sysctl.d/k8s.conf
    owner: root:root
    permissions: '0644'
    content: |
      # K8s Requirements
      net.bridge.bridge-nf-call-iptables  = 1
      net.bridge.bridge-nf-call-ip6tables = 1
      net.ipv4.ip_forward                 = 1

      # Custom IPv6 Disabling
      net.ipv6.conf.all.disable_ipv6 = 1
      net.ipv6.conf.default.disable_ipv6 = 1
      net.ipv6.conf.lo.disable_ipv6 = 1
  - path: /etc/modules-load.d/k8s.conf
    owner: root:root
    permissions: '0644'
    content: |
      overlay
      br_netfilter
{{- if .TeleportEnabled }}
  - path: /etc/teleport.yaml
    owner: root:root
    permissions: '0600'
    content: |
      # Managed by NKE Cloud Workflow Engine — do not edit manually.
      version: v3
      teleport:
        nodename: {{ .Hostname }}
        data_dir: /var/lib/teleport
        join_params:
          token_name: {{ .TeleportTokenName }}
          method: {{ .TeleportJoinMethod }}
        proxy_server: {{ .TeleportProxyAddress }}
        log:
          output: stderr
          severity: INFO
          format:
            output: json
        diag_addr: 127.0.0.1:3000
      ssh_service:
        enabled: "yes"
        labels:
{{ indent 10 .TeleportLabels }}
      auth_service:
        enabled: "no"
      proxy_service:
        enabled: "no"
{{- end }}
{{- if .SpiffeEnabled }}
  - path: /etc/spire-agent/agent.conf
    owner: root:root
    permissions: '0644'
    content: |
      agent {
          data_dir = "/var/lib/spire-agent"
          log_level = "DEBUG"

          server_address = "{{ .SpireServerAddress }}"
          server_port = "{{ .SpireServerPort }}"

          trust_domain = "{{ .TrustDomain }}"
          trust_bundle_path = "/etc/spire-agent/initial-trust-bundle.pem"
      }

      plugins {
          KeyManager "disk" {
              plugin_data {
                  directory = "/var/lib/spire-agent"
              }
          }

          NodeAttestor "tpm" {
              plugin_cmd = "/usr/local/lib/spire-agent/tpm_attestor_agent"
              plugin_checksum = "202de8a53d52ef62107161c0ab6c85ef4c2c8cb00a60a600a19dfddb6a072db8"
              plugin_data {}
          }

          WorkloadAttestor "unix" {
              plugin_data {}
          }
      }
  - path: /etc/spire-agent/initial-trust-bundle.pem
    owner: root:root
    permissions: '0644'
    content: |
{{ indent 6 .TrustBundle }}
{{- end }}

runcmd:
{{- if .TeleportEnabled }}
  - [sh, -c, "echo 'Starting Teleport installation at '$(date) >> /var/log/cloud-init-teleport.log"]
  - /usr/local/bin/fetch-and-install-bundle.sh https://d3mq564cn7sth7.cloudfront.net/nke_bundles/Ubuntu_24.04/x86_64/teleport_ent_v18.6.4_x86_64.tgz ./install.sh
  - [sh, -c, "command -v teleport || { echo 'Teleport binary not found' >> /var/log/cloud-init-teleport.log; exit 1; }"]
  - [sh, -c, "systemctl enable --now teleport >> /var/log/cloud-init-teleport.log 2>&1"]
  - [sh, -c, "systemctl is-active --quiet teleport && echo 'Teleport service started successfully' >> /var/log/cloud-init-teleport.log || { echo 'Teleport service failed to start' >> /var/log/cloud-init-teleport.log; systemctl status teleport --no-pager >> /var/log/cloud-init-teleport.log; exit 1; }"]
  - [sh, -c, "echo 'Teleport installation completed at '$(date) >> /var/log/cloud-init-teleport.log"]
{{- end }}
  - /usr/local/bin/fetch-and-install-bundle.sh https://d3mq564cn7sth7.cloudfront.net/nke_bundles/Ubuntu_24.04/x86_64/kubeadm_v{{ .KubernetesVersion }}_x86_64.tgz ./kubeadm-install.py
  - DEBIAN_FRONTEND=noninteractive apt --fix-broken install -y
  - /usr/local/bin/fetch-and-install-bundle.sh https://d3mq564cn7sth7.cloudfront.net/nke_bundles/Ubuntu_24.04/x86_64/ovn_1.4.0_x86_64.tgz ./install.sh -i
{{- if .SpiffeEnabled }}
  - systemctl disable --now nke-attestation
  - /usr/local/bin/fetch-and-install-bundle.sh https://d3mq564cn7sth7.cloudfront.net/nke_bundles/Ubuntu_24.04/x86_64/spire_agent_v1.14.1_tpm_attestor_v1.9.0_x86_64.tgz ./install.sh
  - printf 'AGENT_ARGS="--enable-spiffe --secure-server-port {{ .NodeAgentPort }}"\n' > /etc/default/nke-agent
{{- else }}
  - echo SERVER=REPLACED-BY-SWE >> /etc/dgx/attestation/vars
  - echo "SAN_IP=$(hostname -I | cut -d' ' -f1)" >> /etc/dgx/attestation/vars
{{- end }}
  - sysctl --system
  - systemctl daemon-reload
  - systemctl restart nke-agent.service
  - systemctl restart procps

phone_home:
    POST: all
    url: http://169.254.169.254:7777/latest/meta-data/phone_home
