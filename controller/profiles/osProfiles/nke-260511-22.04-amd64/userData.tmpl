#cloud-config
autoinstall:
  version: 1
  storage:
      selection:
        smallest_disk:
          search_criteria:
            type: disk
            removable: false
          sort: size
          reverse: false
      layout:
        name: lvm
        match:
          id: smallest_disk

  identity:
    hostname: {{ .Hostname }}
    username: {{ .Username }}
    password: {{ .HashedPassword }}
  packages:
    - chrony
  ntp:
    enabled: true
    ntp_client: chrony
    servers:
      - 129.6.15.32
  keyboard:
    layout: us
    toggle: null
    variant: ""
  locale: en_US
  ssh:
    allow-pw: true
    authorized-keys: []
    install-server: true

  late-commands:
    - curtin in-target --target=/target -- sed -i 's|^GRUB_CMDLINE_LINUX=.*|GRUB_CMDLINE_LINUX="ipv6.disable=1 console=ttyS1,115200"|' /etc/default/grub
    - curtin in-target --target=/target -- update-grub

  user-data:
    write_files:
      - path: /etc/sysctl.d/60-custom.conf
        owner: root:root
        permissions: '0755'
        content: |
          net.ipv6.conf.all.disable_ipv6 = 1
          net.ipv6.conf.default.disable_ipv6 = 1
          net.ipv6.conf.lo.disable_ipv6 = 1
{{- if .TeleportEnabled }}
      - path: /etc/teleport.yaml
        owner: root:root
        permissions: '0600'
        content: |
          # Managed by NKE Cloud Workflow Engine — do not edit manually.
          version: v3
          teleport:
            nodename: {{ .Hostname }}
            data_dir: /var/lib/teleport
            join_params:
              token_name: {{ .TeleportTokenName }}
              method: {{ .TeleportJoinMethod }}
            proxy_server: {{ .TeleportProxyAddress }}
            log:
              output: stderr
              severity: INFO
              format:
                output: json
            diag_addr: 127.0.0.1:3000
          ssh_service:
            enabled: "yes"
            labels:
{{ indent 14 .TeleportLabels }}
          auth_service:
            enabled: "no"
          proxy_service:
            enabled: "no"
{{- end }}
{{- if .SpiffeEnabled }}
      - path: /etc/spire-agent/agent.conf
        owner: root:root
        permissions: '0644'
        content: |
          agent {
              data_dir = "/var/lib/spire-agent"
              log_level = "DEBUG"

              server_address = "{{ .SpireServerAddress }}"
              server_port = "{{ .SpireServerPort }}"

              trust_domain = "{{ .TrustDomain }}"
              trust_bundle_path = "/etc/spire-agent/initial-trust-bundle.pem"
          }

          plugins {
              KeyManager "disk" {
                  plugin_data {
                      directory = "/var/lib/spire-agent"
                  }
              }

              NodeAttestor "tpm" {
                  plugin_cmd = "/usr/local/lib/spire-agent/tpm_attestor_agent"
                  plugin_checksum = "${TPM_PLUGIN_CHECKSUM}"
                  plugin_data {}
              }

              WorkloadAttestor "unix" {
                  plugin_data {}
              }
          }
      - path: /etc/spire-agent/initial-trust-bundle.pem
        owner: root:root
        permissions: '0644'
        content: |
{{ indent 10 .TrustBundle }}
{{- end }}

    runcmd:
      # Wait (up to 300s) for default IPv4 route to avoid early network race (bluefield DPU Race Condition).
      - |
          timeout 300s sh -c '
            iface=""
            until [ -n "$iface" ] && ip -4 -o addr show dev "$iface" | grep -q "inet "; do
              iface=$(ip -4 route list default 2>/dev/null | head -n 1 | tr -s " " | cut -d" " -f5)
              echo "waiting for IPv4 default route"
              sleep 5
            done
            echo "IPv4 detected on $iface"
          '
      - lvextend -l +100%FREE /dev/ubuntu-vg/ubuntu-lv
      - resize2fs /dev/ubuntu-vg/ubuntu-lv
      - mkdir -m 755 /etc/apt/keyrings
      - sysctl --system
{{- if .TeleportEnabled }}
      - [sh, -c, "echo 'Starting Teleport installation at '$(date) >> /var/log/cloud-init-teleport.log"]
      - /usr/local/bin/fetch-and-install-bundle.sh https://d3mq564cn7sth7.cloudfront.net/nke_bundles/Ubuntu_22.04/x86_64/teleport_ent_v18.6.4-2_x86_64.tgz ./install.sh
      - [sh, -c, "command -v teleport || { echo 'Teleport binary not found' >> /var/log/cloud-init-teleport.log; exit 1; }"]
      - [sh, -c, "systemctl enable --now teleport >> /var/log/cloud-init-teleport.log 2>&1"]
      - [sh, -c, "systemctl is-active --quiet teleport && echo 'Teleport service started successfully' >> /var/log/cloud-init-teleport.log || { echo 'Teleport service failed to start' >> /var/log/cloud-init-teleport.log; systemctl status teleport --no-pager >> /var/log/cloud-init-teleport.log; exit 1; }"]
      - [sh, -c, "echo 'Teleport installation completed at '$(date) >> /var/log/cloud-init-teleport.log"]
{{- end }}
      - /usr/local/bin/fetch-and-install-bundle.sh https://d3mq564cn7sth7.cloudfront.net/nke_bundles/Ubuntu_22.04/x86_64/kubeadm_v{{ .KubernetesVersion }}-5_x86_64.tgz ./kubeadm-install.py
      - /usr/local/bin/fetch-and-install-bundle.sh https://d3mq564cn7sth7.cloudfront.net/nke_bundles/Ubuntu_22.04/x86_64/node-agent_v0.1.7_x86_64.tgz ./agent-installer.sh
{{- if .CalicoEnabled }}
      - [bash, -c, "/usr/local/bin/fetch-and-install-bundle.sh https://d3mq564cn7sth7.cloudfront.net/nke_bundles/Ubuntu_22.04/x86_64/calico_v3.30.1-1_x86_64.tgz ./calico-image-import.py"]
{{- end }}
{{- if .OvnEnabled }}
      - [ /usr/local/bin/fetch-and-install-bundle.sh, "https://d3mq564cn7sth7.cloudfront.net/nke_bundles/Ubuntu_22.04/x86_64/ovn_1.4.0-2_x86_64.tgz", "./install.sh -i" ]
{{- end }}
{{- if .SpiffeEnabled }}
      - /usr/local/bin/fetch-and-install-bundle.sh https://d3mq564cn7sth7.cloudfront.net/nke_bundles/Ubuntu_22.04/x86_64/spire_agent_v1.14.1_tpm_attestor_v1.9.0_x86_64.tgz ./install.sh
      - printf 'AGENT_ARGS="--enable-spiffe --secure-server-port {{ .NodeAgentPort }}"\n' > /etc/default/nke-agent
{{- end }}
      - systemctl daemon-reload
      - systemctl restart nke-agent
      - systemctl restart procps
