#cloud-config
autoinstall:
  version: 1
  early-commands:
      - |
        TARGET_DISK=""
        CANDIDATES=""
        for disk in /dev/sd* /dev/nvme*; do
          if [ -b "$disk" ]; then
            # NO removable devices
            if [ -f "/sys/block/${disk##*/}/removable" ] && [ "$(cat /sys/block/${disk##*/}/removable)" = "1" ]; then
              continue
            fi
            DISK_SIZE_BYTES=$(blockdev --getsize64 "$disk")
            DISK_SIZE_GB=$((DISK_SIZE_BYTES / 1024 / 1024 / 1024))
            if [ "$DISK_SIZE_GB" -gt 100 ]; then
              CANDIDATES="${CANDIDATES}${CANDIDATES:+ }$disk:$DISK_SIZE_GB"
            fi
          fi
        done

        # Select the smallest
        if [ -n "$CANDIDATES" ]; then
          TARGET_DISK=$(echo "$CANDIDATES" | tr ' ' '\n' | sort -t: -k2,2n | head -n1 | cut -d: -f1)
        else
          # If that didnt work, pick any non-removable disk randomly
          ALL_DISKS=""
          for disk in /dev/sd* /dev/nvme*; do
            if [ -b "$disk" ]; then
              if [ -f "/sys/block/${disk##*/}/removable" ] && [ "$(cat /sys/block/${disk##*/}/removable)" = "1" ]; then
                continue
              fi
              ALL_DISKS="${ALL_DISKS}${ALL_DISKS:+ }$disk"
            fi
          done

          if [ -z "$ALL_DISKS" ]; then
            # Awww nuts!
            echo "No suitable disk found for installation." >&2
            exit 1
          fi

          TARGET_DISK=$(echo "$ALL_DISKS" | tr ' ' '\n' | shuf -n1)
          echo "Warning: No disk >100GB found. Selecting disk randomly: $TARGET_DISK"
        fi

        # Replace placeholder in storage config
        sed -i "s|path: /dev/target_disk_placeholder|path: ${TARGET_DISK}|" /autoinstall.yaml

  storage:
      layout:
          name: lvm
          match:
              path: /dev/target_disk_placeholder

  identity:
    hostname: {{ .Hostname }}
    username: {{ .Username }}
    password: {{ .HashedPassword }}
  packages:
    - chrony
  ntp:
    enabled: true
    ntp_client: chrony
    servers:
      - 129.6.15.32
  keyboard:
    layout: us
    toggle: null
    variant: ""
  locale: en_US
  ssh:
    allow-pw: true
    authorized-keys: []
    install-server: true

  late-commands:
    - curtin in-target --target=/target -- sed -i 's|^GRUB_CMDLINE_LINUX=.*|GRUB_CMDLINE_LINUX="ipv6.disable=1 console=ttyS1,115200"|' /etc/default/grub
    - curtin in-target --target=/target -- update-grub

  user-data:
    write_files:
      - path: /etc/sysctl.d/60-custom.conf
        owner: root:root
        permissions: '0755'
        content: |
          net.ipv6.conf.all.disable_ipv6 = 1
          net.ipv6.conf.default.disable_ipv6 = 1
          net.ipv6.conf.lo.disable_ipv6 = 1
{{- if .SpiffeEnabled }}
      - path: /etc/spire-agent/agent.conf
        owner: root:root
        permissions: '0644'
        content: |
          agent {
              data_dir = "/var/lib/spire-agent"
              log_level = "DEBUG"

              server_address = "{{ .SpireServerAddress }}"
              server_port = "{{ .SpireServerPort }}"

              trust_domain = "{{ .TrustDomain }}"
              trust_bundle_path = "/etc/spire-agent/initial-trust-bundle.pem"
          }

          plugins {
              KeyManager "disk" {
                  plugin_data {
                      directory = "/var/lib/spire-agent"
                  }
              }

              NodeAttestor "tpm" {
                  plugin_cmd = "/usr/local/lib/spire-agent/tpm_attestor_agent"
                  plugin_checksum = "${TPM_PLUGIN_CHECKSUM}"
                  plugin_data {}
              }

              WorkloadAttestor "unix" {
                  plugin_data {}
              }
          }
      - path: /etc/spire-agent/initial-trust-bundle.pem
        owner: root:root
        permissions: '0644'
        content: |
{{ indent 10 .TrustBundle }}
{{- end }}

    runcmd:
      - [sh, -c, "lvextend -l +100%FREE /dev/ubuntu-vg/ubuntu-lv"]
      - [sh, -c, "resize2fs /dev/mapper/ubuntu-vg-ubuntu-lv"]
      - [sh, -c, "mkdir -m 755 /etc/apt/keyrings"]
      - [sh, -c, "systemctl restart nke-agent"]
      - [sh, -c, "sysctl -p"]
      - [bash, -c, "/usr/local/bin/fetch-and-install-bundle.sh  https://d3mq564cn7sth7.cloudfront.net/nke_bundles/Ubuntu_24.04/x86_64/kubeadm_v1.34.2_x86_64.tgz ./kubeadm-install.py"]
      - [bash, -c, "/usr/local/bin/fetch-and-install-bundle.sh  https://nke-dev.s3.us-west-2.amazonaws.com/nke_bundles/Ubuntu_24.04/x86_64/node-agent_v0.1.7_x86_64.tgz ./agent-installer.sh"]
{{- if .SpiffeEnabled }}
      - [bash, -c, "/usr/local/bin/fetch-and-install-bundle.sh https://d3mq564cn7sth7.cloudfront.net/nke_bundles/Ubuntu_24.04/x86_64/spire_agent_v1.14.1_tpm_attestor_v1.9.0_x86_64.tgz ./install.sh"]
      - printf 'AGENT_ARGS="--enable-spiffe --secure-server-port {{ .NodeAgentPort }}"\n' > /etc/default/nke-agent
{{- else }}
      - sed -i '/^ExecStart=/ s|\bnke-agent\b|nke-agent -disable-mtls -bundle-server-url https://d3mq564cn7sth7.cloudfront.net/|' /etc/systemd/system/nke-agent.service
{{- end }}
      - systemctl daemon-reload
      - systemctl restart nke-agent.service
      - [sh, -c, "systemctl restart procps"]
