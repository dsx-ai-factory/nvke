# Rendered by /usr/lib/nke/spire-configure.sh. Placeholders are @NAME@ so the
# image never ships a live server address or trust domain.

agent {
  data_dir = "/var/lib/spire-agent"
  log_level = "INFO"
  server_address = "@SPIRE_SERVER_ADDRESS@"
  server_port = "@SPIRE_SERVER_PORT@"
  socket_path = "/tmp/spire-agent/public/api.sock"
  trust_domain = "@SPIRE_TRUST_DOMAIN@"
  trust_bundle_path = "/etc/spire-agent/trust-bundle.pem"
}

plugins {
  NodeAttestor "join_token" {
    plugin_data {}
  }
  KeyManager "disk" {
    plugin_data {
      directory = "/var/lib/spire-agent/keys"
    }
  }
  WorkloadAttestor "unix" {
    plugin_data {}
  }
}
