{
  "uid": "nktp-large-target-metrics",
  "title": "NKTP Large-target Metrics",
  "description": "A separate Collector pool for metrics endpoints with large scrape responses, such as kube-state-metrics. It scrapes ServiceMonitor, PodMonitor, Probe, and ScrapeConfig resources explicitly labeled nktp.nvidia.io/large-target=true; NKTP does not classify targets by size automatically. A Target Allocator spreads those scrapes across the Collectors. Collected metrics go to the NKTP metrics gateway, while the Collectors' own diagnostic telemetry goes to Watchdog. Panels show metric flow, queue use, scrape sample counts, and target assignments; sample counts do not measure response bytes or delivery to storage.",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Received metrics /s",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-large-target-metrics\"}[5m]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Exported metrics /s",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(otelcol_exporter_sent_metric_points_total{job=\"nktp-large-target-metrics\"}[5m]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Export failures /s",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(otelcol_exporter_send_failed_metric_points_total{job=\"nktp-large-target-metrics\"}[5m]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Refused metrics /s",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(otelcol_receiver_refused_metric_points_total{job=\"nktp-large-target-metrics\"}[5m]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Exporter queue use",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "targets": [
        {
          "expr": "100 * sum by (instance, exporter) (otelcol_exporter_queue_size{job=\"nktp-large-target-metrics\",data_type=\"metrics\"}) / sum by (instance, exporter) (otelcol_exporter_queue_capacity{job=\"nktp-large-target-metrics\",data_type=\"metrics\"})",
          "legendFormat": "{{instance}} {{exporter}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU cores",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(otelcol_process_cpu_seconds_total{job=\"nktp-large-target-metrics\"}[5m]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Memory (RSS)",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "sum by (instance) (otelcol_process_memory_rss_bytes{job=\"nktp-large-target-metrics\"})",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "histogram",
      "title": "Samples per scrape",
      "description": "Latest sample count per target before metric filtering. Sample count indicates scrape work. It does not measure response bytes or memory use.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        }
      },
      "options": {
        "combine": true,
        "bucketCount": 20
      },
      "targets": [
        {
          "expr": "max by (job, instance) (scrape_samples_scraped{nktp_metrics_pool=\"large-target\",job!=\"nktp-large-target-metrics-targetallocator\"})",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Value"
              ]
            }
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Target Allocator collectors",
      "description": "Discovered and allocatable large-target Collectors reported by each Target Allocator replica. A discovered Collector may not yet be allocatable; replica reports are shown separately.",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "opentelemetry_allocator_collectors_discovered{job=\"nktp-large-target-metrics-targetallocator\"}",
          "legendFormat": "{{instance}} discovered",
          "refId": "A"
        },
        {
          "expr": "opentelemetry_allocator_collectors_allocatable{job=\"nktp-large-target-metrics-targetallocator\"}",
          "legendFormat": "{{instance}} allocatable",
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Targets per collector",
      "description": "Targets assigned to each large-target Collector by the Target Allocator. This is an assignment count, not a count of successful scrapes. Multiple allocator replicas may report the same assignments.",
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "opentelemetry_allocator_targets_per_collector{job=\"nktp-large-target-metrics-targetallocator\"}",
          "legendFormat": "{{collector_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Target Allocator CPU cores",
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "cores"
        }
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"nktp-large-target-metrics-targetallocator\"}[5m])",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Target Allocator memory (RSS)",
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"nktp-large-target-metrics-targetallocator\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "table",
      "title": "Largest targets by sample count",
      "description": "The 20 targets with the largest latest sample counts, with scrape duration matched by job and instance.",
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Samples"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Scrape duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Samples",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "expr": "topk(20, max by (job, instance) (scrape_samples_scraped{nktp_metrics_pool=\"large-target\",job!=\"nktp-large-target-metrics-targetallocator\"}))",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "max by (job, instance) (scrape_duration_seconds{nktp_metrics_pool=\"large-target\",job!=\"nktp-large-target-metrics-targetallocator\"}) and on (job, instance) topk(20, max by (job, instance) (scrape_samples_scraped{nktp_metrics_pool=\"large-target\",job!=\"nktp-large-target-metrics-targetallocator\"}))",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "job": 0,
              "instance": 1,
              "Value #A": 2,
              "Value #B": 3
            },
            "renameByName": {
              "job": "Job",
              "instance": "Instance",
              "Value #A": "Samples",
              "Value #B": "Scrape duration"
            }
          }
        }
      ]
    }
  ]
}
