    {
      "id": 19,
      "type": "table",
      "title": "KSM central shard coverage",
      "description": "Each central KSM resource group has its own shard set. Configured comes from the total_shards metric reported by KSM; it is not a Kubernetes desired replica count. Reporting counts distinct shard ordinals with a successful telemetry scrape, so duplicate replicas do not increase coverage. Missing is configured minus reporting. Missing telemetry stays Unknown; workload readiness remains the independent check when a whole group disappears. Scrape coverage does not prove Kubernetes objects are current.",
      "gridPos": {
        "x": 0,
        "y": 79,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "label_replace((max by (job) (kube_state_metrics_total_shards{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"})), \"target\", \"$1\", \"job\", \"(.+)\")",
          "refId": "A",
          "instant": true,
          "range": false,
          "interval": "1m",
          "legendFormat": "",
          "format": "table"
        },
        {
          "expr": "label_replace(((count by (job) (count by (job, shard_ordinal) (kube_state_metrics_shard_ordinal{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"} and on (job, instance) (up{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"} == 1)))) or (0 * (count by (job) (up{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"})))), \"target\", \"$1\", \"job\", \"(.+)\")",
          "refId": "B",
          "instant": true,
          "range": false,
          "interval": "1m",
          "legendFormat": "",
          "format": "table"
        },
        {
          "expr": "label_replace((clamp_min((max by (job) (kube_state_metrics_total_shards{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"})) - ((count by (job) (count by (job, shard_ordinal) (kube_state_metrics_shard_ordinal{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"} and on (job, instance) (up{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"} == 1)))) or (0 * (count by (job) (up{job=~\"$namespace/nktp-ksm-.*\",job!=\"$namespace/nktp-ksm-pods\",namespace=\"$namespace\",endpoint=\"telemetry\"})))), 0)), \"target\", \"$1\", \"job\", \"(.+)\")",
          "refId": "C",
          "instant": true,
          "range": false,
          "interval": "1m",
          "legendFormat": "",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "#8e8e8e"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Target"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              },
              {
                "id": "custom.width",
                "value": 650
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Configured"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Reporting"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Missing"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Target",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "target",
            "mode": "outerTabular"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "job": true,
              "job 1": true,
              "job 2": true
            },
            "indexByName": {
              "target": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            },
            "renameByName": {
              "target": "Target",
              "Value #A": "Configured",
              "Value #B": "Reporting",
              "Value #C": "Missing"
            }
          }
        }
      ]
