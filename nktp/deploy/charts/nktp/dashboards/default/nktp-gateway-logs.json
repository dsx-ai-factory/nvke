{
  "uid": "nktp-gateway-logs",
  "title": "NKTP Logs Gateway",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Received logs /s",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0 } },
      "targets": [
        { "expr": "sum(rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-gateway-logs\"}[5m]))", "legendFormat": "log records", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Exported logs /s",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0 } },
      "targets": [
        { "expr": "sum(rate(otelcol_exporter_sent_log_records_total{job=\"nktp-gateway-logs\"}[5m]))", "legendFormat": "log records", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Export failures /s",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0 } },
      "targets": [
        { "expr": "sum(rate(otelcol_exporter_send_failed_log_records_total{job=\"nktp-gateway-logs\"}[5m]))", "legendFormat": "log records", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Refused logs /s",
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0 } },
      "targets": [
        { "expr": "sum(rate(otelcol_receiver_refused_log_records_total{job=\"nktp-gateway-logs\"}[5m]))", "legendFormat": "log records", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Exporter queue use",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [
        { "expr": "100 * sum by (exporter) (otelcol_exporter_queue_size{job=\"nktp-gateway-logs\",data_type=\"logs\"}) / sum by (exporter) (otelcol_exporter_queue_capacity{job=\"nktp-gateway-logs\",data_type=\"logs\"})", "legendFormat": "{{exporter}}", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU cores",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cores", "min": 0 } },
      "targets": [
        { "expr": "sum(rate(otelcol_process_cpu_seconds_total{job=\"nktp-gateway-logs\"}[5m]))", "legendFormat": "CPU cores", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Memory (RSS)",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 } },
      "targets": [
        { "expr": "sum(otelcol_process_memory_rss_bytes{job=\"nktp-gateway-logs\"})", "legendFormat": "RSS", "refId": "A" }
      ]
    }
  ]
}
