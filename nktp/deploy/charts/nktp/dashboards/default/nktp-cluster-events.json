{
  "uid": "nktp-cluster-events",
  "title": "NKTP Cluster Events",
  "tags": [
    "nktp",
    "nktp-collector",
    "opentelemetry"
  ],
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "title": "Collectors",
      "type": "dashboards",
      "tags": [
        "nktp-collector"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "NKTP Health",
      "type": "link",
      "url": "/d/nktp-health",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Pipeline",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Received /s",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-cluster-events\"}[5m]))",
          "legendFormat": "log records",
          "refId": "A"
        }
      ],
      "description": "Items received per second across all replicas."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Exported /s",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_exporter_sent_log_records_total{job=\"nktp-cluster-events\"}[5m]))",
          "legendFormat": "log records",
          "refId": "A"
        }
      ],
      "description": "Items exported per second across all replicas."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Export failures /s",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_exporter_send_failed_log_records_total{job=\"nktp-cluster-events\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-cluster-events\",data_type=\"logs\"})",
          "legendFormat": "log records",
          "refId": "A"
        }
      ],
      "description": "Items that failed to send, across all replicas. The exporter may retry them."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Refused /s",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_receiver_refused_log_records_total{job=\"nktp-cluster-events\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-cluster-events\"}[5m]))",
          "legendFormat": "log records",
          "refId": "A"
        }
      ],
      "description": "Items the receivers refused across all replicas, for example under memory pressure."
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Received /s by replica · top 20",
      "description": "The 20 replicas that received the most at the end of the range, to show imbalance.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "(sum by (instance) (rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-cluster-events\"}[5m]))) and on (instance) topk(20, sum by (instance) (rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-cluster-events\"}[5m] @ end())))",
          "legendFormat": "{{instance}} log records",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Leader election",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Leadership changes",
      "description": "Receiver leadership transitions in the selected time range. The latest message is not a live Lease status check.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{service_name=\"nktp-cluster-events\"} |~ \"Events Receiver started as leader|no longer leader, stopping\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Queues and resources",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Exporter queue use · top 20",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "percent"
        }
      },
      "targets": [
        {
          "expr": "100 * (max by (instance, exporter, data_type) (otelcol_exporter_queue_size{job=\"nktp-cluster-events\"} / otelcol_exporter_queue_capacity{job=\"nktp-cluster-events\"})) and on (instance, exporter, data_type) topk(20, max by (instance, exporter, data_type) (otelcol_exporter_queue_size{job=\"nktp-cluster-events\"} @ end() / otelcol_exporter_queue_capacity{job=\"nktp-cluster-events\"} @ end()))",
          "legendFormat": "{{instance}} {{exporter}} {{data_type}}",
          "refId": "A"
        }
      ],
      "description": "The 20 fullest exporter queues at the end of the range."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "CPU cores · top 20",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "cores"
        }
      },
      "targets": [
        {
          "expr": "(sum by (instance) (rate(otelcol_process_cpu_seconds_total{job=\"nktp-cluster-events\"}[5m]))) and on (instance) topk(20, sum by (instance) (rate(otelcol_process_cpu_seconds_total{job=\"nktp-cluster-events\"}[5m] @ end())))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Memory (RSS) · top 20",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "(sum by (instance) (otelcol_process_memory_rss_bytes{job=\"nktp-cluster-events\"})) and on (instance) topk(20, sum by (instance) (otelcol_process_memory_rss_bytes{job=\"nktp-cluster-events\"} @ end()))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Reporting replicas",
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "count(count by (instance) (otelcol_process_memory_rss_bytes{job=\"nktp-cluster-events\"}))",
          "legendFormat": "reporting",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "Self-telemetry sidecar",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 54,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Sidecar queue use",
      "description": "Fullest sidecar export queue of any Pod, per signal. The sidecar buffers this Collector's internal telemetry while the watchdog is unavailable.",
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "percent"
        }
      },
      "targets": [
        {
          "expr": "100 * max by (data_type) (otelcol_exporter_queue_size{job=\"nktp-cluster-events-sidecar\"} / otelcol_exporter_queue_capacity{job=\"nktp-cluster-events-sidecar\"})",
          "legendFormat": "{{data_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Sidecar export failures /s",
      "description": "Internal telemetry that the sidecar failed to send to the watchdog, per signal.",
      "gridPos": {
        "x": 12,
        "y": 55,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_exporter_send_failed_metric_points_total{job=\"nktp-cluster-events-sidecar\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-cluster-events-sidecar\",data_type=\"metrics\"})",
          "legendFormat": "metrics",
          "refId": "A"
        },
        {
          "expr": "sum(rate(otelcol_exporter_send_failed_log_records_total{job=\"nktp-cluster-events-sidecar\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-cluster-events-sidecar\",data_type=\"logs\"})",
          "legendFormat": "logs",
          "refId": "B"
        },
        {
          "expr": "sum(rate(otelcol_exporter_send_failed_spans_total{job=\"nktp-cluster-events-sidecar\"}[5m])) or 0 * sum(otelcol_exporter_queue_capacity{job=\"nktp-cluster-events-sidecar\",data_type=\"traces\"})",
          "legendFormat": "traces",
          "refId": "C"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Sidecar refused /s",
      "description": "Internal telemetry that the sidecar refused, per signal, for example under memory pressure.",
      "gridPos": {
        "x": 0,
        "y": 62,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_receiver_refused_metric_points_total{job=\"nktp-cluster-events-sidecar\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_metric_points_total{job=\"nktp-cluster-events-sidecar\"}[5m]))",
          "legendFormat": "metrics",
          "refId": "A"
        },
        {
          "expr": "sum(rate(otelcol_receiver_refused_log_records_total{job=\"nktp-cluster-events-sidecar\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_log_records_total{job=\"nktp-cluster-events-sidecar\"}[5m]))",
          "legendFormat": "logs",
          "refId": "B"
        },
        {
          "expr": "sum(rate(otelcol_receiver_refused_spans_total{job=\"nktp-cluster-events-sidecar\"}[5m])) or 0 * sum(rate(otelcol_receiver_accepted_spans_total{job=\"nktp-cluster-events-sidecar\"}[5m]))",
          "legendFormat": "traces",
          "refId": "C"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Sidecar traces kept and dropped /s",
      "description": "Tail sampling decisions. A trace is kept when a span has an error or lasts longer than 1 second.",
      "gridPos": {
        "x": 12,
        "y": 62,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total{job=\"nktp-cluster-events-sidecar\",sampled=\"true\"}[5m])) or 0 * sum(rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total{job=\"nktp-cluster-events-sidecar\",sampled=\"false\"}[5m]))",
          "legendFormat": "kept",
          "refId": "A"
        },
        {
          "expr": "sum(rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total{job=\"nktp-cluster-events-sidecar\",sampled=\"false\"}[5m]))",
          "legendFormat": "dropped",
          "refId": "B"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Sidecar CPU cores, highest Pod",
      "gridPos": {
        "x": 0,
        "y": 69,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "cores"
        }
      },
      "targets": [
        {
          "expr": "max(rate(otelcol_process_cpu_seconds_total{job=\"nktp-cluster-events-sidecar\"}[5m]))",
          "legendFormat": "highest Pod",
          "refId": "A"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Sidecar memory (RSS), highest Pod",
      "gridPos": {
        "x": 12,
        "y": 69,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "max(otelcol_process_memory_rss_bytes{job=\"nktp-cluster-events-sidecar\"})",
          "legendFormat": "highest Pod",
          "refId": "A"
        }
      ],
      "description": "Memory of the sidecar that uses the most. Compare it with the sidecar's memory limit."
    }
  ]
}
