              ]
            }
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        }
      },
      {
        "id": 5,
        "type": "stat",
        "title": "Unavailable DaemonSet pods",
        "description": "",
        "gridPos": {
          "x": 18,
          "y": 14,
          "w": 6,
          "h": 6
