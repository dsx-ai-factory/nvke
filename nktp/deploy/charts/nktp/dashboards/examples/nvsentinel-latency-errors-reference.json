          "textMode": "auto"
        }
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "Erroring pods",
        "description": "Containers currently reporting a waiting reason.",
        "gridPos": {
          "x": 0,
          "y": 20,
          "w": 24,
          "h": 8
