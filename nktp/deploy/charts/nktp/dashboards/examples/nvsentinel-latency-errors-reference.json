        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (k8s_cluster_name) (kube_daemonset_status_number_unavailable{namespace=\"nvsentinel\",k8s_cluster_name=~\"$cluster\"})",
            "legendFormat": "{{k8s_cluster_name}}",
            "instant": true,
            "range": false
          }
