        "title": "GPU Health Monitor",
        "description": "Requires NVSentinel GPU health monitor metrics; these are distinct from standard DCGM Exporter device metrics.",
        "collapsed": false,
        "gridPos": {
          "x": 0,
          "y": 28,
          "w": 24,
          "h": 1
        },
        "panels": []
      },
      {
        "id": 8,
        "type": "timeseries",
        "title": "DCGM API latency \u2014 p95",
        "description": "",
        "gridPos": {
          "x": 0,
          "y": 29,
          "w": 12,
          "h": 8
