        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.95, sum by (k8s_cluster_name,le,operation_name) (rate(dcgm_api_latency_bucket{k8s_cluster_name=~\"$cluster\"}[$__rate_interval])))",
            "legendFormat": "{{k8s_cluster_name}} / {{operation_name}}",
            "instant": false,
            "range": true
