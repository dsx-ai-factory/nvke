        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "count by (k8s_cluster_name,reason,pod) (kube_pod_container_status_waiting_reason{namespace=\"nvsentinel\",k8s_cluster_name=~\"$cluster\"} == 1)",
            "legendFormat": "{{k8s_cluster_name}} / {{pod}} / {{reason}}",
            "instant": false,
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
