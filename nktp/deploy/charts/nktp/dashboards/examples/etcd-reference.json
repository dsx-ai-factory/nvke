      {
        "id": 5,
        "type": "timeseries",
        "title": "Disk sync duration",
        "description": "p99 WAL fsync (etcd_disk_wal_fsync_duration_seconds) and p99 backend commit (etcd_disk_backend_commit_duration_seconds).",
        "datasource": {
