            "expr": "sum(grpc_server_started_total{k8s_cluster_name=~\"$cluster\",job=\"$job\",grpc_service=\"etcdserverpb.Watch\",grpc_type=\"bidi_stream\"}) - sum(grpc_server_handled_total{k8s_cluster_name=~\"$cluster\",job=\"$job\",grpc_service=\"etcdserverpb.Watch\",grpc_type=\"bidi_stream\"})",
            "legendFormat": "Watch streams",
            "refId": "A",
            "interval": "1m"
