        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 0,
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {
                "group": "A",
                "mode": "none"
              }
            },
            "min": 0
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "calcs": [
              "lastNotNull"
            ],
            "displayMode": "list",
            "placement": "right",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "interval": "1m"
      },
      {
        "id": 4,
        "type": "timeseries",
        "title": "DB size",
        "description": "DB size is total allocated backend size on disk (etcd_mvcc_db_total_size_in_bytes). DB size in use is space used by live data (etcd_mvcc_db_total_size_in_use_in_bytes). A large gap indicates fragmentation; consider etcd defrag when the in-use ratio is low.",
