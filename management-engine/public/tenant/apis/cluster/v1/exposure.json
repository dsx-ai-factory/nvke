{
  "version": "v1",
  "defaults": [
    {"path": "apiServerAccess.publicAccessEnabled", "value": false},
    {"path": "clusterNetwork.serviceDomain", "value": "cluster.local"}
  ],
  "fields": [
    {"path": "release", "tag": 1, "access": ["create", "read", "replace"]},
    {"path": "release.channel", "tag": 1, "access": ["create", "read", "replace"]},
    {"path": "release.channel.name", "tag": 1, "access": ["create", "read", "replace"]},
    {"path": "release.channel.version", "tag": 2, "access": ["create", "read", "replace"]},
    {"path": "controlPlaneClass", "tag": 2, "access": ["create", "read", "replace"]},
    {"path": "clusterNetwork", "tag": 3, "access": ["create", "read"], "description": "ClusterNetwork describes the pod and service networks."},
    {"path": "clusterNetwork.pods", "tag": 1, "access": ["create", "read"]},
    {
      "path": "clusterNetwork.pods.cidrBlocks", "tag": 1, "access": ["create", "read"],
      "input": {
        "max_items": 1,
        "description": "Exactly one canonical IPv4 CIDR for pods. The pod and service ranges must not overlap."
      }
    },
    {"path": "clusterNetwork.services", "tag": 2, "access": ["create", "read"]},
    {
      "path": "clusterNetwork.services.cidrBlocks", "tag": 1, "access": ["create", "read"],
      "input": {
        "max_items": 1,
        "description": "Exactly one canonical IPv4 CIDR for services. The pod and service ranges must not overlap."
      }
    }
  ]
}
