# Logrotate config for nke-agent script execution log.
# Install to /etc/logrotate.d/ (e.g. as nke-execute-scripts or nke-agent).
#
# copytruncate: truncate the log in place after copying, so the running
# agent does not need to reopen the file (it keeps writing to the same inode).

/var/log/nke-execute-scripts.log {
    daily
    rotate 7
    copytruncate
    missingok
    notifempty
    compress
}
