[Unit]
Description=NKE Node Agent
Documentation=https://github.com/NVIDIA/nke/tree/main/agent
# Order-only (not Requires=); a hard dependency on containerd silently kept
# the agent from starting when containerd was still warming up.
After=containerd.service

[Service]
Type=simple
# -index-file-url short-circuits the GetOSVersion check, which would
# otherwise panic on Debian-based kindest images (Ubuntu-only).
ExecStart=/usr/local/bin/nke-agent -disable-mtls -index-file-url https://nke-dev.s3.us-west-2.amazonaws.com/nke_bundles/ubuntu_22_index.json
Restart=on-failure
RestartSec=5s
# journal+console so logs reach both `journalctl -u nke-agent` inside the
# node container and `docker logs <node>` from the host.
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
