# Admits external clients to the NVKE API. The controller chart's own
# NetworkPolicy admits the API port from pods in the cluster only, and it has
# no key for an address range. This policy adds the networks the site spec
# names: the host that runs nvkectl and the network the tenant nodes come up
# on. The port is the container port behind service.port in
# values/controller.yaml.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: nvke-api-clients
  namespace: nvke-controller
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: nvke-controller
  policyTypes:
    - Ingress
  ingress:
    - from:
        {{- range .ClientNetworks }}
        - ipBlock:
            cidr: {{ . }}
        {{- end }}
      ports:
        - port: 8080
          protocol: TCP
