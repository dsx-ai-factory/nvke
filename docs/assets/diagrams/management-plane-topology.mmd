%% Structure source for management-plane-topology.svg. Keep the two in sync.
%% Arrows point from the side that opens the connection. Dashed = optional.
%% Install step that put each part in place: (1) nvkectl bootstrap site,
%% (2) clusterctl init, (3) nvke-deploy.sh, the deploy path.
flowchart LR
    subgraph openv["Operator environment"]
        op(["Operator<br/>nvkectl, API clients"]):::actor
        idp["Identity provider<br/>issues JWTs"]:::opt
    end

    subgraph mgmt["Management cluster (1)"]
        ctl["NVKE controller (3)<br/>API, Temporal worker, reconcilers"]:::nvke
        temporal["Temporal (3)<br/>workflows"]:::tp
        pg["PostgreSQL (3)<br/>state"]:::tp
        spire["SPIRE server (3)<br/>node identity"]:::tp
        obs["NVKE observability (3)<br/>telemetry"]:::nvke
        subgraph capi[" "]
            capicore["Cluster API (2)<br/>core, kubeadm"]:::tp
            capnico["CAPNICo (3)<br/>NICo provider"]:::nvke
        end
    end

    subgraph node["Workload cluster node"]
        agent["nvke-agent<br/>gRPC, port 15005"]:::nvke
        spireagent["SPIRE agent<br/>TPM attestation"]:::tp
    end

    nico["NICo<br/>bare-metal API"]:::nv

    op --> ctl
    ctl -. fetches keys .-> idp
    ctl --> temporal
    temporal --> pg
    ctl --> pg
    ctl -- node entries --> spire
    ctl -- writes objects --> capi
    capnico --> nico
    ctl -- gRPC, SPIFFE mTLS --> agent
    spireagent --> spire
    nico -- provisions --> node

    classDef nvke fill:#76B900,stroke:#76B900,color:#000000
    classDef nv fill:#FFFFFF,stroke:#4B4B4B,color:#1A1A1A
    classDef tp fill:#E0E0E0,stroke:#E0E0E0,color:#1A1A1A
    classDef opt fill:#E0E0E0,stroke:#4B4B4B,stroke-dasharray:5 4,color:#1A1A1A
    classDef actor fill:#FFFFFF,stroke:#757575,color:#1A1A1A
