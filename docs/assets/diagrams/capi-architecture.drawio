        <mxCell id="control-plane" value="&lt;b&gt;&lt;font style=&quot;font-size: 21px;&quot; color=&quot;#18262E&quot;&gt;Control plane&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 15px;&quot; color=&quot;#52616C&quot;&gt;Provider contract&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;CAPNVKE&lt;/b&gt;&lt;br&gt;NVKEControlPlane&lt;div&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Possible variations:&lt;br&gt;&lt;/font&gt;&lt;ul style=&quot;padding-left: 15px;&quot;&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Nodes joining the workload cluster as control plane nodes&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Privately managed backing infra&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Hosted control planes&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7198B9;strokeWidth=2;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=16;fontColor=#18262E;fontStyle=0;container=0;" parent="1" vertex="1">
