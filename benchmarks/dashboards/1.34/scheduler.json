{
  "uid": "nke-benchmarks-scheduler",
  "title": "Control Plane — Scheduler",
  "description": "kube-scheduler throughput, scheduling latencies, framework extension points/plugins, binding/permit, pending/unschedulable pods, leadership and resource usage. Uses inline PromQL — no recording rules required.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "utc",
  "tags": [
    "nke",
    "nke-benchmarks",
    "control-plane",
    "scheduler"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "cluster",
        "type": "query",
        "label": "Cluster",
        "description": "Values of the k8s_cluster_name label, populated only where the datasource holds several clusters. All (.*) matches every series, including those without the label. A cluster label under any other name is not filtered.",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up, k8s_cluster_name)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "refresh": 1,
        "definition": "label_values(up, k8s_cluster_name)"
      },
      {
        "name": "quantile",
        "type": "custom",
        "label": "Quantile",
        "query": "p50 : 0.50, p90 : 0.90, p99 : 0.99",
        "hide": 0,
        "current": {
          "text": "p99",
          "value": "0.99"
        },
        "options": [
          {
            "text": "p50",
            "value": "0.50",
            "selected": false
          },
          {
            "text": "p90",
            "value": "0.90",
            "selected": false
          },
          {
            "text": "p99",
            "value": "0.99",
            "selected": true
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 103,
      "type": "text",
      "title": "Requirements and scope",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Requirements.** Prometheus scraping kube-scheduler as `job=\"kube-scheduler\"`.\n\n**Scope.** Kubernetes 1.34 metric names; use until a newer `dashboards/` directory exists. `$cluster` filters on `k8s_cluster_name` and matches everything when the label is absent, so a single-cluster Prometheus needs no relabeling. Inline PromQL; no recording rules."
      }
    },
    {
      "id": 100,
      "type": "row",
      "title": "Throughput & queues",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      }
    },
    {
      "id": 1,
      "title": "Scheduling Attempts by Result",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (profile, result) (rate(scheduler_schedule_attempts_total{k8s_cluster_name=~\"$cluster\", job=\"kube-scheduler\"}[5m]))",
          "legendFormat": "{{profile}} {{result}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Pending Pods by Queue",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (profile, queue) (scheduler_pending_pods{k8s_cluster_name=~\"$cluster\", job=\"kube-scheduler\"})",
          "legendFormat": "{{profile}} {{queue}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Preemption + Incoming Pods",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum (rate(scheduler_preemption_attempts_total{k8s_cluster_name=~\"$cluster\", job=\"kube-scheduler\"}[5m]))",
          "legendFormat": "preemption"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (queue, event) (rate(scheduler_queue_incoming_pods_total{k8s_cluster_name=~\"$cluster\", job=\"kube-scheduler\"}[5m]))",
          "legendFormat": "incoming {{queue}} {{event}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Unschedulable Pods",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (profile, queue) (scheduler_pending_pods{k8s_cluster_name=~\"$cluster\", job=\"kube-scheduler\", queue=\"unschedulable\"})",
          "legendFormat": "{{profile}}"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Latency & framework internals",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      }
    },
    {
      "id": 5,
      "title": "Scheduling Attempt Latency ${quantile:text}",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile($quantile, sum by (profile, result, le) (rate(scheduler_scheduling_attempt_duration_seconds_bucket{k8s_cluster_name=~\"$cluster\", job=\"kube-scheduler\"}[5m])))",
          "legendFormat": "{{profile}} {{result}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Algorithm Duration ${quantile:text}",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile($quantile, sum by (le) (rate(scheduler_scheduling_algorithm_duration_seconds_bucket{k8s_cluster_name=~\"$cluster\", job=\"kube-scheduler\"}[5m])))",
          "legendFormat": "algorithm"
        }
      ]
    },
    {
      "id": 7,
      "title": "Pod Scheduling SLI Duration ${quantile:text}",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile($quantile, sum by (attempts, le) (rate(scheduler_pod_scheduling_sli_duration_seconds_bucket{k8s_cluster_name=~\"$cluster\", job=\"kube-scheduler\"}[5m])))",
          "legendFormat": "attempts={{attempts}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Permit Wait Duration p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (result, le) (rate(scheduler_permit_wait_duration_seconds_bucket{k8s_cluster_name=~\"$cluster\", job=\"kube-scheduler\"}[5m])))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Framework Extension Point Duration p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (profile, extension_point, status, le) (rate(scheduler_framework_extension_point_duration_seconds_bucket{k8s_cluster_name=~\"$cluster\", job=\"kube-scheduler\"}[5m])))",
          "legendFormat": "{{profile}} {{extension_point}} {{status}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Plugin Execution Duration p99 (top10)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, histogram_quantile(0.99, sum by (extension_point, plugin, status, le) (rate(scheduler_plugin_execution_duration_seconds_bucket{k8s_cluster_name=~\"$cluster\", job=\"kube-scheduler\"}[5m]))))",
          "legendFormat": "{{extension_point}}/{{plugin}} {{status}}"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Leadership & resources",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 46
      }
    },
    {
      "id": 11,
      "title": "Leader Election Status",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 47
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Standby",
                  "color": "yellow"
                },
                "1": {
                  "text": "Leader",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "yellow",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (instance, name) (leader_election_master_status{k8s_cluster_name=~\"$cluster\", job=\"kube-scheduler\"})",
          "legendFormat": "{{instance}} {{name}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "CPU Utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 47
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (rate(process_cpu_seconds_total{k8s_cluster_name=~\"$cluster\", job=\"kube-scheduler\"}[5m]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "description": "Cores, not percent."
    },
    {
      "id": 13,
      "title": "Memory (RSS)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 47
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (process_resident_memory_bytes{k8s_cluster_name=~\"$cluster\", job=\"kube-scheduler\"})",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Goroutines / Open FDs",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 55
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (go_goroutines{k8s_cluster_name=~\"$cluster\", job=\"kube-scheduler\"})",
          "legendFormat": "goroutines {{instance}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (process_open_fds{k8s_cluster_name=~\"$cluster\", job=\"kube-scheduler\"})",
          "legendFormat": "open fds {{instance}}"
        }
      ]
    }
  ],
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  }
}
