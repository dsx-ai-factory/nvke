    {
      "id": 18,
      "title": "Run-Queue Pressure (load1 per core)",
      "type": "timeseries",
      "description": "Per core, because raw load1 is not comparable across mixed pools. < 1.0 healthy, > 2.0 sustained is saturated.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 68
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_load1{k8s_cluster_name=~\"$cluster\", job=\"node-exporter\"} / on(instance) group_left count by (instance) (count by (instance, cpu) (node_cpu_seconds_total{k8s_cluster_name=~\"$cluster\", job=\"node-exporter\"}))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
