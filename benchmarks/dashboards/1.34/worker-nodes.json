        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{k8s_cluster_name=~\"$cluster\", job=\"node-exporter\", mode=\"idle\"}[5m]))",
