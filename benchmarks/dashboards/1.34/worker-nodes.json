      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile($quantile, sum by (node, le) (rate(kubelet_pleg_relist_duration_seconds_bucket{k8s_cluster_name=~\"$cluster\", node=~\"$node\"}[2m])))",
