        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(node_pressure_memory_waiting_seconds_total{k8s_cluster_name=~\"$cluster\", job=\"node-exporter\"}[5m])",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 22,
      "title": "Conntrack Table Utilisation",
      "type": "timeseries",
      "description": "Hard cliff: when the table fills, new connections drop silently and look like random network faults. Grows with node count. Keep < 0.80.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 84
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_nf_conntrack_entries{k8s_cluster_name=~\"$cluster\", job=\"node-exporter\"} / node_nf_conntrack_entries_limit{k8s_cluster_name=~\"$cluster\", job=\"node-exporter\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 23,
      "title": "Worst Filesystem Headroom per Node",
      "type": "timeseries",
      "description": "Pseudo and boot mounts excluded, or the tiny /boot/efi partition dominates the min. Keep > 0.20 — kubelet starts evicting at 10-15% free.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 92
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "min by (instance) (node_filesystem_avail_bytes{k8s_cluster_name=~\"$cluster\", job=\"node-exporter\", fstype!~\"tmpfs|vfat\"} / node_filesystem_size_bytes{k8s_cluster_name=~\"$cluster\", job=\"node-exporter\", fstype!~\"tmpfs|vfat\"})",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 24,
      "title": "Disk I/O Saturation",
      "type": "timeseries",
      "description": "Fraction of time the device had I/O in flight; keep < 0.90. On control-plane nodes, etcd fsync slowness is usually a symptom of this.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 92
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(node_disk_io_time_seconds_total{k8s_cluster_name=~\"$cluster\", job=\"node-exporter\"}[5m])",
          "legendFormat": "{{instance}} {{device}}"
        }
      ]
    },
    {
      "id": 25,
      "title": "Memory Headroom per Node",
      "type": "timeseries",
      "description": "A ratio rather than bytes so it is comparable across instance types.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 100
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_memory_MemAvailable_bytes{k8s_cluster_name=~\"$cluster\", job=\"node-exporter\"} / node_memory_MemTotal_bytes{k8s_cluster_name=~\"$cluster\", job=\"node-exporter\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 26,
      "title": "Open File Descriptors",
      "type": "timeseries",
      "description": "Absolute count on purpose: node_filefd_maximum reads 9.22e18 here, so a ratio is always ~0. Watch growth against node count.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 100
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_filefd_allocated{k8s_cluster_name=~\"$cluster\", job=\"node-exporter\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 27,
      "title": "Unplanned Reboots (1h)",
      "type": "timeseries",
      "description": "A node that rebooted invalidates its own saturation history — exclude it before reading the panels above.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 108
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "changes(node_boot_time_seconds{k8s_cluster_name=~\"$cluster\", job=\"node-exporter\"}[1h])",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 28,
      "title": "Node Network Drops",
      "type": "timeseries",
      "description": "Drops appear before throughput plateaus. Virtual devices excluded — Cilium veth/lxc add ~15 series per node and swamp the real NICs.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 108
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance, device) (rate(node_network_receive_drop_total{k8s_cluster_name=~\"$cluster\", job=\"node-exporter\", device!~\"lo|cilium.*|veth.*|lxc.*\"}[5m]) + rate(node_network_transmit_drop_total{k8s_cluster_name=~\"$cluster\", job=\"node-exporter\", device!~\"lo|cilium.*|veth.*|lxc.*\"}[5m]))",
          "legendFormat": "{{instance}} {{device}}"
        }
      ]
    }
  ],
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  }
}
