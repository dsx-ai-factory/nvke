{
  "uid": "nke-benchmarks-worker-nodes",
  "title": "Worker Nodes",
  "description": "Node resource utilization (node-exporter) and kubelet pod-lifecycle and runtime health. Despite the name, no query filters on node role, so this covers every node the node-exporter and kubelet jobs scrape -- including control-plane nodes on a self-managed cluster. The node variable narrows only the kubelet panels. Inline PromQL, no recording rules required.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "utc",
  "tags": [
    "nke",
    "nke-benchmarks",
    "node-exporter",
    "kubelet"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "cluster",
        "type": "query",
        "label": "Cluster",
        "description": "Values of the k8s_cluster_name label, populated only where the datasource holds several clusters. All (.*) matches every series, including those without the label. A cluster label under any other name is not filtered.",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up, k8s_cluster_name)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "refresh": 1,
        "definition": "label_values(up, k8s_cluster_name)"
      },
      {
        "name": "quantile",
        "type": "custom",
        "label": "Quantile",
        "query": "p50 : 0.50, p90 : 0.90, p99 : 0.99",
        "hide": 0,
        "current": {
          "text": "p99",
          "value": "0.99"
        },
        "options": [
          {
            "text": "p50",
            "value": "0.50",
            "selected": false
          },
          {
            "text": "p90",
            "value": "0.90",
            "selected": false
          },
          {
            "text": "p99",
            "value": "0.99",
            "selected": true
          }
        ]
      },
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(kubelet_running_pods{k8s_cluster_name=~\"$cluster\"}, node)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "definition": "label_values(kubelet_running_pods{k8s_cluster_name=~\"$cluster\"}, node)"
      }
    ]
  },
  "panels": [
    {
      "id": 29,
      "type": "text",
      "title": "Requirements and scope",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Requirements.** Prometheus scraping node-exporter as `job=\"node-exporter\"` and the kubelet.\n\n**Scope.** Kubernetes 1.34 metric names; use until a newer `dashboards/` directory exists. `$cluster` filters on `k8s_cluster_name` and matches everything when the label is absent, so a single-cluster Prometheus needs no relabeling. Inline PromQL; no recording rules."
      }
    },
    {
      "id": 1,
      "title": "Node CPU by Mode",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance, mode) (rate(node_cpu_seconds_total{k8s_cluster_name=~\"$cluster\", job=\"node-exporter\"}[5m]))",
          "legendFormat": "{{instance}} {{mode}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Node Memory Used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
