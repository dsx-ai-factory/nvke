    {
      "id": 17,
      "title": "CPU Utilisation per Node",
      "type": "timeseries",
      "description": "Read max and quantiles, not avg — a mean over all nodes hides saturated ones. Keep sustained < 80%.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 68
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
