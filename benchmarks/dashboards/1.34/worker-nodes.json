            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_memory_MemTotal_bytes{k8s_cluster_name=~\"$cluster\", job=\"node-exporter\"} - node_memory_MemAvailable_bytes{k8s_cluster_name=~\"$cluster\", job=\"node-exporter\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
