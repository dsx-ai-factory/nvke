{
  "uid": "nke-benchmarks-networking-ovn",
  "title": "Networking (OVN)",
  "description": "OVN-Kubernetes CNI pipeline latency, controller workqueues, northd/ovn-controller flow compilation, plus a CoreDNS tripwire panel. Uses inline PromQL \u2014 no recording rules required.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "utc",
  "tags": [
    "nke",
    "nke-benchmarks",
    "ovn",
    "cni"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "cluster",
        "type": "query",
        "label": "Cluster",
        "description": "Values of the k8s_cluster_name label, populated only where the datasource holds several clusters. All (.*) matches every series, including those without the label. A cluster label under any other name is not filtered.",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up, k8s_cluster_name)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "refresh": 1,
        "definition": "label_values(up, k8s_cluster_name)"
      },
      {
        "name": "quantile",
        "type": "custom",
        "label": "Quantile",
        "query": "p50 : 0.50, p90 : 0.90, p99 : 0.99",
        "hide": 0,
        "current": {
          "text": "p99",
          "value": "0.99"
        },
        "options": [
          {
            "text": "p50",
            "value": "0.50",
            "selected": false
          },
          {
            "text": "p90",
            "value": "0.90",
            "selected": false
          },
          {
            "text": "p99",
            "value": "0.99",
            "selected": true
          }
        ]
      },
      {
        "name": "instance",
        "type": "query",
        "label": "OVN Worker",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(ovn_controller_lflow_run{k8s_cluster_name=~\"$cluster\"}, instance)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "definition": "label_values(ovn_controller_lflow_run{k8s_cluster_name=~\"$cluster\"}, instance)"
      }
    ]
  },
  "panels": [
    {
      "id": 13,
      "type": "text",
      "title": "Requirements and scope",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Requirements.** Prometheus scraping OVN-Kubernetes (ovnkube-controller, ovnkube-node, ovn-northd, ovn-controller) and CoreDNS.\n\n**Scope.** Kubernetes 1.34 metric names; use until a newer `dashboards/` directory exists. `$cluster` filters on `k8s_cluster_name` and matches everything when the label is absent, so a single-cluster Prometheus needs no relabeling. Inline PromQL; no recording rules."
      }
    },
    {
      "id": 1,
      "title": "OVN Pod Creation Latency (end-to-end) ${quantile:text}",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile($quantile, sum by (le) (rate(ovnkube_controller_pod_creation_latency_seconds_bucket{k8s_cluster_name=~\"$cluster\"}[2m])))",
          "legendFormat": "${quantile:text}"
        }
      ]
    },
    {
      "id": 2,
      "title": "OVN LSP Pipeline Breakdown p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ovnkube_controller_pod_first_seen_lsp_created_duration_seconds_bucket{k8s_cluster_name=~\"$cluster\"}[2m])))",
          "legendFormat": "first-seen\u2192LSP"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ovnkube_controller_pod_lsp_created_port_binding_duration_seconds_bucket{k8s_cluster_name=~\"$cluster\"}[2m])))",
          "legendFormat": "LSP\u2192port-binding"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ovnkube_controller_pod_port_binding_chassis_port_binding_up_duration_seconds_bucket{k8s_cluster_name=~\"$cluster\"}[2m])))",
          "legendFormat": "chassis\u2192up"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ovnkube_controller_pod_creation_latency_seconds_bucket{k8s_cluster_name=~\"$cluster\"}[2m])))",
          "legendFormat": "end-to-end"
        }
      ]
    },
    {
      "id": 3,
      "title": "OVN Node CNI Request Duration p99 by command",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (command, le) (rate(ovnkube_node_cni_request_duration_seconds_bucket{k8s_cluster_name=~\"$cluster\"}[2m])))",
          "legendFormat": "{{command}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "OVN Service Sync Latency ${quantile:text}",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile($quantile, sum by (le) (rate(ovnkube_controller_sync_service_latency_seconds_bucket{k8s_cluster_name=~\"$cluster\"}[2m])))",
          "legendFormat": "${quantile:text}"
        }
      ]
    },
    {
      "id": 5,
      "title": "OVN Service Sync + Requeue Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(ovnkube_controller_sync_service_total{k8s_cluster_name=~\"$cluster\"}[2m]))",
          "legendFormat": "sync"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(ovnkube_controller_requeue_service_total{k8s_cluster_name=~\"$cluster\"}[2m]))",
          "legendFormat": "requeue"
        }
      ]
    },
    {
      "id": 6,
      "title": "OVN Controller Workqueue Depth",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (name) (ovnkube_controller_workqueue_depth{k8s_cluster_name=~\"$cluster\"})",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "OVN Controller Workqueue Queue Duration p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (name, le) (rate(ovnkube_controller_workqueue_queue_duration_seconds_bucket{k8s_cluster_name=~\"$cluster\"}[2m])))",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "OVN northd Build Lflows",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(ovn_northd_build_lflows_95th_percentile{k8s_cluster_name=~\"$cluster\"})",
          "legendFormat": "95th"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(ovn_northd_build_lflows_maximum{k8s_cluster_name=~\"$cluster\"})",
          "legendFormat": "max"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(ovn_northd_build_lflows_long_term_avg{k8s_cluster_name=~\"$cluster\"})",
          "legendFormat": "avg"
        }
      ]
    },
    {
      "id": 9,
      "title": "OVN Controller Flow Installation by instance",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (instance) (ovn_controller_flow_installation_95th_percentile{k8s_cluster_name=~\"$cluster\", instance=~\"$instance\"})",
          "legendFormat": "95th {{instance}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (instance) (ovn_controller_flow_installation_maximum{k8s_cluster_name=~\"$cluster\", instance=~\"$instance\"})",
          "legendFormat": "max {{instance}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "OVN Controller Flow Generation 95th by instance",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (instance) (ovn_controller_flow_generation_95th_percentile{k8s_cluster_name=~\"$cluster\", instance=~\"$instance\"})",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "OVN Controller full Lflow translations by instance",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (ovn_controller_lflow_run{k8s_cluster_name=~\"$cluster\", instance=~\"$instance\"})",
          "legendFormat": "{{instance}}"
        }
      ],
      "description": "Count of times ovn-controller has translated the whole Logical_Flow table into OpenFlow flows, since ovn-controller started. Exported as a gauge, so rate() over it is meaningless -- this shows the value itself. A flat line is the healthy reading: OVN's incremental processing handles ordinary pod and service churn without a full translation. Steps upward during a run mean OVN fell back to full recomputation, which is worth investigating."
    },
    {
      "id": 12,
      "title": "CoreDNS Tripwire \u2014 ${quantile:text} latency + faults by rcode",
      "type": "timeseries",
      "description": "Left: latency. Right: fault rcodes only \u2014 NXDOMAIN is excluded as normal search-path noise that would mask a SERVFAIL spike.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile($quantile, sum by (server, le) (rate(coredns_dns_request_duration_seconds_bucket{k8s_cluster_name=~\"$cluster\"}[2m])))",
          "legendFormat": "{{server}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (rcode) (rate(coredns_dns_responses_total{k8s_cluster_name=~\"$cluster\", rcode!~\"NOERROR|NXDOMAIN\"}[2m]))",
          "legendFormat": "{{rcode}}"
        }
      ]
    }
  ],
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  }
}
