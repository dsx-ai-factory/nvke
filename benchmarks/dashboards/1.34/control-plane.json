    {
      "id": 21,
      "title": "Control-plane component up",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
