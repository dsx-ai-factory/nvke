// Go workspace for every module in the repository.
//
// `go work sync` and `go build` here need no NVIDIA credentials for module
// downloads: all nine modules build from public dependencies, except
// github.com/NVIDIA/cluster-api-provider-nico, which is still INTERNAL
// visibility and is carried in the committed vendor/ tree until it goes
// public. Re-running `go work vendor` (dependency bumps) needs access to that
// repository; everything else an outside contributor can do gets the same
// result as CI. See docs/go-workspace.md.
go 1.26.6

use (
	./agent
	./cli
	./cluster-api-provider-provisioned
	./controller
	./controller/api
	./controller/hack/capd-reboot-controller
	./controller/nico-sim
	./controller/test/e2e
	./os-image
)
