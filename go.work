// Go workspace for every module in the repository.
//
// All twelve modules resolve from public dependencies. Go downloads modules
// into its cache on first use; no committed vendor tree or NVIDIA credentials
// are required. See docs/go-workspace.md.
go 1.27.3

use (
	./agent
	./cli
	./cluster-api-provider-provisioned
	./controller
	./controller/api
	./controller/deploy/charts
	./controller/hack/capd-reboot-controller
	./controller/nico-sim
	./controller/test/e2e
	./management-engine
	./os-image
	./release
)
