[Unit]
Description=SPIRE Agent
Documentation=https://github.com/dsx-ai-factory/nvke/blob/main/os-image/SPEC.md
After=network-online.target nvke-spire-configure.service
Wants=network-online.target
Requires=nvke-spire-configure.service

[Service]
Type=simple
# Cloud-init writes an agent.conf carrying a literal
# plugin_checksum = "${TPM_PLUGIN_CHECKSUM}" or "${DSX_IMDS_PLUGIN_CHECKSUM}".
# -expandEnv resolves those from here, so each checksum belongs to the plugin
# this image installed. postinst writes the file. Same pair as
# controller/hack/ci/assets/spire-agent.service.
EnvironmentFile=-/etc/spire-agent/spire-agent.env
ExecStart=/usr/local/bin/spire-agent run -config /etc/spire-agent/agent.conf -expandEnv
Restart=on-failure
RestartSec=5
User=spire
Group=spire

[Install]
WantedBy=multi-user.target
