[Unit]
Description=SPIRE Agent
Documentation=https://github.com/NVIDIA/nke/blob/main/os-image/SPEC.md
After=network-online.target nke-spire-configure.service
Wants=network-online.target
Requires=nke-spire-configure.service

[Service]
Type=simple
ExecStart=/usr/local/bin/spire-agent run -config /etc/spire-agent/agent.conf
Restart=on-failure
RestartSec=5
User=spire
Group=spire

[Install]
WantedBy=multi-user.target
