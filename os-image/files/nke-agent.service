[Unit]
Description=NKE Node Agent
Documentation=https://github.com/NVIDIA/nke/blob/main/os-image/SPEC.md
After=spire-agent.service
Wants=spire-agent.service
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/default/nke-agent
ExecStartPre=/usr/lib/nke/wait-spiffe-socket.sh
ExecStart=/usr/local/bin/nke-agent $AGENT_ARGS
ExecStartPost=/usr/bin/touch /var/lib/spire-agent/.nke-attested
ExecReload=/bin/kill -HUP $MAINPID
Type=simple
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
