[Unit]
Description=Render SPIRE agent config from instance identity
Documentation=https://github.com/NVIDIA/nke/blob/main/os-image/SPEC.md
After=cloud-final.service
Before=spire-agent.service
ConditionPathExists=/etc/nke/spire.env

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/nke/spire-configure.sh

[Install]
WantedBy=multi-user.target
