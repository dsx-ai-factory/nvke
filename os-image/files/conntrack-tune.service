[Unit]
Description=Size nf_conntrack limits to this node's RAM
Documentation=https://github.com/dsx-ai-factory/nvke/blob/main/os-image/SPEC.md https://docs.kernel.org/networking/nf_conntrack-sysctl.html
# Writes /run/sysctl.d/10-nke-conntrack.conf for systemd-sysctl.service to
# apply in its normal boot pass, so this unit sets no sysctl itself.
#
# After systemd-modules-load.service, which loads nf_conntrack through
# /etc/modules-load.d/nf_conntrack.conf, so the kernel's current values exist
# to compare against. Before systemd-sysctl.service, so the file exists when
# the boot pass reads sysctl.d. Before sysinit.target, like
# systemd-sysctl.service itself: every unit with default dependencies,
# including containerd, kubelet and the CNI, starts after sysinit.target, so
# the limits are in place before any of them tracks a connection.
#
# Not After=local-fs.target: the script and /run are available before any
# unit starts, and waiting for every local filesystem would also hold back
# every other sysctl the boot pass applies.
#
# If this fails, no file is written and the kernel defaults stay; boot is not
# blocked.
DefaultDependencies=no
After=systemd-modules-load.service
Before=systemd-sysctl.service sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/nke/configure-conntrack.sh

[Install]
WantedBy=sysinit.target
