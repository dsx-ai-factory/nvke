diff --git a/pxe/common_files/disk_imaging.sh b/pxe/common_files/disk_imaging.sh
index cbd2aae9..11111111 100755
--- a/pxe/common_files/disk_imaging.sh
+++ b/pxe/common_files/disk_imaging.sh
@@ -371,0 +372,15 @@ function get_root_dev() {
+function release_existing_disk_state() {
+	echo "Releasing existing storage state on $image_disk" | tee "$log_output"
+
+	# This environment runs from its initramfs. It does not need volume groups
+	# from the disk that it is about to replace. Active mappings can keep the
+	# old partition table busy and can expose stale filesystem identifiers after
+	# the new image is written.
+	# Keep pipeline failure handling local to the required cleanup commands.
+	(set -o pipefail; vgchange -an 2>&1 | tee "$log_output") || return 1
+	(set -o pipefail; udevadm settle 2>&1 | tee "$log_output") || return 1
+	(set -o pipefail; wipefs --all --force "$image_disk" 2>&1 | tee "$log_output") || return 1
+	partprobe "$image_disk" 2>&1 | tee "$log_output" || true
+	(set -o pipefail; udevadm settle 2>&1 | tee "$log_output") || return 1
+}
+
@@ -1093,0 +1109 @@ function main() {
+	release_existing_disk_state || return 1
diff --git a/pxe/common_files/disk_imaging_test.sh b/pxe/common_files/disk_imaging_test.sh
index 8236f438..22222222 100644
--- a/pxe/common_files/disk_imaging_test.sh
+++ b/pxe/common_files/disk_imaging_test.sh
@@ -30,0 +31,2 @@ mock_blkid_stderr=
+storage_calls_file="$temp_dir/storage-calls"
+: >"$storage_calls_file"
@@ -86,0 +89,65 @@ lsblk() {
+vgchange() {
+	printf 'vgchange %s\n' "$*" >>"$storage_calls_file"
+	return "${mock_vgchange_status:-0}"
+}
+
+udevadm() {
+	printf 'udevadm %s\n' "$*" >>"$storage_calls_file"
+	if [ "$(grep -c '^udevadm ' "$storage_calls_file")" -eq 1 ]; then
+		return "${mock_first_settle_status:-0}"
+	fi
+	return "${mock_final_settle_status:-0}"
+}
+
+wipefs() {
+	printf 'wipefs %s\n' "$*" >>"$storage_calls_file"
+	return "${mock_wipefs_status:-0}"
+}
+
+partprobe() {
+	printf 'partprobe %s\n' "$*" >>"$storage_calls_file"
+	return "${mock_partprobe_status:-0}"
+}
+
+image_disk=/dev/target
+release_existing_disk_state >/dev/null || fail "existing disk state was not released"
+assert_eq "storage cleanup calls" $'vgchange -an\nudevadm settle\nwipefs --all --force /dev/target\npartprobe /dev/target\nudevadm settle' "$(cat "$storage_calls_file")"
+
+mock_vgchange_status=19
+: >"$storage_calls_file"
+if release_existing_disk_state >/dev/null; then
+	fail "failed LVM deactivation was ignored"
+fi
+assert_eq "stop after failed LVM deactivation" 'vgchange -an' "$(cat "$storage_calls_file")"
+mock_vgchange_status=0
+
+mock_wipefs_status=23
+: >"$storage_calls_file"
+if release_existing_disk_state >/dev/null; then
+	fail "failed signature cleanup was ignored"
+fi
+assert_eq "stop after failed signature cleanup" $'vgchange -an\nudevadm settle\nwipefs --all --force /dev/target' "$(cat "$storage_calls_file")"
+mock_wipefs_status=0
+
+mock_first_settle_status=17
+: >"$storage_calls_file"
+if release_existing_disk_state >/dev/null; then
+	fail "failed initial device settling was ignored"
+fi
+assert_eq "stop after failed initial device settling" $'vgchange -an\nudevadm settle' "$(cat "$storage_calls_file")"
+mock_first_settle_status=0
+
+mock_final_settle_status=29
+: >"$storage_calls_file"
+if release_existing_disk_state >/dev/null; then
+	fail "failed final device settling was ignored"
+fi
+assert_eq "failed final device settling calls" $'vgchange -an\nudevadm settle\nwipefs --all --force /dev/target\npartprobe /dev/target\nudevadm settle' "$(cat "$storage_calls_file")"
+mock_final_settle_status=0
+
+mock_partprobe_status=31
+: >"$storage_calls_file"
+release_existing_disk_state >/dev/null || fail "best-effort partition probing failure stopped cleanup"
+assert_eq "settle after failed partition probing" $'vgchange -an\nudevadm settle\nwipefs --all --force /dev/target\npartprobe /dev/target\nudevadm settle' "$(cat "$storage_calls_file")"
+mock_partprobe_status=0
+
