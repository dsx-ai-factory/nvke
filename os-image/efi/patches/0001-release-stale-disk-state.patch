diff --git a/pxe/common_files/disk_imaging.sh b/pxe/common_files/disk_imaging.sh
index cbd2aae9..11111111 100755
--- a/pxe/common_files/disk_imaging.sh
+++ b/pxe/common_files/disk_imaging.sh
@@ -371,0 +372,14 @@ function get_root_dev() {
+function release_existing_disk_state() {
+	echo "Releasing existing storage state on $image_disk" | tee "$log_output"
+
+	# This environment runs from its initramfs. It does not need volume groups
+	# from the disk that it is about to replace. Active mappings can keep the
+	# old partition table busy and can expose stale filesystem identifiers after
+	# the new image is written.
+	vgchange -an 2>&1 | tee "$log_output" || return 1
+	udevadm settle 2>&1 | tee "$log_output" || return 1
+	wipefs --all --force "$image_disk" 2>&1 | tee "$log_output" || return 1
+	partprobe "$image_disk" 2>&1 | tee "$log_output" || true
+	udevadm settle 2>&1 | tee "$log_output" || return 1
+}
+
@@ -1093,0 +1108 @@ function main() {
+	release_existing_disk_state || return 1
diff --git a/pxe/common_files/disk_imaging_test.sh b/pxe/common_files/disk_imaging_test.sh
index 8236f438..22222222 100644
--- a/pxe/common_files/disk_imaging_test.sh
+++ b/pxe/common_files/disk_imaging_test.sh
@@ -30,0 +31,2 @@ mock_blkid_stderr=
+storage_calls_file="$temp_dir/storage-calls"
+: >"$storage_calls_file"
@@ -86,0 +89,20 @@ lsblk() {
+vgchange() {
+	printf 'vgchange %s\n' "$*" >>"$storage_calls_file"
+}
+
+udevadm() {
+	printf 'udevadm %s\n' "$*" >>"$storage_calls_file"
+}
+
+wipefs() {
+	printf 'wipefs %s\n' "$*" >>"$storage_calls_file"
+}
+
+partprobe() {
+	printf 'partprobe %s\n' "$*" >>"$storage_calls_file"
+}
+
+image_disk=/dev/target
+release_existing_disk_state >/dev/null || fail "existing disk state was not released"
+assert_eq "storage cleanup calls" $'vgchange -an\nudevadm settle\nwipefs --all --force /dev/target\npartprobe /dev/target\nudevadm settle' "$(cat "$storage_calls_file")"
+
