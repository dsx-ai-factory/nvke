#
# dpkg has already put the binaries, units and the config renderer in place.
# What is left is the node state a file list cannot express: the user the agent
# runs as, its data directory, and enabling the two units.
set -e

[ "$1" = "configure" ] || exit 0

PACKAGE="spire-agent"

# The data directory is owned by a user that does not exist at unpack time, so
# it cannot be a packaged directory entry.
id -u spire >/dev/null 2>&1 || useradd -r -s /bin/false -d /var/lib/spire-agent spire
install -d -m 0750 -o spire -g spire /var/lib/spire-agent

# The TPM node attestor opens /dev/tpmrm0, which udev owns tss:tss. Without
# this spire-agent crash-loops on "permission denied" and nke-agent never
# starts, because it waits on a workload socket that never opens. The group
# only exists where the TPM tools are installed.
if getent group tss >/dev/null 2>&1; then
  usermod -aG tss spire
fi

# A unit under /etc masks the vendor unit this package ships in /lib. Images
# built before this package existed have exactly that, from provision.sh.
for unit in spire-agent.service nke-spire-configure.service; do
  if [ -f "/etc/systemd/system/${unit}" ]; then
    echo "${PACKAGE}: removing /etc/systemd/system/${unit} so the vendor unit in /lib applies."
    rm -f "/etc/systemd/system/${unit}"
  fi
done

systemctl daemon-reload
# enable, not `enable --now`: nke-spire-configure.service needs
# /etc/nke/spire.env, which cloud-init writes on first boot of the deployed
# node -- not here, and not in the Packer build VM.
systemctl enable nke-spire-configure.service
systemctl enable spire-agent.service
