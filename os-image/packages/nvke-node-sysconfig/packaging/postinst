#
# dpkg has already put the files and the mask links in place. What is left is
# what a file list cannot express: creating the etcd user and directory,
# retiring the copies that provision.sh used to install into /etc, enabling the
# conntrack unit, and applying the settings now, so an in-place update does not
# wait for the next boot.
set -e

[ "$1" = "configure" ] || exit 0

PACKAGE="nvke-node-sysconfig"

# The etcd user, then the directory it owns. Both are no-ops when they already
# exist with the right owner; a root:root directory from an earlier kubeadm init
# is corrected in place, and its contents are never touched. Neither runs
# through systemd, so this works in the Packer build VM and a chroot alike.
systemd-sysusers /usr/lib/sysusers.d/50-nvke-etcd.conf
systemd-tmpfiles --create /usr/lib/tmpfiles.d/50-nvke-etcd.conf

# Images built before this package existed carry these from provision.sh. The
# unit under /etc would mask the vendor unit in /lib, so it always goes. The
# two drop-ins are removed only while they are the bytes provision.sh wrote;
# an operator's edit is left alone, and the packaged copy applies beside it.
if [ -f /etc/systemd/system/conntrack-tune.service ]; then
  echo "${PACKAGE}: removing /etc/systemd/system/conntrack-tune.service so the vendor unit in /lib applies."
  rm -f /etc/systemd/system/conntrack-tune.service
fi

old_timeouts=/etc/sysctl.d/10-nke-conntrack-timeouts.conf
old_timeouts_sha256=cb2f42623e9407aa55bfe5fb009869d5bd2f1cad0048b03596a9ae5fd408e800
if [ -f "${old_timeouts}" ]; then
  if [ "$(sha256sum "${old_timeouts}" | cut -d' ' -f1)" = "${old_timeouts_sha256}" ]; then
    rm -f "${old_timeouts}"
  else
    echo "${PACKAGE}: ${old_timeouts} was edited, so it is left in place. It sorts before the packaged 50-nvke-conntrack-timeouts.conf, which overrides it; move your value to a later-sorting file such as /etc/sysctl.d/99-local.conf." >&2
  fi
fi

# The generated file's old name. /run is emptied at every boot, so this only
# matters on a node that was running when the package arrived.
rm -f /run/sysctl.d/10-nke-conntrack.conf

# The old name was one an operator could replace by putting a same-named file in
# /etc/sysctl.d. That file now replaces nothing, and sorts before the new one.
if [ -f /etc/sysctl.d/10-nke-conntrack.conf ]; then
  echo "${PACKAGE}: /etc/sysctl.d/10-nke-conntrack.conf no longer replaces the generated file, which is now 50-nvke-conntrack.conf and overrides it. Move your values to a later-sorting file such as /etc/sysctl.d/99-local.conf." >&2
fi

old_modules=/etc/modules-load.d/nf_conntrack.conf
if [ -f "${old_modules}" ] && [ "$(cat "${old_modules}")" = nf_conntrack ]; then
  rm -f "${old_modules}"
fi

# Enabled for the next boot. Starting it is done below, and only where systemd
# is running.
systemctl enable conntrack-tune.service

# Apply now where systemd is running: an in-place update, not the Packer build
# VM's first boot. Failures are not fatal; the next boot applies the same files.
if [ -d /run/systemd/system ]; then
  systemctl daemon-reload || true
  modprobe nf_conntrack || true
  systemctl restart conntrack-tune.service || true
  /lib/systemd/systemd-sysctl /usr/lib/sysctl.d/50-nvke-conntrack-timeouts.conf \
    /run/sysctl.d/50-nvke-conntrack.conf 2>/dev/null || true
fi
