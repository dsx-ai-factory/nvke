#cloud-config
# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
# SPDX-License-Identifier: Apache-2.0
autoinstall:
  version: 1

  locale: en_US.UTF-8
  keyboard:
    layout: us
    toggle: null
    variant: ""

  network:
    version: 2
    ethernets:
      default_nic:
        match:
          name: "e*"
        dhcp4: true

  # Ubuntu's NVIDIA-tuned kernel flavor, not the generic default -- matches
  # node-images' nvidia-kernel role. curtin installs this as the system
  # kernel directly, so there's no generic kernel to reboot into or purge
  # afterward the way node-images' post-install ansible role has to.
  kernel:
    package: ${nvidia_kernel_package}

  # LVM layout (LUKS optional, gated by luks_enabled). VG: ubuntu-vg, LV:
  # ubuntu-lv (Ubuntu defaults). Each variant grows to the target disk's full
  # size through its in-image first-boot service. No swap: not wanted on a
  # Kubernetes node.
  storage:
    swap:
      size: 0
    layout:
      name: lvm
      sizing-policy: all
%{ if luks_enabled ~}
      password: ${luks_passphrase}
%{ endif ~}
      match:
        size: largest

  identity:
    hostname: nvke-node
    username: ubuntu
    # Locked — login is by SSH key only (ssh.allow-pw: false below).
    password: "!"

  ssh:
    allow-pw: false
    authorized-keys:
      - ${ssh_public_key}
    install-server: true

  ntp:
    enabled: true

%{ if capture_apt_acquisitions ~}
  # Capture real archives before APT cache cleanup. Repository metadata is
  # checked after autoinstall, when python3-apt is available in the target.
  apt:
    conf: |
      ${indent(6, apt_capture_configuration)}
%{ endif ~}

  packages:
    - lvm2
%{ if luks_enabled ~}
    - cryptsetup
    - cryptsetup-initramfs
    # Ubuntu 26.04 ships dracut, not initramfs-tools, by default.
    # /usr/sbin/update-initramfs is a dracut-provided CLI-compatibility shim
    # that internally just runs `dracut --force`, ignoring
    # /etc/cryptsetup-initramfs/conf-hook and everything under
    # /etc/initramfs-tools/ entirely. Installing the real package here makes
    # the late-command's `update-initramfs -u -k all` below (which embeds
    # the build-time keyfile into the initrd) actually take effect on the
    # very first post-autoinstall boot, instead of silently building a
    # dracut image that prompts for the passphrase at console.
    - initramfs-tools
%{ endif ~}
    - python3
    - python3-apt
    - openssh-server
    - tpm2-tools
    # Open vSwitch is DOCA's doca-openvswitch-switch, installed by
    # scripts/provision.sh from the image's local repo, not from this list.
    # kubeadm preflight requires conntrack and warns without socat/ethtool;
    # iproute2 is Priority: important and already on the base image.
    - iptables
    - conntrack
%{ if ubuntu_series == "26.04" ~}
    # containerd's erofs snapshotter (Kata) converts image layers with
    # mkfs.erofs >= 1.8.2, which only 26.04 ships (24.04 has 1.7).
    - erofs-utils
%{ endif ~}
    - socat
    - ethtool

  # security, not all: "all" was tried and reverted -- it pulls in every
  # linux-firmware-* split package (AMD/Intel/Broadcom/Qualcomm/Mellanox/
  # Realtek graphics+wireless blobs, individually large), which took a
  # confirmed FDE build from ~5-7min to 24m27s under real KVM, risking the
  # ssh_timeout budget for an unrelated reason. Applied by curtin during
  # install, before the late-commands below, so any kernel upgrade here is
  # already in place when those regenerate the initramfs.
  updates: security

  late-commands:
    - curtin in-target --target=/target -- sh -c 'echo "ubuntu ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/ubuntu'
    - curtin in-target --target=/target -- chmod 440 /etc/sudoers.d/ubuntu
    # Subiquity normally writes cloud-init.disabled so cloud-init doesn't
    # re-run the installer config on later boots. The base (cloud-image)
    # variant of this image depends on cloud-init staying active across
    # boots (SPEC.md's "Cloud-init input" — spire.env/trust-bundle.pem
    # delivery), so keep it active here too rather than diverge per variant.
    - curtin in-target --target=/target -- rm -f /etc/cloud/cloud-init.disabled
    # Mirror boot/kernel output to serial as well as the VGA console. Without
    # this, an installer-based image has no console= kernel parameter at all, so
    # -nographic/serial-only tooling (demo-fde.sh, `virsh console`, real
    # out-of-band/BMC serial access) never sees boot messages or the LUKS
    # unlock prompt — they only ever reach the VGA framebuffer.
    - curtin in-target --target=/target -- sh -c 'echo "GRUB_CMDLINE_LINUX=\"console=tty0 console=${serial_console},115200\"" > /etc/default/grub.d/99-console.cfg'
%{ if luks_enabled ~}
    # ========================================================================
    # Build-time-only unlock: a temporary keyfile so the post-autoinstall
    # reboot (and Packer's SSH provisioning) can happen unattended. The
    # keyfile never leaves this build VM's disk image and is removed by
    # configure-fde.sh before the golden image ships — the only durable
    # unlock method in the shipped image is the LUKS passphrase slot (until
    # first boot replaces it with a TPM binding) and, later, the TPM itself.
    # This satisfies the "no key material in cloud-init/user-data/genesis
    # medium" requirement: this keyfile isn't cloud-init/user-data, it is a
    # file on the disk being built, and it is deleted before the disk is
    # published as an image.
    # ========================================================================
    - curtin in-target --target=/target -- sh -c 'echo -n "${luks_passphrase}" > /etc/luks-build.key && chmod 600 /etc/luks-build.key'
    - curtin in-target --target=/target -- sh -c 'LUKS_DEV=$(blkid -t TYPE=crypto_LUKS -o device | head -1) && echo -n "${luks_passphrase}" | cryptsetup luksAddKey "$LUKS_DEV" /etc/luks-build.key -'
    - curtin in-target --target=/target -- sh -c 'mkdir -p /etc/cryptsetup-initramfs && echo "KEYFILE_PATTERN=\"/etc/luks-build.key\"" > /etc/cryptsetup-initramfs/conf-hook'
    # ========================================================================
    # Discard passthrough (filesystem -> LVM -> LUKS -> qcow2), set up now,
    # before the LVM-on-LUKS stack is ever activated for the first time.
    # Retrofitting this after boot (pvscan --cache / lvchange --refresh) does
    # NOT recompute an already-active LV's own queue limits -- confirmed by
    # testing: the LUKS layer picks up allow_discards live fine, but the LVM
    # layer above it stays stuck at 0 discard_max_bytes regardless. Doing it
    # here means the LV's limits are computed correctly the first time it's
    # ever activated (the post-install reboot), same as node-images' approach.
    # This also gives the crypttab entry its final luks-<UUID> name from the
    # start, instead of the default curtin name getting renamed later.
    # ========================================================================
    - curtin in-target --target=/target -- sh -c 'sed -i "/issue_discards/d" /etc/lvm/lvm.conf && sed -i "/devices[[:space:]]*{/a\\        issue_discards = 1" /etc/lvm/lvm.conf'
    - curtin in-target --target=/target -- sh -c 'LUKS_UUID=$(blkid -t TYPE=crypto_LUKS -s UUID -o value | head -1) && printf "luks-%s UUID=%s /etc/luks-build.key luks,discard,initramfs\n" "$LUKS_UUID" "$LUKS_UUID" > /etc/crypttab'
    - curtin in-target --target=/target -- sh -c 'LUKS_UUID=$(blkid -t TYPE=crypto_LUKS -s UUID -o value | head -1) && mkdir -p /etc/initramfs-tools/conf.d && printf "CRYPTROOT=target=luks-%s,source=UUID=%s,discard\n" "$LUKS_UUID" "$LUKS_UUID" > /etc/initramfs-tools/conf.d/cryptroot'
    - curtin in-target --target=/target -- update-initramfs -u -k all
    # Second, independent auto-unlock path for real (non-build-VM) boots:
    # luks-cmdline-script (files/luks/) reads luks.key= off the kernel
    # command line and unlocks with it — this is what production feeds via
    # an iPXE luks.key=<passphrase> parameter, and what lets a fresh
    # target-hardware first boot (and this repo's own demo-fde.sh) unlock
    # unattended before the TPM binding exists. luks-tpm-firstboot.sh already
    # strips this from GRUB once that binding succeeds (see its "Cleaning up
    # GRUB configuration" step).
    - curtin in-target --target=/target -- sh -c 'echo "GRUB_CMDLINE_LINUX_DEFAULT=\"luks.key=${luks_passphrase}\"" > /etc/default/grub.d/99-luks-key.cfg'
%{ endif ~}
    - curtin in-target --target=/target -- update-grub
