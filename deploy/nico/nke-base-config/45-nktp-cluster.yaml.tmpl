# The site's name, for NKTP to label its telemetry with k8s.cluster.name.
#
# Nothing in the cluster knows it: NKE's kubeadm configuration names every
# cluster "kubernetes". BootstrapConfig's ClusterName does, so it is rendered
# here, and the Collectors that export to the backend read it through an
# environment variable (see ../nktp/values.yaml). A template item rather than a
# value because it is the one site-specific fact nktp needs, and it already
# lives in the config this path renders against.
apiVersion: v1
kind: ConfigMap
metadata:
  name: nktp-cluster
  namespace: nktp
data:
  name: "{{ .ClusterName }}"
