# The pull secret for CAPNICo's image, and the one registry credential this
# path needs.
#
# Every other image is staged into the node's containerd before the install --
# the node IS the cluster, so an imported image resolves with
# imagePullPolicy: IfNotPresent. CAPNICo is the exception: its manifest is the
# published release asset and names
# ghcr.io/dsx-ai-factory/cluster-api-provider-nico/controller, which is NOT
# anonymously pullable. Verified directly: ghcr.io hands out an empty token for
# the scope and the manifest request returns 403. A token with read:packages
# returns 200.
#
# That run created this with `kubectl create secret docker-registry` from
# `gh auth token` and patched the Deployment afterwards. Here the Deployment
# names it already (see ../capnico/capnico.yaml), so only the Secret is needed.
#
# stringData rather than data: the API server base64-encodes it, so the
# template stays substitutable. The `auth` field is omitted deliberately --
# kubelet accepts username/password on their own, and `auth` would need base64
# of "user:token", which this renderer cannot compute.
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-imagepull
  namespace: capnico-system
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: |
    {"auths":{"{{ .Registry.Server }}":{"username":"{{ .Registry.Username }}","password":"{{ .Registry.Token }}"}}}
