# CAPLL's --identity-secret. clientSecret comes from NVKECTL_LAUNCHLAYER_CLIENT_SECRET.
apiVersion: v1
kind: Secret
metadata:
  name: launchlayer-credentials
  namespace: capll-system
type: Opaque
stringData:
  issuerURL: "{{ .LaunchLayer.IssuerURL }}"
  clientID: "{{ .LaunchLayer.ClientID }}"
  clientSecret: "{{ .LaunchLayer.ClientSecret }}"
  scopes: "{{ .LaunchLayer.Scopes }}"
