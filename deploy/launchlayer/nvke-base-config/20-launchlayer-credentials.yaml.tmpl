# The OAuth2 client CAPLL authenticates to LaunchLayer with. The capll item
# starts the manager with --identity-secret=launchlayer-credentials, read from
# its own namespace, capll-system; the keys are the ones CAPLL's identity
# Secret takes. Applied before the capll item. The client secret comes from
# NVKECTL_LAUNCHLAYER_CLIENT_SECRET, the rest from the stack config's
# launchLayer object.
apiVersion: v1
kind: Secret
metadata:
  name: launchlayer-credentials
  namespace: capll-system
type: Opaque
stringData:
  issuerURL: "{{ .LaunchLayer.IssuerURL }}"
  clientID: "{{ .LaunchLayer.ClientID }}"
  clientSecret: "{{ .LaunchLayer.ClientSecret }}"
  scopes: "{{ .LaunchLayer.Scopes }}"
