# CAPLL v0.1.0-rc.15, its infrastructure-components.yaml release asset:
#
#   gh release download v0.1.0-rc.15 \
#     --repo dsx-ai-factory/cluster-api-provider-launchlayer \
#     -p infrastructure-components.yaml
#
# A template, not a manifest like capnico: the manager reads where LaunchLayer
# is and which identity Secret to use from its flags, and both are the site's.
# The one edit against the upstream asset is the manager's args, rendered from
# the stack config's launchLayer object. Empty vpcURL, computeURL and sgURL
# inherit baseURL.
#
# The image is pinned by tag. The repository is private until it is published,
# so a site needs pull access to ghcr.io/dsx-ai-factory, or a mirror.
apiVersion: v1
kind: Namespace
metadata:
  labels:
    app.kubernetes.io/name: cluster-api-provider-launchlayer
    cluster.x-k8s.io/provider: infrastructure-launchlayer
    control-plane: controller-manager
  name: capll-system
---
