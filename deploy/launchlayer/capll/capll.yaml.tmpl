apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app.kubernetes.io/name: cluster-api-provider-launchlayer
    cluster.x-k8s.io/provider: infrastructure-launchlayer
    control-plane: controller-manager
  name: cluster-api-provider-launchlayer-controller-manager
  namespace: capll-system
spec:
  replicas: 1
  selector:
    matchLabels:
      cluster.x-k8s.io/provider: infrastructure-launchlayer
      control-plane: controller-manager
  template:
    metadata:
      annotations:
        foo: temp
      labels:
        app.kubernetes.io/name: cluster-api-provider-launchlayer
        cluster.x-k8s.io/provider: infrastructure-launchlayer
        control-plane: controller-manager
    spec:
      containers:
      - args:
        - --leader-elect
        - --base-url={{ .LaunchLayer.BaseURL }}
        {{- with .LaunchLayer.VPCURL }}
        - --vpc-url={{ . }}
        {{- end }}
        {{- with .LaunchLayer.ComputeURL }}
        - --compute-url={{ . }}
        {{- end }}
        {{- with .LaunchLayer.SGURL }}
        - --sg-url={{ . }}
        {{- end }}
        - --identity-secret=launchlayer-credentials
        command:
        - /manager
        env:
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        image: ghcr.io/dsx-ai-factory/cluster-api-provider-launchlayer/controller:v0.1.0-rc.15
        imagePullPolicy: IfNotPresent
        livenessProbe:
          httpGet:
            path: /healthz
            port: probes
          initialDelaySeconds: 15
          periodSeconds: 20
        name: manager
        ports:
        - containerPort: 8080
          name: metrics
        - containerPort: 8081
          name: probes
        readinessProbe:
          httpGet:
            path: /readyz
            port: probes
          initialDelaySeconds: 5
          periodSeconds: 10
        resources:
          limits:
            cpu: 500m
            memory: 512Mi
          requests:
            cpu: 100m
            memory: 128Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      serviceAccountName: cluster-api-provider-launchlayer-controller-manager
      terminationGracePeriodSeconds: 10
